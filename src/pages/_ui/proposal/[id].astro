---
/* /ui/proposal/<id> - one design proposal applied to a copy of the home
 * page and to the whole component catalogue. A dev tool: astro.config.mjs
 * routes it for `astro dev` only.
 *
 * Its own document, as /ui: BaseHead with noindex, the site's tokens and
 * global styles, the page frame, only mobile-sheet.ts - never
 * contact-form.ts (which BaseLayout loads), which would POST the forms here
 * to the production NocoDB. <html data-proposal> is the scope; the
 * proposal's CSS is inlined in <body>, after every component style in
 * <head>, so a [data-proposal="<id>"] rule wins a tie with a scoped
 * component selector. */
import BaseHead from "@/components/layout/base-head.astro";
import PageFrame from "@/components/mb/page-frame.astro";
import Contact from "@/components/mb/sections/contact.astro";
import Experience from "@/components/mb/sections/experience.astro";
import Hero from "@/components/mb/sections/hero.astro";
import HowIWork from "@/components/mb/sections/how-i-work.astro";
import Services from "@/components/mb/sections/services.astro";
import { siteConfig } from "@/data/site-config";
import { loadProposals, type Proposal } from "@/lib/proposals";
import "@/styles/tokens.css";
import "@/styles/global.css";
import Catalogue from "../catalogue.astro";
import Switcher from "./switcher.astro";

export function getStaticPaths() {
  return loadProposals().map((entry) => ({
    params: { id: entry.id },
    props: { proposal: entry },
  }));
}

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;
---

<!doctype html>
<html data-proposal={proposal.id} lang={siteConfig.lang}>
  <head>
    <BaseHead
      description={proposal.description}
      noindex
      title={`Propozycja: ${proposal.name}`}
    />
    <script is:inline>
      /* blueprint-live: a piece once drawn stays drawn. Inline in <head> so
       * the attribute is on <html> before the first paint (without it the
       * proposal stands drawn); an animation that ends on scroll ends
       * forward or back, so either way it is marked. */
      if (document.documentElement.dataset.proposal === "blueprint-live") {
        document.documentElement.dataset.blLive = "";
        document.addEventListener("animationend", (event) => {
          if (event.animationName === "bl-draw") {
            event.target.dataset.blDrawn = "";
          }
        });
      }
    </script>
  </head>
  <body>
    <style data-proposal-css is:inline set:html={proposal.css} />
    <PageFrame>
      <Switcher current={proposal} proposals={loadProposals()} />
      <main>
        {/* The home page's sections, in the order of src/pages/index.astro. */}
        <Hero />
        <Services />
        <HowIWork />
        <Experience />
        <Contact />
        <Catalogue />
      </main>
    </PageFrame>
  </body>
</html>

<script>
  import "@/scripts/mobile-sheet.ts";
</script>

<style>
  main {
    padding: 0 0 96px;
  }

  @media (max-width: 880px) {
    main {
      padding-bottom: 64px;
    }
  }
</style>
