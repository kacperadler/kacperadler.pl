---
/* /ui/proposal/<id> - one design proposal applied to a copy of the home
 * page and to the whole component catalogue. A dev tool: astro.config.mjs
 * routes it for `astro dev` only.
 *
 * Its own document, as /ui: BaseHead with noindex, the site's tokens and
 * global styles, the page frame, only mobile-sheet.ts - never
 * contact-form.ts (which BaseLayout loads), which would POST the forms here
 * to /api/lead. <html data-proposal> is the scope; the
 * proposal's CSS is inlined in <body>, after every component style in
 * <head>, so a [data-proposal="<id>"] rule wins a tie with a scoped
 * component selector. */
import BaseHead from "@/components/layout/base-head.astro";
import PageFrame from "@/components/mb/page-frame.astro";
import About from "@/components/mb/sections/about.astro";
import Cases from "@/components/mb/sections/cases.astro";
import Contact from "@/components/mb/sections/contact.astro";
import Faq from "@/components/mb/sections/faq.astro";
import Hero from "@/components/mb/sections/hero.astro";
import HowIWork from "@/components/mb/sections/how-i-work.astro";
import Problems from "@/components/mb/sections/problems.astro";
import Services from "@/components/mb/sections/services.astro";
import Trust from "@/components/mb/sections/trust.astro";
import { siteConfig } from "@/data/site-config";
import { loadProposals, type Proposal } from "@/lib/proposals";
import "@/styles/tokens.css";
import "@/styles/global.css";
import Catalogue from "../catalogue.astro";
import Switcher from "./switcher.astro";

export function getStaticPaths() {
  return loadProposals().map((entry) => ({
    params: { id: entry.id },
    props: { proposal: entry },
  }));
}

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;
---

<!doctype html>
<html data-proposal={proposal.id} lang={siteConfig.lang}>
  <head>
    <BaseHead
      description={proposal.description}
      noindex
      title={`Propozycja: ${proposal.name}`}
    />
    <script is:inline>
      /* blueprint-live: marks <html> data-bl-live (inline in <head>, so
       * before the first paint; without it the proposal stands drawn), then
       * marks each part data-bl-drawn once it is whole on the screen, or
       * fills it when taller, and stops watching it; its proposal.css then
       * draws the part on a clock. A part scrolled past the top of the
       * screen before the observer saw it whole (a fast scroll) is marked
       * too. A catalogue section is watched by its heading, a process step by
       * its marker (on the desktop the step is display: contents, no box to
       * watch). The observer
       * reports in steps of 1% of the part's area, so "whole" allows 3%
       * short of it. */
      if (document.documentElement.dataset.proposal === "blueprint-live") {
        document.documentElement.dataset.blLive = "";
        document.addEventListener("DOMContentLoaded", () => {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const box = entry.boundingClientRect;
                const screen = entry.rootBounds;
                const whole = Math.min(box.height, screen.height);
                const seen =
                  entry.intersectionRect.height >= whole * 0.97 ||
                  box.bottom <= screen.top;
                if (whole > 0 && seen) {
                  const byChild =
                    entry.target.classList.contains("mb-ui-h2") ||
                    entry.target.classList.contains("mb-step-marker");
                  const part = byChild
                    ? entry.target.parentElement
                    : entry.target;
                  part.dataset.blDrawn = "";
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: Array.from({ length: 101 }, (_, i) => i / 100) }
          );
          for (const part of document.querySelectorAll(
            ".mb-section-head, .mb-ui-h2, .mb-card, .mb-step-marker, .mb-footer, .mb-footer-bottom, .mb-hero-status"
          )) {
            observer.observe(part);
          }
        });
      }
    </script>
  </head>
  <body>
    <style data-proposal-css is:inline set:html={proposal.css} />
    <PageFrame>
      <Switcher current={proposal} proposals={loadProposals()} />
      <main>
        {/* The home page's sections, in the order of src/pages/index.astro. */}
        <Hero />
        <Trust />
        <Problems />
        <Services />
        <Cases />
        <HowIWork />
        <About />
        <Faq />
        <Contact />
        <Catalogue />
      </main>
    </PageFrame>
  </body>
</html>

<script>
  import "@/scripts/mobile-sheet.ts";
</script>

<style>
  main {
    padding: 0 0 96px;
  }

  @media (max-width: 880px) {
    main {
      padding-bottom: 64px;
    }
  }
</style>
