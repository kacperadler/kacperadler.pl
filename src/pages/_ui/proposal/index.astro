---
/* /ui/proposal - every design proposal in src/styles/proposals/ with its
 * one-line description and a link to its page. A dev tool: astro.config.mjs
 * routes it for `astro dev` only. */
import Link from "@/components/ui/link.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { loadProposals } from "@/lib/proposals";

const proposals = loadProposals();
---

<BaseLayout
  description="Propozycje designu strony - narzędzie deweloperskie."
  noindex
  title="Propozycje designu"
>
  <main class="proposals" id="top">
    <div class="container">
      <header class="proposals-head">
        <p class="eyebrow">Narzędzie deweloperskie · tylko astro dev</p>
        <h1>Propozycje designu</h1>
        <p class="proposals-lede">
          Każda propozycja pokazuje kopię strony głównej i cały katalog
          komponentów w swoim kierunku. Kolory zostają, zmienia się font, skala,
          promienie, ramki, cienie, odstępy i kształty. Obecny design:
          <Link href="/ui" variant="inline">katalog</Link>
          i <Link href="/" variant="inline">strona główna</Link>.
        </p>
      </header>

      <ul class="proposals-list">
        {proposals.map((proposal) => (
          <li class="proposals-item">
            <h2>
              <Link href={`/ui/proposal/${proposal.id}`} variant="inline">
                {proposal.name}
              </Link>
            </h2>
            <p>{proposal.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .proposals {
    padding: var(--v2-space-xl) 0;
  }

  .proposals-head {
    max-width: 70ch;
    margin-bottom: var(--v2-space-xl);
  }

  .proposals-head h1 {
    margin: 0 0 16px;
    font-family: var(--display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .proposals-lede,
  .proposals-item p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .proposals-list {
    display: grid;
    gap: var(--v2-space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .proposals-item {
    padding: var(--v2-space-lg);
    background: var(--v2-panel);
    border: 1px solid var(--v2-line);
    border-radius: var(--v2-radius-md);
  }

  .proposals-item h2 {
    margin: 0 0 8px;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
</style>
