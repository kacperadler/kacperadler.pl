---
/* /ui/proposal - every design proposal in src/styles/proposals/ with its
 * one-line description and a link to its page, as a cell table. A dev
 * tool: astro.config.mjs routes it for `astro dev` only. The page has no
 * form, so BaseLayout's contact-form.ts has nothing to send. */
import Card from "@/components/mb/card.astro";
import CellGrid from "@/components/mb/cell-grid.astro";
import Link from "@/components/mb/link.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { loadProposals } from "@/lib/proposals";

const proposals = loadProposals();
---

<BaseLayout
  description="Propozycje designu strony - narzędzie deweloperskie."
  noindex
  title="Propozycje designu"
>
  <main class="proposals" id="top">
    <div class="container">
      <header class="proposals-head">
        <p class="proposals-kicker">
          Narzędzie deweloperskie · tylko astro dev
        </p>
        <h1>Propozycje designu</h1>
        <p class="proposals-lede">
          Każda propozycja pokazuje kopię strony głównej i cały katalog
          komponentów w swoim kierunku. Kolory zostają, zmienia się font, skala,
          promienie, ramki, cienie, odstępy i kształty. Obecny design:
          <Link href="/ui" variant="inline">katalog</Link>
          i <Link href="/" variant="inline">strona główna</Link>.
        </p>
      </header>

      <CellGrid min="320px" tag="ul">
        {proposals.map((proposal) => (
          <Card tag="li">
            <h2>
              <Link href={`/ui/proposal/${proposal.id}`} variant="inline">
                {proposal.name}
              </Link>
            </h2>
            <p>{proposal.description}</p>
          </Card>
        ))}
      </CellGrid>
    </div>
  </main>
</BaseLayout>

<style>
  .proposals {
    padding: var(--v2-space-xl) 0;
  }

  .proposals-head {
    max-width: 70ch;
    padding-top: var(--v2-space-md);
    margin-bottom: var(--v2-space-xl);
    border-top: 1px solid var(--mb-rule);
  }

  .proposals-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .proposals-head h1 {
    margin: 0 0 16px;
    font-family: var(--mb-display);
    font-size: clamp(32px, 4.6vw, 54px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .proposals-lede,
  .proposals li p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  h2 {
    margin: 0 0 8px;
    font-family: var(--mb-display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
</style>
