---
/* The minimal brutalism catalogue - every component in src/components/mb/
 * with its variants, sizes and states side by side. Rendered by /ui/mb
 * (index.astro), which astro.config.mjs routes for `astro dev` only.
 *
 * States are forced, not waited for: [data-state="hover"],
 * [data-state="focus-visible"], [data-state="focus"], the real `.active`
 * class and `disabled` attribute. The components own those selectors next
 * to the real :hover / :focus ones, so a forced state is the real paint.
 * Every id here starts with `mb-`; every radio and accordion group has a
 * name of its own. */
import { Image } from "astro:assets";
import meImage from "@/assets/me.jpg";
import Accordion from "@/components/mb/accordion.astro";
import AccordionItem from "@/components/mb/accordion-item.astro";
import Alert from "@/components/mb/alert.astro";
import Avatar from "@/components/mb/avatar.astro";
import AvatarGroup from "@/components/mb/avatar-group.astro";
import Badge from "@/components/mb/badge.astro";
import Brand from "@/components/mb/brand.astro";
import Breadcrumb from "@/components/mb/breadcrumb.astro";
import Button from "@/components/mb/button.astro";
import Card from "@/components/mb/card.astro";
import CellGrid from "@/components/mb/cell-grid.astro";
import Checkbox from "@/components/mb/checkbox.astro";
import ContactForm from "@/components/mb/contact-form.astro";
import Field from "@/components/mb/field.astro";
import FieldSet from "@/components/mb/field-set.astro";
import Input from "@/components/mb/input.astro";
import Label from "@/components/mb/label.astro";
import Link from "@/components/mb/link.astro";
import MobileSheet from "@/components/mb/mobile-sheet.astro";
import Pagination from "@/components/mb/pagination.astro";
import Prose from "@/components/mb/prose.astro";
import Radio from "@/components/mb/radio.astro";
import SectionHead from "@/components/mb/section-head.astro";
import Separator from "@/components/mb/separator.astro";
import Spinner from "@/components/mb/spinner.astro";
import StatusPill from "@/components/mb/status-pill.astro";
import Tag from "@/components/mb/tag.astro";
import Textarea from "@/components/mb/textarea.astro";

type Forced = "idle" | "hover" | "focus-visible";
const forced = (state: string) =>
  state === "hover" || state === "focus-visible" ? state : undefined;

type ButtonVariant =
  | "default"
  | "secondary"
  | "outline"
  | "ghost"
  | "destructive"
  | "link";
type ButtonState =
  | "idle"
  | "hover"
  | "focus-visible"
  | "active"
  | "disabled"
  | "loading";

const buttonStates: readonly ButtonState[] = [
  "idle",
  "hover",
  "focus-visible",
  "disabled",
  "loading",
];
const buttonRows: readonly {
  label: string;
  text: string;
  variant: ButtonVariant;
}[] = [
  { label: "Default", text: "Porozmawiajmy", variant: "default" },
  { label: "Secondary", text: "Zobacz proces", variant: "secondary" },
  { label: "Outline", text: "Zobacz proces", variant: "outline" },
  { label: "Ghost", text: "Zobacz proces", variant: "ghost" },
  { label: "Destructive", text: "Usuń wiadomość", variant: "destructive" },
  { label: "Link", text: "Wszystkie współprace", variant: "link" },
];
// `.active` is the header CTA at #contact: default only.
const defaultButtonStates: readonly ButtonState[] = [
  "idle",
  "hover",
  "focus-visible",
  "active",
  "disabled",
  "loading",
];

const textSizes = ["xs", "sm", "default", "lg"] as const;
const iconSizes = ["icon-xs", "icon-sm", "icon", "icon-lg"] as const;

const badgeVariants = [
  "default",
  "secondary",
  "outline",
  "destructive",
  "ghost",
  "link",
] as const;

const checkboxStates = [
  "unchecked",
  "checked",
  "hover",
  "focus-visible",
  "disabled",
  "disabled checked",
  "invalid",
] as const;

const radioOptions = ["Aplikacja webowa", "Landing page", "Inne"] as const;
const radioStates = [
  "checked",
  "hover",
  "focus-visible",
  "disabled",
  "invalid",
] as const;

const inputStates = [
  "default",
  "filled",
  "focus",
  "disabled",
  "invalid",
  "required",
] as const;
const textareaStates = ["default", "focus", "disabled", "invalid"] as const;

const crumbs = [
  { href: "/", label: "Strona główna" },
  { href: "/realizacje/", label: "Realizacje" },
  { href: "/realizacje/", label: "2025" },
  { label: "Panel dla zespołu sprzedaży" },
] as const;
const pageHref = (page: number) => `#mb-pagination-${page}`;

const formStates = [
  { caption: "idle", state: "idle" },
  { caption: "focus", focus: true, state: "idle" },
  { caption: "error-validation", state: "error-validation" },
  { caption: "error-submit", state: "error-submit" },
  { caption: "submitting", state: "submitting" },
  { caption: "success", state: "success" },
] as const;

const linkStates: readonly Forced[] = ["idle", "hover", "focus-visible"];
---

<div class="mb-ui">
  <div class="container">
    <header class="mb-ui-head">
      <p class="mb-ui-kicker">Narzędzie deweloperskie · tylko astro dev</p>
      <h2 class="mb-ui-title">Katalog: minimal brutalism</h2>
      <p class="mb-ui-lede">
        Każdy komponent z <code>src/components/mb/</code> we wszystkich
        wariantach, rozmiarach i stanach - warianty i rozmiary za shadcn/ui.
        Stany są wymuszone atrybutami (<code>data-state</code>,
        <code>.active</code>, <code>disabled</code>), więc widać je naraz.
        Powyżej strona główna złożona z tych samych komponentów.
      </p>
    </header>

    <section aria-labelledby="mb-button" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-button">Przycisk</h2>
      <p class="mb-ui-note">
        <code>button.astro</code>
        - warianty <code>default</code>, <code>secondary</code>,
        <code>outline</code>, <code>ghost</code>, <code>destructive</code>,
        <code>link</code>. Active (klasa <code>.active</code>) to CTA w nagłówku
        przy sekcji kontaktu, dlatego tylko default. Loading to
        <code>loading</code>
        (albo <code>data-state="submitting"</code> z formularza).
      </p>
      {buttonRows.map((row) => (
        <div class="mb-ui-row">
          <p class="mb-ui-row-label">{row.label}</p>
          <div class="mb-ui-grid">
            {(row.variant === "default"
              ? defaultButtonStates
              : buttonStates
            ).map((state) => (
              <div class="mb-ui-sample">
                <div class="mb-ui-stage">
                  <Button
                    class={state === "active" ? "active" : undefined}
                    data-state={forced(state)}
                    disabled={state === "disabled"}
                    iconEnd={
                      row.variant === "default"
                        ? "lucide:arrow-right"
                        : undefined
                    }
                    loading={state === "loading"}
                    variant={row.variant}
                  >
                    {row.text}
                  </Button>
                </div>
                <p class="mb-ui-caption">{state}</p>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Rozmiary</p>
        <div class="mb-ui-grid">
          {textSizes.map((size) => (
            <div class="mb-ui-sample">
              <div class="mb-ui-stage">
                <Button iconEnd="lucide:arrow-right" size={size}>
                  Porozmawiajmy
                </Button>
              </div>
              <p class="mb-ui-caption">{size}</p>
            </div>
          ))}
          {iconSizes.map((size) => (
            <div class="mb-ui-sample">
              <div class="mb-ui-stage">
                <Button
                  aria-label="Dodaj"
                  iconStart="lucide:plus"
                  size={size}
                  variant="outline"
                />
              </div>
              <p class="mb-ui-caption">{size}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Z ikoną i jako link</p>
        <div class="mb-ui-grid">
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Button iconStart="lucide:mail" variant="outline">Napisz</Button>
            </div>
            <p class="mb-ui-caption">iconStart</p>
          </div>
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Button iconEnd="lucide:arrow-right" variant="secondary">
                Dalej
              </Button>
            </div>
            <p class="mb-ui-caption">iconEnd</p>
          </div>
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Button href="#mb-button" iconEnd="lucide:arrow-right">
                Porozmawiajmy
              </Button>
            </div>
            <p class="mb-ui-caption">href</p>
          </div>
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Button disabled href="#mb-button" variant="outline">
                Zobacz proces
              </Button>
            </div>
            <p class="mb-ui-caption">href, disabled</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-spinner" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-spinner">Spinner</h2>
      <p class="mb-ui-note">
        <code>spinner.astro</code>
        - lucide <code>loader-circle</code>, rozmiar <code>1em</code>. Sam jest
        statusem „Ładowanie”; w przycisku i badge'u (<code>decorative</code>)
        jest ukryty przed czytnikiem.
      </p>
      <div class="mb-ui-grid">
        {(["sm", "default", "lg"] as const).map((size) => (
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Spinner size={size} />
            </div>
            <p class="mb-ui-caption">{size}</p>
          </div>
        ))}
        <div class="mb-ui-sample">
          <div class="mb-ui-stage">
            <Button loading>Wysyłanie</Button>
          </div>
          <p class="mb-ui-caption">w przycisku</p>
        </div>
        <div class="mb-ui-sample">
          <div class="mb-ui-stage">
            <Badge variant="secondary"
              ><Spinner decorative />
              Synchronizacja</Badge
            >
          </div>
          <p class="mb-ui-caption">w badge'u</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-badge" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-badge">Badge</h2>
      <p class="mb-ui-note">
        <code>badge.astro</code>
        - <code>outline</code> to lata współpracy i czas etapu,
        <code>default</code>
        to <em>teraz</em> i <em>Zlecenie</em>.
        <code>fillOnCellHover</code>
        wypełnia badge, gdy jego karta jest pod kursorem (etap procesu, w sekcji
        „Karta i siatka”).
      </p>
      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Warianty</p>
        <div class="mb-ui-grid">
          {badgeVariants.map((variant) => (
            <div class="mb-ui-sample">
              <div class="mb-ui-stage">
                <Badge variant={variant}>
                  {variant === "outline" ? "2022–2024" : "teraz"}
                </Badge>
              </div>
              <p class="mb-ui-caption">{variant}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Z ikoną i jako link</p>
        <div class="mb-ui-grid">
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Badge iconStart="lucide:check" variant="default">Wysłano</Badge>
            </div>
            <p class="mb-ui-caption">iconStart</p>
          </div>
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Badge iconEnd="lucide:arrow-right" variant="outline"
                >Więcej</Badge
              >
            </div>
            <p class="mb-ui-caption">iconEnd</p>
          </div>
          {linkStates.map((state) => (
            <div class="mb-ui-sample">
              <div class="mb-ui-stage">
                <Badge
                  data-state={forced(state)}
                  href="#mb-badge"
                  variant="outline"
                >
                  React
                </Badge>
              </div>
              <p class="mb-ui-caption">href, {state}</p>
            </div>
          ))}
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Badge href="#mb-badge" variant="link">Realizacja</Badge>
            </div>
            <p class="mb-ui-caption">link, href</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-alert" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-alert">Alert</h2>
      <p class="mb-ui-note">
        <code>alert.astro</code>
        - <code>default</code> i <code>destructive</code>; ikona, tytuł (slot
        <code>title</code>), opis, akcja (slot <code>action</code>).
        <code>role="alert"</code>
        domyślnie, tu <code>role="status"</code>, bo nic się nie zmienia.
      </p>
      <div class="mb-ui-grid mb-ui-grid-wide">
        <div class="mb-ui-sample">
          <Alert role="status">
            <Fragment slot="title">Odpowiadam w ciągu 24 godzin</Fragment>
            Napisz krótko, co budujesz i w jakim terminie.
          </Alert>
          <p class="mb-ui-caption">default</p>
        </div>
        <div class="mb-ui-sample">
          <Alert icon="lucide:bell" role="status">
            <Fragment slot="title">Nowa realizacja</Fragment>
            Panel dla zespołu sprzedaży jest już opisany.
            <Button href="#mb-alert" size="sm" slot="action" variant="outline">
              Zobacz
            </Button>
          </Alert>
          <p class="mb-ui-caption">default, akcja</p>
        </div>
        <div class="mb-ui-sample">
          <Alert role="status" variant="destructive">
            Coś poszło nie tak. Spróbuj ponownie za chwilę albo napisz mailem na
            <a href="mailto:kontakt@kacperadler.pl">kontakt@kacperadler.pl</a>.
          </Alert>
          <p class="mb-ui-caption">destructive</p>
        </div>
        <div class="mb-ui-sample">
          <Alert role="status" variant="destructive">
            <Fragment slot="title">Nie wysłano wiadomości</Fragment>
            Serwer nie odpowiedział.
            <Button size="sm" slot="action" variant="destructive">
              Ponów
            </Button>
          </Alert>
          <p class="mb-ui-caption">destructive, tytuł i akcja</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-avatar" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-avatar">Avatar</h2>
      <p class="mb-ui-note">
        <code>avatar.astro</code>
        - kwadrat w linii tuszu; zdjęcie przez <code>&lt;Image&gt;</code>, bez
        <code>src</code>
        inicjały (decyzja w buildzie).
        <code>avatar-group.astro</code>
        - nachodzące avatary i licznik „+N”.
      </p>
      <div class="mb-ui-grid">
        {(["sm", "default", "lg"] as const).map((size) => (
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Avatar alt="Kacper Adler" size={size} src={meImage} />
            </div>
            <p class="mb-ui-caption">{size}, zdjęcie</p>
          </div>
        ))}
        {(["sm", "default", "lg"] as const).map((size) => (
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Avatar alt="Kacper Adler" fallback="KA" size={size} />
            </div>
            <p class="mb-ui-caption">{size}, inicjały</p>
          </div>
        ))}
        <div class="mb-ui-sample">
          <div class="mb-ui-stage">
            <Avatar alt="Kacper Adler, dostępny" badge="dot" src={meImage} />
          </div>
          <p class="mb-ui-caption">badge: dot</p>
        </div>
        <div class="mb-ui-sample">
          <div class="mb-ui-stage">
            <Avatar
              alt="Kacper Adler, zweryfikowany"
              badge="lucide:check"
              fallback="KA"
              size="lg"
            />
          </div>
          <p class="mb-ui-caption">badge: ikona</p>
        </div>
        <div class="mb-ui-sample">
          <div class="mb-ui-stage">
            <AvatarGroup count={3}>
              <Avatar alt="Kacper Adler" src={meImage} />
              <Avatar alt="Anna Nowak" fallback="AN" />
              <Avatar alt="Jan Kowalski" fallback="JK" />
            </AvatarGroup>
          </div>
          <p class="mb-ui-caption">grupa, +3</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-separator" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-separator">Separator</h2>
      <p class="mb-ui-note">
        <code>separator.astro</code>
        - włos, poziomy albo pionowy; dekoracyjny (<code>role="none"</code>)
        albo <code>role="separator"</code>.
      </p>
      <div class="mb-ui-grid mb-ui-grid-wide">
        <div class="mb-ui-sample">
          <div class="mb-ui-panel">
            <p class="mb-ui-copy">Kacper Adler</p>
            <Separator class="mb-ui-separator-h" />
            <p class="mb-ui-copy">Inżynier oprogramowania</p>
          </div>
          <p class="mb-ui-caption">horizontal</p>
        </div>
        <div class="mb-ui-sample">
          <div class="mb-ui-panel mb-ui-inline">
            <span class="mb-ui-copy">Usługi</span>
            <Separator decorative={false} orientation="vertical" />
            <span class="mb-ui-copy">Proces</span>
            <Separator decorative={false} orientation="vertical" />
            <span class="mb-ui-copy">Kontakt</span>
          </div>
          <p class="mb-ui-caption">vertical, role="separator"</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-label" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-label">Etykieta</h2>
      <p class="mb-ui-note">
        <code>label.astro</code>
        - mono, wersaliki; <code>disabled</code> wycisza ją razem z polem.
      </p>
      <div class="mb-ui-grid mb-ui-grid-wide">
        <div class="mb-ui-sample">
          <div class="mb-ui-stack">
            <Label for="mb-label-default">Twój email</Label>
            <Input
              id="mb-label-default"
              placeholder="twoj@email.pl"
              type="email"
            />
          </div>
          <p class="mb-ui-caption">default</p>
        </div>
        <div class="mb-ui-sample">
          <div class="mb-ui-stack">
            <Label disabled for="mb-label-disabled">Twój email</Label>
            <Input
              disabled
              id="mb-label-disabled"
              placeholder="twoj@email.pl"
              type="email"
            />
          </div>
          <p class="mb-ui-caption">disabled</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-checkbox" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-checkbox">Pole wyboru</h2>
      <p class="mb-ui-note">
        <code>checkbox.astro</code>
        - natywny checkbox (<code>appearance: none</code>), kwadrat; zaznaczony
        to niebieski blok z <code>check</code>; <code>aria-invalid</code> -
        koralowa ramka.
      </p>
      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Stany</p>
        <div class="mb-ui-grid">
          {checkboxStates.map((state) => (
            <div class="mb-ui-sample">
              <div class="mb-ui-stage">
                <Checkbox
                  aria-invalid={state === "invalid" ? "true" : undefined}
                  checked={state === "checked" || state === "disabled checked"}
                  disabled={state.startsWith("disabled")}
                  id={`mb-checkbox-${state.replace(" ", "-")}`}
                  label="Zgoda"
                  state={
                    state === "hover" || state === "focus-visible"
                      ? state
                      : undefined
                  }
                />
              </div>
              <p class="mb-ui-caption">{state}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mb-ui-row">
        <p class="mb-ui-row-label">Z opisem i w grupie</p>
        <div class="mb-ui-grid mb-ui-grid-wide">
          <div class="mb-ui-sample">
            <div class="mb-ui-stage">
              <Checkbox
                checked
                description="Odpowiem tylko na ten adres, nie zapiszę go do newslettera."
                id="mb-checkbox-description"
                label="Zgadzam się na kontakt mailowy"
              />
            </div>
            <p class="mb-ui-caption">z opisem</p>
          </div>
          <div class="mb-ui-sample">
            <FieldSet legend="Zakres" legendVariant="label">
              <Checkbox
                id="mb-checkbox-group-design"
                label="Projekt interfejsu"
              />
              <Checkbox
                checked
                id="mb-checkbox-group-build"
                label="Wdrożenie"
              />
              <Checkbox id="mb-checkbox-group-care" label="Opieka po starcie" />
            </FieldSet>
            <p class="mb-ui-caption">grupa (fieldset)</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="mb-radio" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-radio">Radio</h2>
      <p class="mb-ui-note">
        <code>radio.astro</code>
        - <code>default</code> (kwadrat) i <code>choice</code> (chip z
        formularza kontaktowego). Nieprawidłowy stan z
        <code>[data-invalid]</code>
        na polu albo <code>aria-invalid</code>.
      </p>
      {(["default", "choice"] as const).map((variant) => (
        <div class="mb-ui-row">
          <p class="mb-ui-row-label">{variant}</p>
          <div class="mb-ui-grid mb-ui-grid-wide">
            {radioStates.map((state) => (
              <div class="mb-ui-sample">
                <div
                  aria-label={`Typ projektu (${variant}, ${state})`}
                  class:list={[
                    "mb-ui-radios",
                    { "mb-ui-radios-column": variant === "default" },
                  ]}
                  role="radiogroup"
                >
                  {/* Only the first option carries a forced state, as one
                   * pointer or one keyboard focus would. */}
                  {radioOptions.map((option, i) => (
                    <Radio
                      aria-invalid={state === "invalid" ? "true" : undefined}
                      checked={
                        i === 0 && state !== "hover" && state !== "invalid"
                      }
                      disabled={state === "disabled"}
                      label={option}
                      name={`mb-radio-${variant}-${state}`}
                      state={i === 0 ? forced(state) : undefined}
                      value={option}
                      variant={variant}
                    />
                  ))}
                </div>
                <p class="mb-ui-caption">{state}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section aria-labelledby="mb-form" class="mb-ui-section">
      <h2 class="mb-ui-h2" id="mb-form">Pola formularza</h2>
      <p class="mb-ui-note">
        <code>field.astro</code>
        (etykieta, opis, komunikat błędu) z <code>input.astro</code> i
