---
/* /ui - the component catalogue (catalogue.astro) in the current design,
 * with a link to the design proposals. astro.config.mjs routes it for
 * `astro dev` only. */
import Link from "@/components/ui/link.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Catalogue from "./catalogue.astro";
---

<BaseLayout
  description="Katalog komponentów strony - narzędzie deweloperskie."
  noindex
  title="Katalog komponentów"
>
  <main id="top">
    <nav aria-label="Propozycje designu" class="container ui-proposals">
      <Link href="/ui/proposal" variant="nav">Propozycje designu</Link>
    </nav>
    <Catalogue />
  </main>
</BaseLayout>

<style>
  .ui-proposals {
    padding-top: var(--v2-space-lg);
  }
</style>
