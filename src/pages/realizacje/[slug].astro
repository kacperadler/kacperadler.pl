---
import { getCollection, render } from "astro:content";
import Badge from "@/components/mb/badge.astro";
import Button from "@/components/mb/button.astro";
import Prose from "@/components/mb/prose.astro";
import SectionHead from "@/components/mb/section-head.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import type { CaseStudy } from "@/lib/case-studies";

/* One static page per case study at /realizacje/<slug>. The body is the
 * MDX entry; the header comes from its frontmatter: the section head (h1:
 * the company, lede: the summary), then the facts as a ruled table. */

export async function getStaticPaths() {
  return (await getCollection("caseStudies")).map((entry) => ({
    params: { slug: entry.id },
    props: { caseStudy: entry },
  }));
}

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const { company, period, role, stack, summary } = caseStudy.data;
const { Content } = await render(caseStudy);
---

<BaseLayout description={summary} title={`${company} - realizacja`}>
  <main class="mb-case" id="top">
    <article class="container">
      <SectionHead as="h1" label="Realizacja">
        {company}
        <Fragment slot="lede">{summary}</Fragment>
      </SectionHead>
      <dl class="mb-case-facts">
        <div class="mb-case-fact">
          <dt>Rola</dt>
          <dd>{role}</dd>
        </div>
        <div class="mb-case-fact">
          <dt>Okres</dt>
          <dd>{period}</dd>
        </div>
        <div class="mb-case-fact">
          <dt>Stack</dt>
          <dd>
            <ul class="mb-case-stack">
              {stack.map((tech) => (
                <li>
                  <Badge variant="tag">{tech}</Badge>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
      <Prose class="mb-case-body">
        <Content />
      </Prose>
      <footer class="mb-case-foot">
        <Button href="/#contact" iconEnd="lucide:arrow-right">
          Napisz do mnie
        </Button>
        <Button href="/#experience" variant="outline"
          >Wszystkie współprace</Button
        >
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .mb-case {
    padding: var(--v2-space-xl) 0 var(--v2-space-2xl);
  }

  .mb-case-facts {
    max-width: 65ch;
    margin: 0 0 var(--v2-space-xl);
    border: 1px solid var(--mb-rule);
  }

  .mb-case-fact {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 12px var(--v2-space-md);
  }

  .mb-case-fact + .mb-case-fact {
    border-top: 1px solid var(--mb-hair);
  }

  .mb-case-fact dt {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .mb-case-fact dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }

  .mb-case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-case-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 65ch;
    padding-top: var(--v2-space-lg);
    margin-top: var(--v2-space-xl);
    border-top: 1px solid var(--mb-rule);
  }

  @media (max-width: 880px) {
    .mb-case {
      padding-bottom: var(--v2-space-xl);
    }
  }

  @media (max-width: 400px) {
    .mb-case-fact {
      grid-template-columns: 88px minmax(0, 1fr);
    }
  }
</style>
