---
import Badge from "@/components/mb/badge.astro";
import Card from "@/components/mb/card.astro";
import CellGrid from "@/components/mb/cell-grid.astro";
import Link from "@/components/mb/link.astro";
import SectionHead from "@/components/mb/section-head.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import {
  type CaseStudy,
  caseStudyPath,
  sortedCaseStudies,
} from "@/lib/case-studies";

/* /realizacje/ - the list of case studies as a cell table, cells as on the
 * experience logo wall. A rest param with an undefined value builds the
 * directory index, and getStaticPaths returns no path while there is no
 * case study, so the page (and the menu entry that points here, see
 * src/data/navigation.ts) only exists with content. */

export async function getStaticPaths() {
  const all = await sortedCaseStudies();
  return all.length > 0
    ? [{ params: { index: undefined }, props: { caseStudies: all } }]
    : [];
}

interface Props {
  caseStudies: CaseStudy[];
}

const { caseStudies } = Astro.props;
---

<BaseLayout
  description="Wybrane realizacje: kontekst, moja rola, stack i efekt współpracy z firmami, z którymi pracowałem."
  title="Realizacje"
>
  <main class="mb-case-list" id="top">
    <div class="container">
      <SectionHead as="h1" label="Realizacje">
        Wybrane <em>realizacje</em>.
        <Fragment slot="lede">
          Kontekst, moja rola, stack i efekt - po jednej historii z firm, z
          którymi pracowałem.
        </Fragment>
      </SectionHead>

      <CellGrid min="320px" tag="ul">
        {caseStudies.map((caseStudy) => (
          <Card class="mb-case-cell" tag="li">
            <div class="mb-case-cell-head">
              <Badge class="mb-case-period" variant="outline">
                {caseStudy.data.period}
              </Badge>
            </div>
            <h2>{caseStudy.data.company}</h2>
            <p class="mb-case-role">{caseStudy.data.role}</p>
            <p class="mb-case-summary">{caseStudy.data.summary}</p>
            <p class="mb-case-more">
              <Link href={caseStudyPath(caseStudy)} variant="case">
                Zobacz realizację
                <span class="sr-only"> - {caseStudy.data.company}</span>
              </Link>
            </p>
          </Card>
        ))}
      </CellGrid>
    </div>
  </main>
</BaseLayout>

<style>
  .mb-case-list {
    padding: var(--v2-space-xl) 0 var(--v2-space-2xl);
  }

  .mb-case-cell-head {
    display: flex;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0 0 4px;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-case-role {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--blue);
    letter-spacing: 0.02em;
  }

  .mb-case-summary {
    flex: 1;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .mb-case-more {
    margin: 16px 0 0;
  }

  @media (max-width: 880px) {
    .mb-case-list {
      padding-bottom: var(--v2-space-xl);
    }
  }
</style>
