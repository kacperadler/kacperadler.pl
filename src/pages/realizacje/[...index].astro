---
import { Icon } from "astro-icon/components";
import Card from "@/components/ui/card.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import {
  type CaseStudy,
  caseStudyPath,
  sortedCaseStudies,
} from "@/lib/case-studies";

/* /realizacje/ - the list of case studies. A rest param with an undefined
 * value builds the directory index, and getStaticPaths returns no path
 * while there is no case study, so the page (and the menu entry that
 * points here, see src/data/navigation.ts) only exists with content. */

export async function getStaticPaths() {
  const all = await sortedCaseStudies();
  return all.length > 0
    ? [{ params: { index: undefined }, props: { caseStudies: all } }]
    : [];
}

interface Props {
  caseStudies: CaseStudy[];
}

const { caseStudies } = Astro.props;
---

<BaseLayout
  description="Wybrane realizacje: kontekst, moja rola, stack i efekt współpracy z firmami, z którymi pracowałem."
  title="Realizacje"
>
  <main class="case-list-page" id="top">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow eyebrow-section">Realizacje</p>
        <h1>Wybrane <em>realizacje</em>.</h1>
        <p class="section-lede">
          Kontekst, moja rola, stack i efekt - po jednej historii z firm, z
          którymi pracowałem.
        </p>
      </header>

      <ul class="case-list">
        {caseStudies.map((caseStudy) => (
          <Card class="case-panel" tag="li">
            <span class="case-period">{caseStudy.data.period}</span>
            <h2>{caseStudy.data.company}</h2>
            <div class="case-role">{caseStudy.data.role}</div>
            <p class="case-summary">{caseStudy.data.summary}</p>
            <a class="case-link" href={caseStudyPath(caseStudy)}>
              Zobacz realizację
              <span class="sr-only"> - {caseStudy.data.company}</span>
              <Icon aria-hidden="true" name="lucide:arrow-right" />
            </a>
          </Card>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .case-list-page {
    padding: 80px 0 60px;
  }

  .section-head h1 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .section-head h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .case-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--v2-space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .case-period {
    align-self: flex-start;
    padding: 4px 10px;
    margin-bottom: 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
    border: 1px solid var(--v2-line);
    border-radius: var(--v2-radius-xs);
  }

  .case-panel h2 {
    margin: 0 0 4px;
    font-family: var(--display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .case-role {
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--blue);
    letter-spacing: 0.02em;
  }

  .case-summary {
    flex: 1;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 880px) {
    .case-panel {
      padding: var(--v2-space-md);
    }
  }
</style>
