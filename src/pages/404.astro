---
import Button from "@/components/mb/button.astro";
import SectionHead from "@/components/mb/section-head.astro";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout noindex title="Strona nie znaleziona">
  <main class="mb-not-found" id="top">
    <div class="container">
      <SectionHead as="h1" label="404">
        Tej strony nie ma.
        <Fragment slot="lede">
          Może adres się zmienił, może literówka, może w ogóle jej nie było. Tak
          czy siak - strona główna ma to, czego szukasz.
        </Fragment>
      </SectionHead>
      <div class="mb-not-found-ctas">
        <Button href="/" iconEnd="lucide:arrow-right">Strona główna</Button>
        <Button href="/#contact" variant="outline">Napisz do mnie</Button>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* svh: iOS Safari's 100vh is the height with its toolbar hidden, so the
   * content would sit below the visible centre. */
  .mb-not-found {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 240px);
    padding: var(--v2-space-xl) 0;
  }

  .mb-not-found .container {
    width: 100%;
  }

  .mb-not-found-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
