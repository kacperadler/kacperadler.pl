---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

/* Loading spinner: lucide `loader-circle`, 1em square, so it takes the size
 * of the text around it unless `size` sets one.
 *   - alone it is a live status, "Ładowanie";
 *   - `decorative` (inside a button or a badge) hides it from assistive
 *     tech, so the label of its host stays the name.
 * It stops turning under prefers-reduced-motion. */
interface Props extends HTMLAttributes<"span"> {
  decorative?: boolean;
  size?: "sm" | "default" | "lg";
}

const { decorative = false, size, class: extraClass, ...rest } = Astro.props;
const a11y = decorative
  ? { "aria-hidden": "true" as const }
  : { "aria-label": "Ładowanie", role: "status" as const };
---

<span
  class:list={["mb-spinner", size && `mb-spinner-${size}`, extraClass]}
  {...a11y}
  {...rest}
>
  <Icon aria-hidden="true" name="lucide:loader-circle" />
</span>

<style>
  .mb-spinner {
    display: inline-flex;
    flex-shrink: 0;
    color: inherit;
  }

  .mb-spinner-sm {
    font-size: 14px;
  }

  .mb-spinner-default {
    font-size: 20px;
  }

  .mb-spinner-lg {
    font-size: 32px;
  }

  .mb-spinner :global(svg) {
    width: 1em;
    height: 1em;
    animation: mb-spin 0.8s linear infinite;
  }

  @keyframes mb-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-spinner :global(svg) {
      animation: none;
    }
  }
</style>
