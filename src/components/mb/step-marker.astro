---
/* Step marker: a square mono number on a 1px ink rail, beside a process
 * step's <Card> (how-i-work). It goes first in its row, the card right
 * after it; the rows stack in a list, so the rails join into one line that
 * runs from the first mark to the last (the first row's rail starts at its
 * mark, the last one's ends there). The mark fills blue while the card
 * next to it is hovered - or forced with [data-state="hover"] on the card
 * (/ui). Decorative: the step's title carries the meaning. */
interface Props {
  num: string;
}

const { num } = Astro.props;
---

<div aria-hidden="true" class="mb-step-marker">
  <span class="mb-step-dot">{num}</span>
</div>

<style>
  .mb-step-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .mb-step-marker::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    content: "";
    background: var(--mb-rule);
  }

  /* The rail runs from the first mark to the last. */
  :global(:first-child) > .mb-step-marker::before {
    top: var(--v2-space-lg);
  }

  :global(:last-child) > .mb-step-marker::before {
    bottom: auto;
    height: var(--v2-space-lg);
  }

  .mb-step-dot {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-top: var(--v2-space-lg);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    background: var(--v2-bg);
    border: 1px solid var(--mb-rule);
    transition:
      background-color var(--mb-snap),
      border-color var(--mb-snap),
      color var(--mb-snap);
  }

  .mb-step-marker:has(~ :global(.mb-card:is(:hover, [data-state="hover"])))
    .mb-step-dot {
    color: var(--v2-bg);
    background: var(--blue);
    border-color: var(--blue);
  }

  @media (max-width: 880px) {
    .mb-step-dot {
      width: 36px;
      height: 36px;
      margin-top: var(--v2-space-md);
      font-size: 13px;
    }

    :global(:first-child) > .mb-step-marker::before {
      top: var(--v2-space-md);
    }

    :global(:last-child) > .mb-step-marker::before {
      height: var(--v2-space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-step-dot {
      transition: none;
    }
  }
</style>
