---
/* Section head: a two-column row under an ink rule - the headline (default
 * slot) left, the lede (slot "lede") right, bottom-aligned. One column at
 * 880px and below.
 *   - Every head counts the `mb-section` counter one up (<PageFrame> resets
 *     it) and resets `bl-cell`, so its cells number "01.1", "01.2".
 *   - The rule is a dimension line: extension ticks at both ends and the
 *     section's own width in px (its container size, as a number, through
 *     typed trigonometry; a browser without it prints nothing) on its
 *     middle. <em> in the headline: ink, under a lime dimension brace with
 *     a callout letter (A, B, counted per headline) at its right end.
 *   - It stands drawn from the start (global.css: only the hero enters on
 *     page load). Its pieces still read --bl-p, at its initial 1, in stages
 *     (the rule, the ticks, the dimension with the brace, the callout), so
 *     a pen could draw a head again without a new rule.
 *   - `as` picks the heading level (h2 by default).
 *   - `poster` (the home page's sections) sets the headline on its own
 *     full-width row, 40px on a 390px phone to 88px at the 1160px
 *     container, weight 850, with the lede under it in the right column.
 *     Without it (legal pages, case studies, the 404) the head stays two
 *     columns at 32-54px. */
interface Props {
  as?: "h1" | "h2" | "h3";
  poster?: boolean;
}

const { as = "h2", poster = false } = Astro.props;
const Heading = as;
---

<header class:list={["mb-section-head", { "mb-section-head-poster": poster }]}>
  <Heading class="mb-section-title"><slot /></Heading>
  {Astro.slots.has("lede") && (
    <p class="mb-section-lede">
      <slot name="lede" />
    </p>
  )}
</header>

<style>
  .mb-section-head {
    --bl-s: clamp(0, var(--bl-p) / 0.6, 1);
    /* The headline stands where it stood under the section label, which
     * went (KA0166) with its space kept (KA-D24): the rule's 24px, the
     * label's 12px line at the body's 1.55, then the gap under it - 32px
     * here, 24px on a poster, 16px at 880px and below. */
    --mb-head-top: calc(24px + 12px * 1.55);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    column-gap: var(--v2-space-xl);
    align-items: end;
    padding-top: calc(var(--mb-head-top) + var(--v2-space-lg));
    margin: 0 0 var(--mb-block-gap);
    container-type: inline-size;
    counter-reset: bl-cell;
    counter-increment: mb-section;
    background-image: linear-gradient(var(--mb-rule) 0 0);
    background-repeat: no-repeat;
    background-position: 0 0;
    background-origin: border-box;
    background-size: calc(var(--bl-e) * 100%) 1px;
    border-top: 1px solid var(--mb-rule);
  }

  /* Extension ticks at both ends of the rule, grown out of it. */
  .mb-section-head::before {
    --bl-s: clamp(0, (var(--bl-p) - 0.6) * 10, 1);
    position: absolute;
    top: -6px;
    right: 0;
    left: 0;
    height: 11px;
    pointer-events: none;
    content: "";
    border-inline: 1px solid var(--mb-rule);
    clip-path: inset(calc((1 - var(--bl-e)) * 50%) 0);
  }

  /* The dimension: the head's own width (100cqw as a number of px),
   * written on the rule after the ticks. */
  @supports (width: calc(1px * tan(atan2(1px, 1px)))) {
    .mb-section-head::after {
      --bl-w: tan(atan2(100cqw, 1px));
      --bl-s: clamp(0, (var(--bl-p) - 0.7) * 5, 1);
      position: absolute;
      top: -1px;
      left: 50%;
      padding: 0 10px;
      font: var(--mb-note);
      color: var(--blue);
      letter-spacing: 0.08em;
      content: counter(bl-w) / "";
      counter-reset: bl-w var(--bl-w);
      background: var(--v2-bg);
      clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
      transform: translate(-50%, -50%);
    }
  }

  .mb-section-title {
    margin: 0;
    font-family: var(--mb-display);
    /* 32px on a 390px phone to 54px at the 1160px container; rem follows
     * the reader's font size. 13vw caps it on a narrow screen with a large
     * font, so the longest <em> with its callout (about 6.2em) still fits. */
    font-size: min(clamp(2rem, 1.3036rem + 2.8571vw, 3.375rem), 13vw);
    font-weight: 800;
    line-height: 1.02;
    color: var(--ink);
    letter-spacing: -0.045em;
    text-wrap: balance;
    counter-reset: bl-callout;
  }

  .mb-section-title :global(em) {
    position: relative;
    font-style: normal;
    color: var(--ink);
    white-space: nowrap;
    counter-increment: bl-callout;
  }

  /* The brace runs out left to right under the <em>. */
  .mb-section-title :global(em::after) {
    --bl-s: clamp(0, (var(--bl-p) - 0.7) * 5, 1);
    position: absolute;
    right: 0.02em;
    bottom: 0.02em;
    left: 0.02em;
    height: 0.14em;
    pointer-events: none;
    content: "";
    border: max(2px, 0.05em) solid var(--blue);
    border-top: 0;
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
  }

  /* The callout hangs off the brace's right end, written last. */
  .mb-section-title :global(em::before) {
    --bl-s: clamp(0, (var(--bl-p) - 0.9) * 10, 1);
    position: absolute;
    bottom: 0.02em;
    left: 100%;
    padding: 2px 3px;
    margin-left: 0.12em;
    font: var(--mb-note);
    color: var(--v2-bg);
    letter-spacing: 0;
    content: counter(bl-callout, upper-alpha) / "";
    background: var(--blue);
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
    transform: translateY(50%);
  }

  .mb-section-lede {
    max-width: 48ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Poster: the headline fills the row, 24px under the label's line; the
   * lede steps under it into the right column, 24px down, clear of a
   * callout hanging off a brace above it. 40px on a 390px phone to 88px at
   * the 1160px container on a rem + vw slope, capped at 13vw like the
   * default. */
  .mb-section-head-poster {
    padding-top: calc(var(--mb-head-top) + 24px);
  }

  .mb-section-head-poster .mb-section-title {
    grid-column: 1 / -1;
    font-size: min(clamp(2.5rem, 0.9805rem + 6.2338vw, 5.5rem), 13vw);
    font-weight: 850;
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .mb-section-head-poster .mb-section-lede {
    grid-column: 2;
    margin-top: 24px;
  }

  @media (max-width: 880px) {
    .mb-section-head,
    .mb-section-head-poster {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--v2-space-md);
      padding-top: calc(var(--mb-head-top) + var(--v2-space-md));
    }

    .mb-section-head-poster .mb-section-lede {
      grid-column: 1;
      margin-top: 0;
    }
  }
</style>
