---
/* Field set: a <fieldset> whose legend names the group, an optional
 * description under it, the fields (and any <Separator> between them)
 * stacked in the slot.
 *   legendVariant "legend"  a heavy Geist heading
 *   legendVariant "label"   the text-face caption of a single control
 * `disabled` disables every control inside (native fieldset behaviour). */
interface Props {
  class?: string;
  description?: string;
  disabled?: boolean;
  legend: string;
  legendVariant?: "legend" | "label";
}

const {
  description,
  disabled = false,
  legend,
  legendVariant = "legend",
  class: extraClass,
} = Astro.props;
---

<fieldset disabled={disabled} class:list={["mb-fieldset", extraClass]}>
  <legend class:list={["mb-legend", `mb-legend-${legendVariant}`]}>
    {legend}
  </legend>
  {description && <p class="mb-fieldset-description">{description}</p>}
  <div class="mb-fieldset-fields"><slot /></div>
</fieldset>

<style>
  .mb-fieldset {
    min-width: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .mb-legend {
    padding: 0;
    margin-bottom: 4px;
  }

  .mb-legend-legend {
    font-family: var(--mb-display);
    font-size: 18px;
    font-weight: 750;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.03em;
  }

  .mb-legend-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .mb-fieldset-description {
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .mb-fieldset-fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
  }
</style>
