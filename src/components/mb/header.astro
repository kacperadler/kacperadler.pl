---
import { contactCta, primaryNav } from "@/data/navigation";
import Brand from "./brand.astro";
import Button from "./button.astro";
import Link from "./link.astro";

/* Header: sticky on the solid substrate under an ink rule, no glass. The
 * brand, the nav links to the home page sections ([data-nav-link],
 * `.active` from scripts/nav-active.ts), the sm contact CTA
 * ([data-nav-cta]) and, at 880px and below instead of the links, the menu
 * button that opens the mobile sheet ([data-menu-open],
 * aria-controls="mobile-sheet"). On page load it opens the first screen's
 * entrance (global.css): held above the top edge until the first frame
 * has painted, it comes down over --mb-enter-rise as the headline slides
 * up under it. */
---

<div class="mb-header" data-nav-wrap>
  <nav aria-label="Główna nawigacja" class="mb-nav">
    <Brand />

    <div class="mb-nav-links">
      {primaryNav.map((link) => (
        <Link data-nav-link href={link.href} variant="nav">
          {link.label}
        </Link>
      ))}
    </div>

    <div class="mb-nav-tail">
      <Button
        data-nav-cta
        href={contactCta.href}
        iconEnd="lucide:arrow-right"
        size="sm"
      >
        {contactCta.label}
      </Button>

      <span class="mb-menu">
        <Button
          aria-controls="mobile-sheet"
          aria-expanded="false"
          aria-label="Otwórz menu"
          data-menu-open
          iconStart="lucide:menu"
          size="icon-sm"
          variant="outline"
        />
      </span>
    </div>
  </nav>
</div>

<style>
  .mb-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--mb-rule);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-bl-enter]) .mb-header {
      animation: bl-enter-down var(--mb-enter-rise) var(--mb-enter) both paused;
    }

    :global(html[data-bl-enter="go"]) .mb-header {
      animation-play-state: running;
    }
  }

  .mb-nav {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container);
    padding: 14px var(--v2-space-md);
    margin: 0 auto;
  }

  .mb-nav-links {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .mb-nav-tail {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .mb-menu {
    display: none;
  }

  @media (max-width: 880px) {
    .mb-nav-links {
      display: none;
    }

    .mb-menu {
      display: inline-flex;
    }
  }

  /* Narrow phones: the CTA drops its arrow so brand, CTA and menu fit one
   * row; where they still do not (a wider fallback font before Geist loads,
   * a 320px screen) the tail wraps under the brand instead of pushing the
   * page sideways. */
  @media (max-width: 400px) {
    .mb-nav-tail {
      gap: 8px;
    }

    .mb-nav {
      flex-wrap: wrap;
      gap: 12px 8px;
    }

    .mb-nav-tail :global(.mb-btn-icon-end) {
      display: none;
    }
  }
</style>
