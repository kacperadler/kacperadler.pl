---
import type { HTMLAttributes } from "astro/types";

/* Textarea: <Input>'s frame and states (hover, focus, invalid, disabled).
 * It grows with its text (field-sizing: content) from 5lh to 14lh, padding
 * and border included, then scrolls; no resize handle, a dragged height
 * would stop the growth.
 * A browser without field-sizing keeps a 130px floor and vertical resize.
 * `value` becomes the initial text. [data-state="hover"] and
 * [data-state="focus"] force those looks on the catalogue page (/ui). */
type Props = HTMLAttributes<"textarea">;

const { class: extraClass, value, ...rest } = Astro.props;
---

<textarea class:list={["mb-textarea", extraClass]} {...rest}>{value}</textarea>

<style>
  .mb-textarea {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 130px;
    padding: 12px 14px;
    font-family: var(--sans);
    font-size: max(16px, 1rem);
    line-height: 1.55;
    color: var(--ink);
    resize: vertical;
    background: var(--v2-bg);
    border: 1px solid var(--muted);
    border-radius: 0;
    transition:
      border-color var(--mb-snap),
      box-shadow var(--mb-snap);
  }

  @supports (field-sizing: content) {
    .mb-textarea {
      field-sizing: content;
      min-height: 5lh;
      max-height: 14lh;
      resize: none;
    }
  }

  .mb-textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .mb-textarea[data-state="hover"] {
    border-color: var(--ink-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-textarea:hover {
      border-color: var(--ink-2);
    }
  }

  /* Forced colors paint the transparent outline in place of the shadow. */
  .mb-textarea:is(:focus, [data-state="focus"]) {
    outline: 2px solid transparent;
    border-color: var(--ink);
    box-shadow: var(--mb-shift) var(--mb-shift) 0 var(--blue);
  }

  .mb-textarea[aria-invalid="true"],
  :global([data-invalid]) .mb-textarea {
    border-color: var(--error);
  }

  .mb-textarea:disabled {
    color: var(--muted);
    cursor: not-allowed;
    background: var(--v2-panel);
    border-color: var(--mb-hair);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-textarea {
      transition: none;
    }
  }
</style>
