---
import { Icon } from "astro-icon/components";
import { contactCta, primaryNav } from "@/data/navigation";
import Badge from "./badge.astro";
import Button from "./button.astro";

/* Mobile sheet: the full-screen menu on the solid substrate, no glass. A
 * native <dialog> that scripts/mobile-sheet.ts opens with showModal(): the
 * browser makes the page behind inert, closes it on Escape and puts it in
 * the top layer. Its hooks: id="mobile-sheet", [data-menu-close],
 * [data-sheet-link]. Closed it is display: none, so nothing inside takes
 * focus. It switches in and out with an opacity snap (--mb-snap), no slide.
 *
 * `preview` renders a static, always-visible copy for the catalogue
 * (/ui): a <div>, no id, no dialog role, no hooks, so the script never
 * touches it. */
interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const Sheet = preview ? "div" : "dialog";
const dialog = preview
  ? { "aria-label": "Menu mobilne (podgląd)", role: "group" as const }
  : { "aria-label": "Menu mobilne", id: "mobile-sheet" };
const linkHook = preview ? {} : { "data-sheet-link": true };
const closeHook = preview ? {} : { "data-menu-close": true };
---

<Sheet class:list={["mb-sheet", { "mb-sheet-preview": preview }]} {...dialog}>
  <span class="mb-sheet-close">
    <Button
      aria-label="Zamknij menu"
      iconStart="lucide:x"
      size="icon-sm"
      variant="outline"
      {...closeHook}
    />
  </span>

  <div class="mb-sheet-content">
    <Badge variant="status">Przyjmuję nowe projekty</Badge>

    <nav
      aria-label={preview ? "Menu główne (podgląd)" : "Menu główne"}
      class="mb-sheet-nav"
    >
      {primaryNav.map((link) => (
        <a class="mb-sheet-link" href={link.href} {...linkHook}>
          <span>{link.label}</span>
          <Icon
            aria-hidden="true"
            class="mb-sheet-arrow"
            name="lucide:arrow-right"
          />
        </a>
      ))}
    </nav>

    <span class="mb-sheet-cta">
      <Button
        href={contactCta.href}
        iconEnd="lucide:arrow-right"
        size="lg"
        {...linkHook}
      >
        {contactCta.label}
      </Button>
    </span>
  </div>
</Sheet>

<style>
  /* The page behind is locked while the sheet is modal, so the sheet
   * scrolls its own overflow (a phone held sideways) and never hands it to
   * the page. The close button scrolls away with it; Esc and the links
   * still close. The open dialog fills the viewport, over the dialog's own
   * box (centred, framed, capped short of the edges); the browser's
   * `dialog:modal` rules end at close(), so the fixed box and its scroller
   * are set here to hold through the fade out. A closed one keeps the
   * browser's display: none. */
  .mb-sheet {
    flex-direction: column;
    padding: 80px var(--v2-space-md) 32px;
    color: inherit;
    background: var(--v2-bg);
  }

  .mb-sheet[open],
  .mb-sheet-preview {
    display: flex;
  }

  dialog.mb-sheet {
    position: fixed;
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    opacity: 0;
    /* Closing: display and the top layer wait out the fade. */
    transition:
      opacity var(--mb-snap),
      overlay var(--mb-snap) allow-discrete,
      display var(--mb-snap) allow-discrete;
  }

  dialog.mb-sheet[open] {
    opacity: 1;
  }

  @starting-style {
    dialog.mb-sheet[open] {
      opacity: 0;
    }
  }

  /* The fading sheet shows the page through it, not a dimmed one. */
  .mb-sheet::backdrop {
    background: none;
  }

  :global(html:has(.mb-sheet:modal)) {
    overflow: hidden;
  }

  .mb-sheet-preview {
    position: relative;
    min-height: 560px;
    border: 1px solid var(--mb-rule);
  }

  .mb-sheet-close {
    position: absolute;
    top: 14px;
    right: var(--v2-space-md);
  }

  .mb-sheet-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 24px;
  }

  .mb-sheet-nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--mb-rule);
  }

  .mb-sheet-link {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    font-family: var(--mb-display);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.04em;
    border-bottom: 1px solid var(--mb-rule);
    transition: color var(--mb-snap);
  }

  /* The focus ring (global.css) grows out of the edge instead of popping. */
  :where(.mb-sheet-link) {
    outline-offset: 0;
  }

  .mb-sheet-link:is(:active, [data-state="pressed"]) {
    color: var(--blue);
  }

  .mb-sheet-link :global(.mb-sheet-arrow) {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--ink-2);
    transition: color var(--mb-snap);
  }

  .mb-sheet-link:is(:focus-visible, [data-state="hover"])
    :global(.mb-sheet-arrow) {
    color: var(--blue);
    transform: translateX(4px);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-sheet-link:hover :global(.mb-sheet-arrow) {
      color: var(--blue);
      transform: translateX(4px);
    }
  }

  .mb-sheet-link:is(:active, [data-state="pressed"]) :global(.mb-sheet-arrow) {
    color: var(--blue);
    transform: translateX(8px);
  }

  .mb-sheet-cta {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  /* The moves: the ring grows out of the edge, the arrow nudges. Without
   * them each switches at once; the sheet's fade runs for everyone. */
  @media (prefers-reduced-motion: no-preference) {
    .mb-sheet-link {
      transition:
        color var(--mb-snap),
        outline-offset var(--mb-snap);
    }

    .mb-sheet-link :global(.mb-sheet-arrow) {
      transition:
        color var(--mb-snap),
        transform var(--mb-snap);
    }
  }
</style>
