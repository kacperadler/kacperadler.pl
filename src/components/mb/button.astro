---
import { Icon } from "astro-icon/components";
import Spinner from "./spinner.astro";

/* Button in minimal brutalism, with shadcn/ui's variant and size set.
 *   default      blue block in an ink rule with the hard ink shadow; hover:
 *                lighter blue, the shadow reaches 2px further (the button
 *                stays put); `.active` (the header CTA at #contact): an ink
 *                block with no shadow - pressed flat, you are there
 *   secondary    a raised panel in a hairline; hover: the ink rule
 *   outline      an ink rule; hover: an inverted ink block
 *   ghost        no rule; hover: the raised panel
 *   destructive  a coral block in an ink rule; hover: lighter coral
 *   link         ink text over a blue underline; hover: blue text
 * Sizes xs 28 / sm 36 / default 44 / lg 52 px high; icon-xs, icon-sm, icon
 * and icon-lg are the same heights, square, and need `aria-label` and the
 * icon in `iconStart`. `iconEnd` nudges 3px right on hover.
 *
 * Disabled and loading: a flat panel in a hairline, muted text. `loading`
 * swaps the icons for a spinner and sets aria-busy; scripts/contact-form.ts
 * reaches the same look with [data-state="submitting"] + disabled.
 * `href` renders an <a> (a disabled one loses its href).
 *
 * The catalogue (/ui/mb) forces states with [data-state="hover"] and
 * [data-state="focus-visible"] (the ring is global.css's); `.active` is a
 * real class. Other attributes (data-nav-cta, data-submit, aria-*) pass
 * through to the element. */
type Variant =
  | "default"
  | "secondary"
  | "outline"
  | "ghost"
  | "destructive"
  | "link";
type TextSize = "xs" | "sm" | "default" | "lg";
type IconSize = "icon-xs" | "icon-sm" | "icon" | "icon-lg";

interface Common {
  class?: string;
  disabled?: boolean;
  href?: string;
  iconEnd?: string;
  loading?: boolean;
  rel?: string;
  target?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  [attribute: `data-${string}`]: unknown;
}

type Props =
  | (Common & { iconStart?: string; size?: TextSize })
  | (Common & { "aria-label": string; iconStart: string; size: IconSize });

const {
  variant = "default",
  size = "default",
  iconStart,
  iconEnd,
  href,
  loading = false,
  type = "button",
  disabled = false,
  class: extraClass,
  ...rest
} = Astro.props;

const isIcon = size.startsWith("icon");
const inactive = disabled || loading;
const classes = [
  "mb-btn",
  `mb-btn-${variant}`,
  `mb-btn-size-${size}`,
  { "mb-btn-loading": loading, "mb-btn-square": isIcon },
  extraClass,
];
const busy = loading ? "true" : undefined;
---

{href ? (
  <a
    aria-busy={busy}
    aria-disabled={inactive ? "true" : undefined}
    class:list={classes}
    href={inactive ? undefined : href}
    {...rest}
  >
    <Spinner class="mb-btn-spinner" decorative />
    {iconStart && (
      <Icon aria-hidden="true" class="mb-btn-icon" name={iconStart} />
    )}
    <slot />
    {iconEnd && (
      <Icon
        aria-hidden="true"
        class="mb-btn-icon mb-btn-icon-end"
        name={iconEnd}
      />
    )}
  </a>
) : (
  <button
    aria-busy={busy}
    class:list={classes}
    disabled={inactive}
    type={type}
    {...rest}
  >
    <Spinner class="mb-btn-spinner" decorative />
    {iconStart && (
      <Icon aria-hidden="true" class="mb-btn-icon" name={iconStart} />
    )}
    <slot />
    {iconEnd && (
      <Icon
        aria-hidden="true"
        class="mb-btn-icon mb-btn-icon-end"
        name={iconEnd}
      />
    )}
  </button>
)}

<style>
  .mb-btn {
    --mb-btn-shift: var(--mb-shift);
    display: inline-flex;
    flex-shrink: 0;
    gap: 8px;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 18px;
    font-family: var(--mb-display);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.015em;
    white-space: nowrap;
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
    transition:
      background-color var(--mb-snap),
      color var(--mb-snap),
      border-color var(--mb-snap),
      box-shadow var(--mb-snap);
  }

  .mb-btn :global(.mb-btn-icon) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  /* Sizes. */
  .mb-btn-size-xs {
    --mb-btn-shift: 2px;
    gap: 4px;
    height: 28px;
    padding: 0 8px;
    font-size: 12px;
  }

  .mb-btn-size-sm {
    --mb-btn-shift: 3px;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    font-size: 13px;
  }

  .mb-btn-size-lg {
    height: 52px;
    padding: 0 24px;
    font-size: 15px;
  }

  .mb-btn-square {
    padding: 0;
  }

  .mb-btn-size-icon-xs {
    --mb-btn-shift: 2px;
    width: 28px;
    height: 28px;
  }

  .mb-btn-size-icon-sm {
    --mb-btn-shift: 3px;
    width: 36px;
    height: 36px;
  }

  .mb-btn-size-icon {
    width: 44px;
  }

  .mb-btn-size-icon-lg {
    width: 52px;
    height: 52px;
  }

  .mb-btn:is(.mb-btn-size-xs, .mb-btn-size-icon-xs) :global(.mb-btn-icon) {
    width: 14px;
    height: 14px;
  }

  .mb-btn:is(.mb-btn-size-lg, .mb-btn-size-icon-lg) :global(.mb-btn-icon) {
    width: 18px;
    height: 18px;
  }

  /* Variants. */
  .mb-btn-default {
    color: var(--v2-bg);
    background: var(--blue);
    border-color: var(--mb-rule);
    box-shadow: var(--mb-btn-shift) var(--mb-btn-shift) 0 var(--mb-rule);
  }

  .mb-btn-default.active {
    color: var(--v2-bg);
    background: var(--ink);
    border-color: var(--ink);
    box-shadow: none;
  }

  .mb-btn-default:is(:hover, [data-state="hover"]) {
    color: var(--v2-bg);
    background: var(--blue-2);
    border-color: var(--mb-rule);
    box-shadow: calc(var(--mb-btn-shift) + 2px) calc(var(--mb-btn-shift) + 2px)
      0 var(--mb-rule);
  }

  /* The ring clears the shadow. */
  .mb-btn-default:is(:focus-visible, [data-state="focus-visible"]) {
    outline-offset: calc(var(--mb-btn-shift) + 4px);
  }

  .mb-btn-secondary {
    background: var(--v2-panel-elevated);
    border-color: var(--mb-hair);
  }

  .mb-btn-secondary:is(:hover, [data-state="hover"]) {
    border-color: var(--mb-rule);
  }

  .mb-btn-outline {
    border-color: var(--mb-rule);
  }

  .mb-btn-outline:is(:hover, [data-state="hover"]) {
    color: var(--v2-bg);
    background: var(--ink);
  }

  .mb-btn-ghost:is(:hover, [data-state="hover"]) {
    background: var(--v2-panel-elevated);
  }

  .mb-btn-destructive {
    color: var(--v2-bg);
    background: var(--error);
    border-color: var(--mb-rule);
  }

  .mb-btn-destructive:is(:hover, [data-state="hover"]) {
    background: color-mix(in srgb, var(--error) 80%, var(--ink));
  }

  .mb-btn-link {
    height: auto;
    padding: 0;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--blue);
    text-underline-offset: 4px;
  }

  .mb-btn-link:is(:hover, [data-state="hover"]) {
    color: var(--blue);
  }

  /* Disabled and loading: flat, muted, nothing moves. */
  .mb-btn:is(
    [disabled],
    [aria-disabled="true"],
    .mb-btn-loading,
    [data-state="submitting"]
  ) {
    color: var(--muted);
    cursor: not-allowed;
    background: var(--v2-panel);
    border-color: var(--mb-hair);
    box-shadow: none;
  }

  .mb-btn-link:is(
    [disabled],
    [aria-disabled="true"],
    .mb-btn-loading,
    [data-state="submitting"]
  ) {
    text-decoration-color: var(--mb-hair);
    background: transparent;
    border-color: transparent;
  }

  /* The end arrow nudges right instead of flying through. */
  .mb-btn :global(.mb-btn-icon-end) {
    transition: transform var(--mb-snap);
  }

  .mb-btn:is(:hover, [data-state="hover"]) :global(.mb-btn-icon-end) {
    transform: translateX(3px);
  }

  .mb-btn:is([disabled], [aria-disabled="true"]) :global(.mb-btn-icon-end) {
    transform: none;
  }

  /* The spinner stands in for the icons while loading. */
  .mb-btn :global(.mb-btn-spinner) {
    display: none;
    font-size: 16px;
  }

  .mb-btn:is(.mb-btn-loading, [data-state="submitting"])
    :global(.mb-btn-spinner) {
    display: inline-flex;
  }

  .mb-btn:is(.mb-btn-loading, [data-state="submitting"]) :global(.mb-btn-icon) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-btn,
    .mb-btn :global(.mb-btn-icon-end) {
      transition: none;
    }
  }
</style>
