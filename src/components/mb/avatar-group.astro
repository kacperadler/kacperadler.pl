---
/* Avatar group: <Avatar>s of the same `size` in the slot, each overlapping
 * the one before by a quarter of its side (8 / 12 / 24px). A 2px ring of the
 * substrate around each one cuts it cleanly out of the one behind. `count`
 * closes the row with a "+N" square that matches the initials avatar (its
 * fill, rule, ring and mono size; "i N więcej" for assistive tech). Each
 * avatar keeps its own alt text. */
interface Props {
  count?: number;
  size?: "sm" | "default" | "lg";
}

const { count, size = "default" } = Astro.props;
---

<div class:list={["mb-avatar-group", `mb-avatar-group-${size}`]}>
  <slot />
  {count !== undefined && count > 0 && (
    <span class="mb-avatar-count">
      <span aria-hidden="true">+{count}</span>
      <span class="sr-only">i {count} więcej</span>
    </span>
  )}
</div>

<style>
  .mb-avatar-group {
    --mb-avatar-overlap: 12px;
    display: flex;
    align-items: center;
    /* Room for the ring of the first one. */
    padding: 2px;
  }

  .mb-avatar-group-sm {
    --mb-avatar-overlap: 8px;
  }

  .mb-avatar-group-lg {
    --mb-avatar-overlap: 24px;
  }

  .mb-avatar-group > :global(*) {
    outline: 2px solid var(--v2-bg);
  }

  .mb-avatar-group > :global(* + *) {
    margin-left: calc(-1 * var(--mb-avatar-overlap));
  }

  /* Positioned like the avatars, so it paints over the last one. */
  .mb-avatar-count {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.02em;
    background: var(--v2-panel-elevated);
    border: 1px solid var(--mb-rule);
  }

  .mb-avatar-group-sm .mb-avatar-count {
    width: 32px;
    height: 32px;
    font-size: 12px;
  }

  .mb-avatar-group-lg .mb-avatar-count {
    width: 96px;
    height: 96px;
    font-size: 20px;
  }
</style>
