---
import { getCollection } from "astro:content";
import { caseHighlights } from "@/data/home";
import { caseStudiesByExperience, caseStudyPath } from "@/lib/case-studies";
import Badge from "../badge.astro";
import Button from "../button.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import Link from "../link.astro";
import SectionHead from "../section-head.astro";

/* Case highlights (#cases): projects told as problem, solution and effect,
 * a two-column cell table. Each card names its company once, in the h3
 * with the kind badge beside it (no logo: the trust bar shows them). The
 * company comes from its experience entry (an unknown id fails the build),
 * and the card links the entry's case study when there is one. "Wszystkie realizacje" leads to the
 * /realizacje/ list, which is built only when a case study exists. */
const experience = new Map(
  (await getCollection("experience")).map((entry) => [entry.id, entry.data])
);
const caseStudies = await caseStudiesByExperience();
const hasCaseStudies = (await getCollection("caseStudies")).length > 0;

const cases = caseHighlights.map((highlight) => {
  const entry = experience.get(highlight.experience);
  if (!entry) {
    throw new Error(
      `Case highlight links to experience "${highlight.experience}", which does not exist.`
    );
  }
  return {
    ...highlight,
    caseStudy: caseStudies.get(highlight.experience),
    company: entry.company,
  };
});
---

<section class="mb-cases" id="cases">
  <div class="container">
    <SectionHead label="Realizacje">
      Co już <em>działa</em>.
      <Fragment slot="lede">
        Każdy projekt oceniam po jednym kryterium: czy ktoś realnie oszczędza
        dzięki niemu czas.
      </Fragment>
    </SectionHead>

    <CellGrid columns={2}>
      {cases.map((item) => (
        <Card>
          <div class="mb-cases-head">
            <h3>{item.company}</h3>
            <Badge variant="outline">{item.kind}</Badge>
          </div>
          <dl class="mb-cases-rows">
            <div class="mb-cases-row">
              <dt>Problem</dt>
              <dd>{item.problem}</dd>
            </div>
            <div class="mb-cases-row">
              <dt>Rozwiązanie</dt>
              <dd>{item.solution}</dd>
            </div>
            <div class="mb-cases-row">
              <dt>Efekt</dt>
              <dd>{item.effect}</dd>
            </div>
          </dl>
          {item.caseStudy && (
            <p class="mb-cases-link">
              <Link href={caseStudyPath(item.caseStudy)} variant="case">
                Zobacz realizację
                <span class="sr-only"> - {item.company}</span>
              </Link>
            </p>
          )}
        </Card>
      ))}
    </CellGrid>

    {hasCaseStudies && (
      <div class="mb-cases-all">
        <Button
          href="/realizacje/"
          iconEnd="lucide:arrow-right"
          variant="outline"
        >
          Wszystkie realizacje
        </Button>
      </div>
    )}
  </div>
</section>

<style>
  .mb-cases {
    margin-top: var(--mb-section-gap);
  }

  .mb-cases-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  h3 {
    margin: 0;
    font-family: var(--mb-display);
    font-size: 24px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-cases-rows {
    flex: 1;
    margin: 0;
  }

  .mb-cases-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--mb-hair);
  }

  .mb-cases-row:last-child {
    padding-bottom: 0;
  }

  .mb-cases-row dt {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .mb-cases-row dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  .mb-cases-link {
    margin: 16px 0 0;
  }

  .mb-cases-all {
    display: flex;
    margin-top: var(--mb-block-gap);
  }

  /* Narrow, a long badge would wrap under its h3 while a short one stays
   * beside it; every badge goes under the name, so the cards read alike. */
  @media (max-width: 480px) {
    .mb-cases-head {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }

  @media (max-width: 400px) {
    .mb-cases-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
