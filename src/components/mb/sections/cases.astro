---
import { getCollection } from "astro:content";
import { logoBySlug } from "@/data/experience-logos";
import { caseHighlights } from "@/data/home";
import { caseStudiesByExperience, caseStudyPath } from "@/lib/case-studies";
import Badge from "../badge.astro";
import Button from "../button.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import Link from "../link.astro";
import SectionHead from "../section-head.astro";

/* Case highlights (#cases): projects told as problem, solution and effect,
 * newest first, a two-column cell table (one column at 880px and below)
 * whose cells in a row are equally tall. Each card names its company once:
 * the h3 is its logo (two for a project built for two companies), the alt
 * text the company, grey until the cell is hovered, with the kind badge
 * beside it. The companies and logos come from their experience entries
 * (an unknown id or a missing logo fails the build), and the card links
 * the first entry's case study when there is one. "Wszystkie realizacje"
 * leads to the /realizacje/ list, which is built only when a case study
 * exists. */
const experience = new Map(
  (await getCollection("experience")).map((entry) => [entry.id, entry.data])
);
const caseStudies = await caseStudiesByExperience();
const hasCaseStudies = (await getCollection("caseStudies")).length > 0;

const cases = caseHighlights.map((highlight) => {
  const companies = highlight.experiences.map((id) => {
    const entry = experience.get(id);
    const logo = logoBySlug[id];
    if (!(entry && logo)) {
      throw new Error(
        `Case highlight links to experience "${id}", which does not exist or has no logo.`
      );
    }
    return { logo, name: entry.company };
  });
  const caseStudy = highlight.experiences
    .map((id) => caseStudies.get(id))
    .find(Boolean);
  return {
    ...highlight,
    caseStudy,
    companies,
    company: companies.map((company) => company.name).join(" i "),
  };
});
---

<section class="mb-cases" id="cases">
  <div class="container">
    <SectionHead label="Realizacje">
      Co już <em>działa</em>.
      <Fragment slot="lede">
        Każdy projekt oceniam po jednym kryterium: czy ktoś realnie oszczędza
        dzięki niemu czas.
      </Fragment>
    </SectionHead>

    <CellGrid class="mb-cases-grid" columns={2}>
      {cases.map((item) => (
        <Card>
          <div class="mb-cases-head">
            <h3 class="mb-cases-logos">
              {item.companies.map((company, i) => (
                <>
                  {i > 0 && <span class="sr-only"> i </span>}
                  <img
                    alt={company.name}
                    class="mb-cases-logo"
                    height={company.logo.height}
                    loading="lazy"
                    src={company.logo.src}
                    width={company.logo.width}
                  >
                </>
              ))}
            </h3>
            <Badge variant="outline">{item.kind}</Badge>
          </div>
          <dl class="mb-cases-rows">
            <div class="mb-cases-row">
              <dt>Problem</dt>
              <dd>{item.problem}</dd>
            </div>
            <div class="mb-cases-row">
              <dt>Rozwiązanie</dt>
              <dd>{item.solution}</dd>
            </div>
            <div class="mb-cases-row">
              <dt>Efekt</dt>
              <dd>{item.effect}</dd>
            </div>
          </dl>
          {item.caseStudy && (
            <p class="mb-cases-link">
              <Link href={caseStudyPath(item.caseStudy)} variant="case">
                Zobacz realizację
                <span class="sr-only"> - {item.company}</span>
              </Link>
            </p>
          )}
        </Card>
      ))}
    </CellGrid>

    {hasCaseStudies && (
      <div class="mb-cases-all">
        <Button
          href="/realizacje/"
          iconEnd="lucide:arrow-right"
          variant="outline"
        >
          Wszystkie realizacje
        </Button>
      </div>
    )}
  </div>
</section>

<style>
  .mb-cases {
    margin-top: var(--mb-section-gap);
  }

  /* The cells of a row share five row tracks (head, problem, solution,
   * effect, the case study link): card, content and list are nested
   * subgrids, so the cells are equally tall and each label starts on one
   * line across the row. */
  .mb-cases :global(.mb-cases-grid > .mb-card) {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
  }

  .mb-cases :global(.mb-cases-grid .mb-card-content) {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / -1;
    row-gap: 0;
  }

  .mb-cases-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  /* The logos stand for the company name: grey until the cell is hovered,
   * like every logo on the page. */
  .mb-cases-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    min-height: 32px;
    margin: 0;
  }

  .mb-cases-logo {
    width: auto;
    max-width: 160px;
    height: auto;
    max-height: 28px;
    opacity: 0.6;
    filter: grayscale(100%);
    transition:
      filter var(--mb-snap),
      opacity var(--mb-snap);
  }

  :global(.mb-card[data-state="hover"]) .mb-cases-logo {
    opacity: 1;
    filter: grayscale(0%);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.mb-card:hover) .mb-cases-logo {
      opacity: 1;
      filter: grayscale(0%);
    }
  }

  .mb-cases-rows {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0;
    margin: 0;
  }

  .mb-cases-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--mb-hair);
  }

  .mb-cases-row:last-child {
    padding-bottom: 0;
  }

  .mb-cases-row dt {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .mb-cases-row dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
  }

  .mb-cases-link {
    grid-row: 5;
    margin: 16px 0 0;
  }

  .mb-cases-all {
    display: flex;
    margin-top: var(--mb-block-gap);
  }

  /* Narrow, a long badge would wrap under its logos while a short one stays
   * beside them; every badge goes under the logos, so the cards read
   * alike. */
  @media (max-width: 480px) {
    .mb-cases-head {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }

  @media (max-width: 400px) {
    .mb-cases-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
