---
import { siteConfig } from "@/data/site-config";
import CellGrid from "../cell-grid.astro";
import ContactForm from "../contact-form.astro";
import ContactLink from "../contact-link.astro";
import SectionHead from "../section-head.astro";

/* Contact (#contact): the form and the two direct links close into one
 * sheet across the container under the section head - the form first,
 * the main action, then the links as its last ruled row, sharing the
 * form's bottom rule. The sheet is one element, so a layout that
 * places the section's content as one block (a design proposal) keeps its
 * rows together. */
---

<section class="mb-contact" id="contact">
  <div class="container">
    <SectionHead label="Kontakt">
      Pokaż mi proces, który zjada <em>Twój czas</em>.
      <Fragment slot="lede">
        Napisz w 2–3 zdaniach, co robicie ręcznie. Odpowiem w 24h z pierwszym
        pomysłem i terminem 30-minutowej rozmowy.
      </Fragment>
    </SectionHead>

    <div class="mb-contact-sheet">
      <div class="mb-contact-form-host">
        <ContactForm />
      </div>

      <CellGrid class="mb-contact-links" columns={2}>
        <ContactLink
          href={`mailto:${siteConfig.email}`}
          icon="lucide:mail"
          label="Email"
        >
          {siteConfig.email}
        </ContactLink>
        <ContactLink
          href={siteConfig.social.linkedin}
          icon="lucide:linkedin"
          label="LinkedIn"
          newTab
        >
          /in/kacperadler
        </ContactLink>
      </CellGrid>
    </div>
  </div>
</section>

<style>
  .mb-contact {
    margin-top: var(--v2-space-2xl);
  }

  .mb-contact-form-host {
    display: flex;
  }

  .mb-contact :global(.mb-contact-links) {
    margin-top: -1px;
  }

  @media (max-width: 880px) {
    .mb-contact {
      margin-top: var(--v2-space-xl);
    }
  }
</style>
