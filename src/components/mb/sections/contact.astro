---
import { siteConfig } from "@/data/site-config";
import CellGrid from "../cell-grid.astro";
import ContactForm from "../contact-form.astro";
import ContactLink from "../contact-link.astro";
import SectionHead from "../section-head.astro";

/* Contact (#contact): the two links and the form close into one sheet,
 * left-aligned under the section head - the links a ruled row of cells,
 * the form right under them sharing the rule. */
---

<section class="mb-contact" id="contact">
  <div class="container">
    <SectionHead label="Kontakt">
      Porozmawiajmy o&nbsp;Twoim <em>pomyśle</em>.
      <Fragment slot="lede">
        Napisz krótko: co budujesz, w jakim terminie i co Cię blokuje. Odpowiem
        w ciągu 24 godzin.
      </Fragment>
    </SectionHead>

    <div class="mb-contact-sheet">
      <CellGrid min="280px">
        <ContactLink
          href={`mailto:${siteConfig.email}`}
          icon="lucide:mail"
          label="Email"
        >
          {siteConfig.email}
        </ContactLink>
        <ContactLink
          href={siteConfig.social.linkedin}
          icon="lucide:linkedin"
          label="LinkedIn"
          newTab
        >
          /in/kacperadler
        </ContactLink>
      </CellGrid>

      <div class="mb-contact-form-host">
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .mb-contact {
    margin-top: var(--v2-space-2xl);
  }

  .mb-contact-sheet {
    max-width: 720px;
  }

  .mb-contact-form-host {
    display: flex;
    margin-top: -1px;
  }

  @media (max-width: 880px) {
    .mb-contact {
      margin-top: var(--v2-space-xl);
    }
  }
</style>
