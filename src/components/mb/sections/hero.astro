---
import Badge from "../badge.astro";
import Button from "../button.astro";
import Link from "../link.astro";

/* Hero (#top): a heavy headline on the bare substrate beside the results
 * card, a framed cell as tall as the text column: a mono caption and the
 * "Przyjmuję nowe projekty" badge, then a ruled table of facts the page
 * backs up further down - a big figure and what it counts - and a link to
 * the case highlights (#cases). One column at 880px and below. */
const results = [
  {
    figure: "+250",
    text: "osób pracuje dziennie na narzędziach, które tworzyłem",
  },
  {
    figure: "+100",
    text: "osób dziennie korzysta z aplikacji mobilnej jednego z moich klientów",
  },
  {
    figure: "24 godziny",
    text: "tyle potrzebuję, aby przyjść do Ciebie z pierwszym pomysłem",
  },
];
---

<section class="mb-hero" id="top">
  <div class="container mb-hero-grid">
    <div class="mb-hero-text">
      <h1>Zamień ręczną robotę na <em>czas</em> na rozwój Twojego biznesu</h1>

      <p class="mb-hero-sub">
        Wdrożenia AI, automatyzacje oraz aplikacje szyte na miarę dla firm.
        Znajduję procesy, które zjadają czas Twój oraz Twojego zespołu, a
        następnie zamieniam je w działające systemy i automatyzacje. Bez
        zatrudniania dodatkowego zespołu.
      </p>

      <div class="mb-hero-ctas">
        <Button href="#contact" iconEnd="lucide:arrow-right"
          >Umów bezpłatną konsultację</Button
        >
        <Button href="#services" variant="outline"
          >Zobacz, co mogę dla Ciebie zrobić</Button
        >
      </div>
    </div>

    <aside aria-label="Efekty w liczbach" class="mb-hero-status">
      <div class="mb-status-head">
        <p class="mb-status-caption">W liczbach</p>
        <Badge variant="status">Przyjmuję nowe projekty</Badge>
      </div>

      <ul class="mb-status-rows">
        {results.map((result) => (
          <li class="mb-status-row">
            <span class="mb-status-figure">{result.figure}</span>
            <span class="mb-status-text">{result.text}</span>
          </li>
        ))}
      </ul>

      <p class="mb-status-link">
        <Link href="#cases" variant="case">Zobacz realizacje</Link>
      </p>
    </aside>
  </div>
</section>

<style>
  .mb-hero {
    padding: var(--v2-space-2xl) 0 var(--v2-space-xl);
  }

  .mb-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--v2-space-xl);
    align-items: stretch;
  }

  .mb-hero-text {
    min-width: 0;
  }

  h1 {
    max-width: 22ch;
    margin: 0 0 24px;
    font-family: var(--mb-display);
    font-size: clamp(40px, 5.8vw, 70px);
    font-weight: 800;
    line-height: 0.98;
    color: var(--ink);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  h1 em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-decoration-color: var(--blue);
    text-decoration-skip-ink: none;
    text-underline-offset: 0.08em;
  }

  .mb-hero-sub {
    max-width: 56ch;
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .mb-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .mb-hero-status {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: var(--v2-space-lg);
    background: var(--v2-bg);
    border: 1px solid var(--mb-rule);
  }

  .mb-status-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }

  .mb-status-caption {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* The rows share the card's spare height, so the table fills the cell
   * beside a taller text column instead of leaving a gap above it. */
  .mb-status-rows {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-status-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--mb-hair);
  }

  .mb-status-row:last-child {
    border-bottom: 1px solid var(--mb-hair);
  }

  .mb-status-figure {
    font-family: var(--mb-display);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.045em;
  }

  .mb-status-text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .mb-status-link {
    margin: 0;
  }

  @media (max-width: 880px) {
    .mb-hero {
      padding: 48px 0 var(--v2-space-lg);
    }

    .mb-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--v2-space-lg);
    }

    .mb-hero-status {
      padding: var(--v2-space-md);
    }
  }

  @media (max-width: 400px) {
    .mb-status-row {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    .mb-status-figure {
      font-size: 30px;
    }
  }
</style>
