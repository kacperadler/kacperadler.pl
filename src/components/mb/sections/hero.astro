---
import Button from "../button.astro";

/* Hero (#top): the headline, subtitle and two buttons beside the results
 * card ("W liczbach": the mono caption, a description list of three ruled
 * rows - the figure (dt) in large type over what it counts (dd) - and a
 * button to the case highlights, #cases). The headline is the page's only
 * h1.
 *
 * The two columns share one grid: they are equally tall, the text column
 * is padded like the card, so the headline starts level with the card's
 * caption and the hero buttons sit on the same line as the card's button,
 * at the foot of both. The card's rows split the height left between its
 * head and its button evenly (equal rows at every width), and every
 * figure starts at the same x. At 880px and below the columns stack and
 * every button takes the full width.
 *
 * The blueprint's marks (global.css): the drawing's datum - a blue cross
 * with "X 0  Y 0" - sits in the hero's top padding over the headline's
 * corner; the <em> is under a blue dimension brace with its callout; the
 * results card is the sheet's title block, with the sheet's header ("Rys.
 * KA-001 · Arkusz 1/1") as a strip across its top, which the text column
 * is padded for, so the headline stays level with the caption. The hero
 * is on the screen from the start, so it draws on load: the cross grows
 * from its centre (0-0.25 of the pen), the datum is written (0.25-0.5),
 * the brace runs out (0.3-0.7) and gets its callout (0.7-0.8); the title
 * block traces its frame clockwise (0-0.6), writes its header (0.5-0.8)
 * and rules its rows (0.6-1). At 880px and below the title block is
 * under the fold and draws like a cell once it is whole on the screen. */
const results = [
  {
    figure: "250+",
    text: "osób codziennie pracuje w systemach, które współtworzyłem",
  },
  {
    figure: "100+",
    text: "osób codziennie korzysta z aplikacji mobilnej, którą stworzyłem dla klienta",
  },
  {
    figure: "24 h",
    text: "w tym czasie wracam z pierwszym pomysłem na automatyzację",
  },
];
---

<section class="mb-hero" id="top">
  <div class="container mb-hero-grid">
    <div class="mb-hero-text">
      <h1>
        Wdrożenia AI i automatyzacje, które przejmują <em>nudną pracę</em>
      </h1>

      <p class="mb-hero-sub">
        Tworzę automatyzacje, integracje i aplikacje szyte na miarę. Znajduję
        procesy, które zabierają czas, i zamieniam je w działające systemy. Ty
        skupiasz się na biznesie i rozwoju firmy, a powtarzalne zadania
        zostawiasz mnie.
      </p>

      <div class="mb-hero-ctas">
        <Button href="#contact" iconEnd="lucide:arrow-right"
          >Umów bezpłatną konsultację</Button
        >
        <Button href="#services" variant="outline"
          >Zobacz, co mogę zrobić dla Twojej firmy</Button
        >
      </div>
    </div>

    <aside aria-label="Efekty w liczbach" class="mb-hero-status">
      <p class="mb-status-caption">W liczbach</p>

      <dl class="mb-status-rows">
        {results.map((result) => (
          <div class="mb-status-row">
            <dt class="mb-status-figure">{result.figure}</dt>
            <dd class="mb-status-text">{result.text}</dd>
          </div>
        ))}
      </dl>

      <div class="mb-status-cta">
        <Button href="#cases" iconEnd="lucide:arrow-right" variant="outline"
          >Zobacz realizacje</Button
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .mb-hero {
    --mb-hero-pad: var(--v2-space-lg);
    /* The title block's header strip: its type, padding and rule. */
    --mb-hero-head: 31px;
    padding: var(--v2-space-2xl) 0 var(--v2-space-xl);
  }

  .mb-hero-grid {
    --bl-datum: calc(-1 * var(--v2-space-lg));
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--v2-space-xl);
    align-items: stretch;
  }

  /* The datum's cross: two 1px arms on a 17px square, grown from the
   * centre. */
  .mb-hero-grid::before {
    --bl-s: clamp(0, var(--bl-p) * 4, 1);
    position: absolute;
    top: var(--bl-datum);
    left: calc(var(--v2-space-md) - 8px);
    width: 17px;
    height: 17px;
    content: "";
    background:
      linear-gradient(var(--blue) 0 0) 50% 50% / calc(var(--bl-e) * 100%) 1px
      no-repeat,
      linear-gradient(var(--blue) 0 0) 50% 50% / 1px calc(var(--bl-e) * 100%)
      no-repeat;
  }

  /* Written next to it. */
  .mb-hero-grid::after {
    --bl-s: clamp(0, (var(--bl-p) - 0.25) * 4, 1);
    position: absolute;
    top: calc(var(--bl-datum) + 4px);
    left: calc(var(--v2-space-md) + 14px);
    font: var(--mb-note);
    color: var(--ink-2);
    letter-spacing: 0.08em;
    white-space: pre;
    content: "X 0  Y 0" / "";
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
  }

  /* Padded like the card - its rule, its header strip and the gap under
   * it - so the headline and the card's caption share a top line, and
   * the buttons a bottom one. */
  .mb-hero-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: calc(1px + var(--mb-hero-head) + 24px) 0
      calc(var(--mb-hero-pad) + 1px);
  }

  h1 {
    max-width: 22ch;
    margin: 0 0 var(--v2-space-lg);
    font-family: var(--mb-display);
    font-size: clamp(40px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.05em;
    text-wrap: balance;
    counter-reset: bl-callout;
  }

  h1 em {
    position: relative;
    font-style: normal;
    white-space: nowrap;
    counter-increment: bl-callout;
  }

  /* The brace runs out left to right under the <em>. */
  h1 em::after {
    --bl-s: clamp(0, (var(--bl-p) - 0.3) * 2.5, 1);
    position: absolute;
    right: 0.02em;
    bottom: 0.02em;
    left: 0.02em;
    height: 0.14em;
    pointer-events: none;
    content: "";
    border: max(2px, 0.05em) solid var(--blue);
    border-top: 0;
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
  }

  /* The callout hangs off the brace's right end. */
  h1 em::before {
    --bl-s: clamp(0, (var(--bl-p) - 0.7) * 10, 1);
    position: absolute;
    bottom: 0.02em;
    left: 100%;
    padding: 2px 3px;
    margin-left: 0.12em;
    font: var(--mb-note);
    color: var(--v2-bg);
    letter-spacing: 0;
    content: counter(bl-callout, upper-alpha) / "";
    background: var(--blue);
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
    transform: translateY(50%);
  }

  .mb-hero-sub {
    max-width: 56ch;
    margin: 0 0 var(--v2-space-lg);
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .mb-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: auto;
  }

  /* The title block: its frame traced like a cell's, top, right, bottom,
   * left, as one eased stage, each rule a quarter of it. */
  .mb-hero-status {
    --bl-s: clamp(0, var(--bl-p) / 0.6, 1);
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    padding: var(--mb-hero-pad);
    background: var(--v2-bg);
    background-image:
      linear-gradient(var(--mb-rule) 0 0), linear-gradient(var(--mb-rule) 0 0),
      linear-gradient(var(--mb-rule) 0 0), linear-gradient(var(--mb-rule) 0 0);
    background-repeat: no-repeat;
    background-position:
      0 0,
      100% 0,
      100% 100%,
      0 100%;
    background-origin: border-box;
    background-size:
      calc(clamp(0, var(--bl-e) * 4, 1) * 100%) 1px,
      1px calc(clamp(0, var(--bl-e) * 4 - 1, 1) * 100%),
      calc(clamp(0, var(--bl-e) * 4 - 2, 1) * 100%) 1px,
      1px calc(clamp(0, var(--bl-e) * 4 - 3, 1) * 100%);
    border: 1px solid var(--mb-rule);
  }

  /* The sheet's header, a strip across the block's top, written left to
   * right. */
  .mb-hero-status::before {
    --bl-s: clamp(0, (var(--bl-p) - 0.5) / 0.3, 1);
    padding: 10px var(--mb-hero-pad);
    margin: calc(-1 * var(--mb-hero-pad)) calc(-1 * var(--mb-hero-pad)) 0;
    font: var(--mb-note);
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    content: "Rys. KA-001 · Arkusz 1/1" / "";
    border-bottom: 1px solid var(--mb-rule);
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
  }

  .mb-status-caption {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Equal rows: each as tall as the tallest, and together they take the
   * height the card has between its caption and its button. Their
   * hairlines (over each row, under the last) run out left to right. */
  .mb-status-rows {
    --bl-s: clamp(0, (var(--bl-p) - 0.6) / 0.4, 1);
    display: grid;
    flex: 1;
    grid-auto-rows: 1fr;
    padding: 0;
    margin: 0;
    background-image: linear-gradient(var(--mb-hair) 0 0);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-origin: border-box;
    background-size: calc(var(--bl-e) * 100%) 1px;
    border-bottom: 1px solid var(--mb-hair);
  }

  .mb-status-row {
    --bl-s: clamp(0, (var(--bl-p) - 0.6) / 0.4, 1);
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    padding: 14px 0;
    background-image: linear-gradient(var(--mb-hair) 0 0);
    background-repeat: no-repeat;
    background-position: 0 0;
    background-origin: border-box;
    background-size: calc(var(--bl-e) * 100%) 1px;
    border-top: 1px solid var(--mb-hair);
  }

  .mb-status-figure {
    font-family: var(--mb-display);
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.045em;
  }

  .mb-status-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .mb-status-cta {
    display: flex;
  }

  /* With the page's script: the rules are drawn by the backgrounds, not
   * the borders, and the hero plays on load. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-bl-live]) .mb-hero-status {
      border-color: transparent;
    }

    :global(html[data-bl-live]) .mb-status-rows,
    :global(html[data-bl-live]) .mb-status-row {
      border-color: transparent;
    }

    :global(html[data-bl-live]) .mb-hero-grid::before,
    :global(html[data-bl-live]) .mb-hero-grid::after,
    :global(html[data-bl-live]) h1 em::before,
    :global(html[data-bl-live]) h1 em::after,
    :global(html[data-bl-live]) .mb-hero-status,
    :global(html[data-bl-live]) .mb-hero-status::before,
    :global(html[data-bl-live]) .mb-status-rows,
    :global(html[data-bl-live]) .mb-status-row {
      animation: bl-draw var(--mb-pen) linear both;
    }
  }

  @media (max-width: 880px) {
    .mb-hero {
      --mb-hero-pad: var(--v2-space-md);
      padding: 48px 0 var(--v2-space-lg);
    }

    .mb-hero-grid {
      --bl-datum: -22px;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--v2-space-lg);
    }

    .mb-hero-text {
      padding: 0;
    }

    .mb-hero-ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .mb-hero :global(.mb-btn) {
      width: 100%;
      height: auto;
      min-height: 44px;
      white-space: normal;
    }

    /* A label longer than a narrow column (a wider fallback font before
     * Geist loads) wraps inside the button instead of widening the page. */
    .mb-hero :global(.mb-btn-face) {
      padding-block: 10px;
      text-align: center;
    }

    .mb-status-figure {
      font-size: 26px;
    }

    /* One column: the title block is under the fold, it draws like a cell
     * once it is on the screen. */
    @media (prefers-reduced-motion: no-preference) {
      :global(html[data-bl-live]) .mb-hero-status:not([data-bl-drawn]),
      :global(html[data-bl-live]) .mb-hero-status:not([data-bl-drawn])::before,
      :global(html[data-bl-live])
        .mb-hero-status:not([data-bl-drawn])
        .mb-status-rows,
      :global(html[data-bl-live])
        .mb-hero-status:not([data-bl-drawn])
        .mb-status-row {
        --bl-p: 0;
        animation: none;
      }
    }
  }
</style>
