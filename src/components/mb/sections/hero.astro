---
import Badge from "../badge.astro";
import Button from "../button.astro";

/* Hero (#top): the headline, subtitle and two buttons beside the results
 * card ("W liczbach": the status badge, three ruled rows of a big figure
 * over what it counts, and a button to the case highlights, #cases).
 *
 * The two columns share one grid: they are equally tall, the text column
 * is padded like the card, so the headline starts level with the card's
 * caption and the hero buttons sit on the same line as the card's button,
 * at the foot of both. The card's rows split the height left between its
 * head and its button evenly (equal rows at every width), and every
 * figure starts at the same x. At 880px and below the columns stack and
 * every button takes the full width. */
const results = [
  {
    figure: "+250",
    text: "osób pracuje dziennie na narzędziach, które tworzyłem",
  },
  {
    figure: "+100",
    text: "osób dziennie korzysta z aplikacji mobilnej jednego z moich klientów",
  },
  {
    figure: "24 godziny",
    text: "tyle potrzebuję, aby przyjść do Ciebie z pierwszym pomysłem",
  },
];
---

<section class="mb-hero" id="top">
  <div class="container mb-hero-grid">
    <div class="mb-hero-text">
      <h1>Zamień ręczną robotę na <em>czas</em> na rozwój Twojego biznesu</h1>

      <p class="mb-hero-sub">
        Wdrożenia AI, automatyzacje oraz aplikacje szyte na miarę dla firm.
        Znajduję procesy, które zjadają czas Twój oraz Twojego zespołu, a
        następnie zamieniam je w działające systemy i automatyzacje. Bez
        zatrudniania dodatkowego zespołu.
      </p>

      <div class="mb-hero-ctas">
        <Button href="#contact" iconEnd="lucide:arrow-right"
          >Umów bezpłatną konsultację</Button
        >
        <Button href="#services" variant="outline"
          >Zobacz, co mogę dla Ciebie zrobić</Button
        >
      </div>
    </div>

    <aside aria-label="Efekty w liczbach" class="mb-hero-status">
      <div class="mb-status-head">
        <p class="mb-status-caption">W liczbach</p>
        <Badge variant="status">Przyjmuję nowe projekty</Badge>
      </div>

      <ul class="mb-status-rows">
        {results.map((result) => (
          <li class="mb-status-row">
            <span class="mb-status-figure">{result.figure}</span>
            <span class="mb-status-text">{result.text}</span>
          </li>
        ))}
      </ul>

      <div class="mb-status-cta">
        <Button href="#cases" iconEnd="lucide:arrow-right" variant="outline"
          >Zobacz realizacje</Button
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .mb-hero {
    --mb-hero-pad: var(--v2-space-lg);
    padding: var(--v2-space-2xl) 0 var(--v2-space-xl);
  }

  .mb-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--v2-space-xl);
    align-items: stretch;
  }

  /* Padded like the card (its padding plus its 1px rule), so the headline
   * and the card's caption share a top line and the buttons a bottom one. */
  .mb-hero-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: calc(var(--mb-hero-pad) + 1px) 0;
  }

  h1 {
    max-width: 22ch;
    margin: 0 0 var(--v2-space-lg);
    font-family: var(--mb-display);
    font-size: clamp(40px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  h1 em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-decoration-color: var(--blue);
    text-decoration-skip-ink: none;
    text-underline-offset: 0.08em;
  }

  .mb-hero-sub {
    max-width: 56ch;
    margin: 0 0 var(--v2-space-lg);
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .mb-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: auto;
  }

  .mb-hero-status {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    padding: var(--mb-hero-pad);
    background: var(--v2-bg);
    border: 1px solid var(--mb-rule);
  }

  .mb-status-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }

  .mb-status-caption {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Equal rows: each as tall as the tallest, and together they take the
   * height the card has between its head and its button. */
  .mb-status-rows {
    display: grid;
    flex: 1;
    grid-auto-rows: 1fr;
    padding: 0;
    margin: 0;
    list-style: none;
    border-bottom: 1px solid var(--mb-hair);
  }

  .mb-status-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    padding: 14px 0;
    border-top: 1px solid var(--mb-hair);
  }

  .mb-status-figure {
    font-family: var(--mb-display);
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.045em;
  }

  .mb-status-text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .mb-status-cta {
    display: flex;
  }

  @media (max-width: 880px) {
    .mb-hero {
      --mb-hero-pad: var(--v2-space-md);
      padding: 48px 0 var(--v2-space-lg);
    }

    .mb-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--v2-space-lg);
    }

    .mb-hero-text {
      padding: 0;
    }

    .mb-hero-ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .mb-hero :global(.mb-btn) {
      width: 100%;
    }

    .mb-status-figure {
      font-size: 26px;
    }
  }
</style>
