---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import apptensionLogo from "@/assets/experience/apptension.svg";
import energiadirectLogo from "@/assets/experience/energiadirect.svg";
import helpfindLogo from "@/assets/experience/helpfind.svg";
import paylooLogo from "@/assets/experience/payloo.jpg";
import pwcLogo from "@/assets/experience/pwc.svg";
import rexLogo from "@/assets/experience/rex.svg";
import { caseStudiesByExperience, caseStudyPath } from "@/lib/case-studies";
import Badge from "../badge.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import Link from "../link.astro";
import SectionHead from "../section-head.astro";

/* Experience (#experience): the logo wall as a cell table, three cells a
 * row on the desktop. Logos stay grey until their cell is hovered. The
 * badge is "teraz" for the current role, the entry's own `badge` field
 * (e.g. "Zlecenie"), or the year range; an entry with a case study links
 * to it. */
const logoBySlug: Record<string, ImageMetadata> = {
  apptension: apptensionLogo,
  energiadirect: energiadirectLogo,
  helpfind: helpfindLogo,
  payloo: paylooLogo,
  pwc: pwcLogo,
  rex: rexLogo,
};

const experience = (await getCollection("experience"))
  .filter((item) => Boolean(logoBySlug[item.id]))
  .sort((a, b) => a.data.order - b.data.order);

const caseStudies = await caseStudiesByExperience();
---

<section class="mb-experience" id="experience">
  <div class="container">
    <SectionHead label="Współprace">
      Z kim <em>pracowałem</em>.
      <Fragment slot="lede">
        Tworzyłem projekty i współpracowałem z firmami z różnych branż - od
        korporacji po side-projekty.
      </Fragment>
    </SectionHead>

    <CellGrid min="320px" tag="ul">
      {experience.map((item) => {
        const logo = logoBySlug[item.id] as ImageMetadata;
        const startYear = item.data.startDate.slice(0, 4);
        const endYear = item.data.endDate?.slice(0, 4);
        let metaLabel: string;
        let metaFilled: boolean;
        if (item.data.current) {
          metaLabel = "teraz";
          metaFilled = true;
        } else if (item.data.badge) {
          metaLabel = item.data.badge;
          metaFilled = true;
        } else {
          metaLabel = `${startYear}–${endYear}`;
          metaFilled = false;
        }
        const caseStudy = caseStudies.get(item.id);
        return (
          <Card tag="li">
            <div class="mb-exp-head">
              <img
                alt={item.data.company}
                class="mb-exp-logo"
                height={logo.height}
                src={logo.src}
                width={logo.width}
              />
              <Badge variant={metaFilled ? "default" : "outline"}>
                {metaLabel}
              </Badge>
            </div>
            <h3>{item.data.company}</h3>
            <p class="mb-exp-role">{item.data.role}</p>
            <p class="mb-exp-desc">{item.data.description}</p>
            {caseStudy && (
              <p class="mb-exp-case">
                <Link href={caseStudyPath(caseStudy)} variant="case">
                  Zobacz realizację
                  <span class="sr-only"> - {item.data.company}</span>
                </Link>
              </p>
            )}
          </Card>
        );
      })}
    </CellGrid>
  </div>
</section>

<style>
  .mb-experience {
    margin-top: var(--v2-space-2xl);
  }

  .mb-exp-head {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin-bottom: 16px;
  }

  .mb-exp-logo {
    width: auto;
    max-width: 140px;
    max-height: 32px;
    opacity: 0.6;
    filter: grayscale(100%);
    transition:
      filter var(--mb-snap),
      opacity var(--mb-snap);
  }

  :global(.mb-card:is(:hover, [data-state="hover"])) .mb-exp-logo {
    opacity: 1;
    filter: grayscale(0%);
  }

  h3 {
    margin: 0 0 4px;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-exp-role {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--blue);
    letter-spacing: 0.02em;
  }

  .mb-exp-desc {
    flex: 1;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }

  .mb-exp-case {
    margin: 16px 0 0;
  }

  @media (max-width: 880px) {
    .mb-experience {
      margin-top: var(--v2-space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-exp-logo {
      transition: none;
    }
  }
</style>
