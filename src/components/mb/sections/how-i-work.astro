---
import { processSteps } from "@/data/process";
import Badge from "../badge.astro";
import Button from "../button.astro";
import Card from "../card.astro";
import ProcessFigure from "../process-figure.astro";
import SectionHead from "../section-head.astro";
import StepMarker from "../step-marker.astro";

/* Process (#how), the page's signature: the route of a process sheet, its
 * steps on a rail of square numbered marks that fills lime as the page
 * scrolls (step-marker.astro). Each card opens on the step's detail
 * drawing (process-figure.astro, its lime layer drawn in as the rail comes
 * to it), then one line - the title on the left, the duration badge at the
 * right end - the description, and under a hairline the step's outcome
 * after the lime arrow, as the problems cells show their effect.
 *
 * Desktop: the rail runs down the middle and the steps alternate left and
 * right of it, staggered - one grid whose steps each span two rows, every
 * next step one row lower, so a card starts about halfway down the one
 * before it on the other side and no side is left empty. A short
 * horizontal connector joins each card to its mark at the mark's height:
 * 1px ink, 2px lime once the mark has filled.
 *
 * At 880px and below one column with the rail on the left, the cards
 * 40px apart, no connectors. Under the steps, the
 * button to the contact form. */
---

<section class="mb-how" id="how">
  <div class="container">
    <SectionHead label="Proces" poster>
      Od rozmowy do <em>działającego</em> systemu.
      <Fragment slot="lede">
        Pięć kroków. Na każdym wiesz, co robimy i co z niego dostajesz.
      </Fragment>
    </SectionHead>

    <ol class="mb-how-steps">
      {processSteps.map((step, i) => (
        <li class="mb-step" style={`--mb-step-row: ${i + 1}`}>
          <StepMarker num={step.num} />
          <Card tag="div">
            <ProcessFigure name={step.figure} slot="image" />
            <div class="mb-step-head">
              <h3>{step.title}</h3>
              <Badge variant="outline">{step.badge}</Badge>
            </div>
            <p class="mb-step-desc">{step.description}</p>
            <p class="mb-step-outcome">
              <span aria-hidden="true" class="mb-step-arrow">
                →
              </span>
              {step.outcome}
            </p>
          </Card>
          <span aria-hidden="true" class="mb-step-link" />
        </li>
      ))}
    </ol>

    <div class="mb-how-cta">
      <Button href="#contact" iconEnd="lucide:arrow-right"
        >Umów bezpłatną rozmowę</Button
      >
    </div>
  </div>
</section>

<style>
  .mb-how {
    --mb-how-rail: 80px;
    --mb-how-dot: 48px;
    margin-top: var(--mb-section-gap);
  }

  /* Desktop: card | rail | card. A step takes rows n and n+1, the next
   * step n+1 and n+2, so the two sides overlap by a row; two cards on one
   * side stand a row gap apart. The gap is wide (280px, about 0.7 of a
   * card with its drawing, 370-420px), so a card starts near the foot of
   * the one before it: each step stands clear of its neighbours, and the
   * sides still overlap a little, so neither has a hole. */
  .mb-how-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--mb-how-rail) minmax(0, 1fr);
    row-gap: 280px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-step {
    display: contents;
  }

  .mb-step > :global(*) {
    grid-row: var(--mb-step-row) / span 2;
  }

  .mb-step > :global(.mb-step-marker) {
    grid-column: 2;
  }

  .mb-step > :global(.mb-card) {
    grid-column: 1;
  }

  .mb-step:nth-child(even) > :global(.mb-card) {
    grid-column: 3;
  }

  /* The steps carry their numbers on the rail already. */
  .mb-step > :global(.mb-card::before) {
    content: none;
  }

  /* The connector: from the mark's edge to the card's, on the mark's
   * centre. A 2px box drawing a 1px ink line until the fill reaches the
   * mark, then a 2px lime one; filled from the start under reduced motion
   * or without view timelines, like the rail. */
  .mb-step-link {
    position: relative;
    grid-column: 2;
    align-self: center;
    justify-self: start;
    width: calc((var(--mb-how-rail) - var(--mb-how-dot)) / 2);
    height: 2px;
    pointer-events: none;
    background: var(--blue);
  }

  .mb-step:nth-child(even) > .mb-step-link {
    justify-self: end;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mb-step-link {
        animation: mb-step-link linear both;
        animation-range: cover calc(50vh + 1px) cover calc(50vh + 2px);
      }

      /* Its own rule: the build's minifier folds an animation-timeline
       * into the animation shorthand, where browsers drop it. */
      .mb-step > .mb-step-link {
        animation-timeline: view();
      }
    }
  }

  @keyframes mb-step-link {
    from {
      background-color: transparent;
      box-shadow: inset 0 1px 0 var(--mb-rule);
    }

    to {
      background-color: var(--blue);
      box-shadow: none;
    }
  }

  /* One line: title left, the duration at the right end. It never wraps
   * below: a long title wraps inside its own box, and the badge sits on
   * its first line (24px high). */
  .mb-step-head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .mb-step-head :global(.mb-badge) {
    margin-top: 1px;
    margin-left: auto;
  }

  .mb-step-head h3 {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-step-desc {
    max-width: 70ch;
    margin: 0;
  }

  /* The outcome under a hairline, after the lime arrow (problems.astro's
   * effect line). */
  .mb-step-outcome {
    display: flex;
    gap: 10px;
    padding-top: var(--v2-space-md);
    margin: var(--v2-space-md) 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    border-top: 1px solid var(--mb-hair);
  }

  .mb-step-arrow {
    flex-shrink: 0;
    color: var(--blue);
  }

  /* Under the rail, centred on it. */
  .mb-how-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--mb-block-gap);
  }

  /* Phone: the rail on the left, the cards one column, 40px apart. */
  @media (max-width: 880px) {
    .mb-how-steps {
      display: flex;
      flex-direction: column;
      row-gap: 0;
    }

    .mb-step {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }

    .mb-step > :global(*) {
      grid-row: 1;
    }

    .mb-step > :global(.mb-step-marker) {
      grid-column: 1;
    }

    /* The cards stand apart; their equal margins keep each mark on its
     * card's centre and the rail running through the space between. */
    .mb-step > :global(.mb-card),
    .mb-step:nth-child(even) > :global(.mb-card) {
      grid-column: 2;
      margin: 20px 0;
    }

    .mb-step-link {
      display: none;
    }

    .mb-how-cta {
      justify-content: flex-start;
      padding-left: calc(40px + 12px);
    }
  }
</style>
