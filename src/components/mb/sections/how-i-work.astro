---
import { processSteps } from "@/data/process";
import Badge from "../badge.astro";
import Button from "../button.astro";
import Card from "../card.astro";
import ProcessFigure from "../process-figure.astro";
import SectionHead from "../section-head.astro";
import StepMarker from "../step-marker.astro";

/* Process (#how), the page's signature: the route of a process sheet, its
 * steps on a rail of square numbered marks that fills lime as the page
 * scrolls (step-marker.astro). Each card opens on the step's detail
 * drawing (process-figure.astro, its lime layer drawn in as the rail comes
 * to it), then one line - the title on the left, the duration badge at the
 * right end - the description, and under a hairline the step's outcome
 * after the lime arrow, as the problems cells show their effect.
 *
 * Desktop: the rail runs down the middle and the steps alternate left and
 * right of it, staggered - one grid whose steps each span two rows, every
 * next step one row lower, so a card starts about halfway down the one
 * before it on the other side and no side is left empty. A short
 * horizontal connector joins each card to its mark at the mark's height:
 * 1px ink, 2px lime once the mark has filled.
 *
 * At 880px and below one column with the rail on the left, the cards
 * 40px apart, no connectors. Under the steps, the
 * button to the contact form. */
---

<section class="mb-how" id="how">
  <div class="container">
    <SectionHead poster>
      Od rozmowy do <em>działającego</em> systemu.
      <Fragment slot="lede">
        Pięć kroków. Na każdym wiesz, co robimy i co z niego dostajesz.
      </Fragment>
    </SectionHead>

    <ol class="mb-how-steps" style={`--mb-how-count: ${processSteps.length}`}>
      {processSteps.map((step, i) => (
        <li class="mb-step" style={`--mb-step: ${i + 1}`}>
          <StepMarker num={step.num} />
          <Card tag="div">
            <ProcessFigure name={step.figure} slot="image" />
            <div class="mb-step-head">
              <h3>{step.title}</h3>
              <Badge variant="outline">{step.badge}</Badge>
            </div>
            <p class="mb-step-desc">{step.description}</p>
            <p class="mb-step-outcome">
              <span aria-hidden="true" class="mb-step-arrow">
                →
              </span>
              {step.outcome}
            </p>
          </Card>
          <span aria-hidden="true" class="mb-step-link" />
        </li>
      ))}
    </ol>

    <div class="mb-how-cta">
      <Button href="#contact" iconEnd="lucide:arrow-right"
        >Umów bezpłatną rozmowę</Button
      >
    </div>
  </div>
</section>

<style>
  /* After the cases field: half a gap, the field pads the other half
   * (global.css, .mb-band). */
  .mb-how {
    --mb-how-rail: 80px;
    --mb-how-dot: 48px;
    margin-top: calc(var(--mb-section-gap) / 2);
  }

  /* Desktop: card | rail | card. A step takes rows n and n+1, the next
   * step n+1 and n+2, so the two sides overlap by a row; two cards on one
   * side stand a row gap apart. The gap (64px, a fifth of a card with its
   * drawing, about 330px) sets the stagger: a card starts a little past
   * the middle of the one before it, so the route reads as one zigzag,
   * neither side has a hole and the section stays short. A mark's row
   * starts about half a gap below the centre of the mark before it, so the
   * rail into it reaches that far up, under that mark (step-marker.astro). */
  .mb-how-steps {
    --mb-how-gap: 64px;
    --mb-step-reach: calc(var(--mb-how-gap) / 2);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--mb-how-rail) minmax(0, 1fr);
    row-gap: var(--mb-how-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-step {
    display: contents;
  }

  .mb-step > :global(*) {
    grid-row: var(--mb-step) / span 2;
  }

  .mb-step > :global(.mb-step-marker) {
    grid-column: 2;
  }

  .mb-step > :global(.mb-card) {
    grid-column: 1;
  }

  .mb-step:nth-child(even) > :global(.mb-card) {
    grid-column: 3;
  }

  /* The steps carry their numbers on the rail already. */
  .mb-step > :global(.mb-card::before) {
    content: none;
  }

  /* The connector: from the mark's edge to the card's, on the mark's
   * centre. A 2px box drawing a 1px ink line until the mark's fill passes
   * its middle, then a 2px lime one; filled from the start under reduced
   * motion or without view timelines, like the rail. */
  .mb-step-link {
    position: relative;
    grid-column: 2;
    align-self: center;
    justify-self: start;
    width: calc((var(--mb-how-rail) - var(--mb-how-dot)) / 2);
    height: 2px;
    pointer-events: none;
    background: var(--blue);
  }

  .mb-step:nth-child(even) > .mb-step-link {
    justify-self: end;
  }

  /* With motion the steps play in order, one part at a time, on one
   * timeline: the list's (--mb-how). Mark 01 fills, then drawing 01 draws
   * in, then the rail runs on to mark 02, which fills, then drawing 02,
   * and so on to drawing 05; scrolling back plays it backwards. The run
   * starts at --mb-how-from and ends at --mb-how-to (`cover` offsets of
   * the list: 100% - 100vh is its height) and is cut into consecutive
   * slots, a mark --mb-how-slot-mark long, a drawing --mb-how-slot-draw,
   * the rail between two marks --mb-how-slot-rail. A mark's slot comes
   * after the slots of the steps before it, so the order holds wherever
   * the cards stand; the run's ends, set from where the marks and the
   * drawings stand in the list, keep each part on screen while it plays
   * (a drawing whole, under the header), at 1440 and at 390px (home.spec.ts).
   *
   * Desktop: the run starts as mark 01 comes into the bottom tenth of the
   * viewport and ends with drawing 05 near the top, under the header; the
   * rail between two marks fills as one piece (the piece into the next
   * mark reaches up under this one and covers the piece out of it). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mb-how-steps {
        --mb-how-from: calc(7.5vh + (100% - 100vh) * 0.14);
        --mb-how-to: calc(97.5vh + (100% - 100vh) * 0.625);
        --mb-how-slot-mark: 0.2;
        --mb-how-slot-draw: 1;
        --mb-how-slot-rail: 0.15;
        --mb-how-split: 0;
        --mb-step-timeline: --mb-how;
        --mb-figure-timeline: --mb-how;
        view-timeline: --mb-how block;
        /* Not the scroll padding (html's, under the header): the offsets
         * count from the viewport's edges. */
        view-timeline-inset: 0;
      }

      /* One slot unit, where this step's run starts (its mark's slot), and
       * each part's range. The rail from this mark to the next: the piece
       * out of it, then the piece into the next one (split at
       * --mb-how-split; at 0 both take the whole slot). */
      .mb-step {
        --mb-how-unit: calc(
          (var(--mb-how-to) - var(--mb-how-from)) /
          (
            var(--mb-how-count) *
            (var(--mb-how-slot-mark) + var(--mb-how-slot-draw)) +
            (var(--mb-how-count) - 1) *
            var(--mb-how-slot-rail)
          )
        );
        --mb-how-at: calc(
          var(--mb-how-from) +
          var(--mb-how-unit) *
          (var(--mb-step) - 1) *
          (
            var(--mb-how-slot-mark) +
            var(--mb-how-slot-draw) +
            var(--mb-how-slot-rail)
          )
        );
        --mb-step-in-from: calc(
          var(--mb-how-at) -
          var(--mb-how-unit) *
          var(--mb-how-slot-rail) *
          (1 - var(--mb-how-split))
        );
        --mb-step-in-to: var(--mb-how-at);
        --mb-step-dot-from: var(--mb-how-at);
        --mb-step-dot-to: calc(
          var(--mb-how-at) +
          var(--mb-how-unit) *
          var(--mb-how-slot-mark)
        );
        --mb-figure-from: var(--mb-step-dot-to);
        --mb-figure-to: calc(
          var(--mb-step-dot-to) +
          var(--mb-how-unit) *
          var(--mb-how-slot-draw)
        );
        --mb-step-out-from: var(--mb-figure-to);
        --mb-step-out-to: calc(
          var(--mb-figure-to) +
          var(--mb-how-unit) *
          var(--mb-how-slot-rail) *
          (1 - var(--mb-how-split))
        );
      }

      .mb-step-link {
        animation: mb-step-link linear both;
        animation-range: cover
          calc(
            var(--mb-how-at) +
            var(--mb-how-unit) *
            var(--mb-how-slot-mark) /
            2
          )
          cover
          calc(
            var(--mb-how-at) +
            var(--mb-how-unit) *
            var(--mb-how-slot-mark) /
            2 +
            1px
          );
      }

      /* Its own rule: the build's minifier folds an animation-timeline
       * into the animation shorthand, where browsers drop it. */
      .mb-step > .mb-step-link {
        animation-timeline: --mb-how;
      }
    }
  }

  @keyframes mb-step-link {
    from {
      background-color: transparent;
      box-shadow: inset 0 1px 0 var(--mb-rule);
    }

    to {
      background-color: var(--blue);
      box-shadow: none;
    }
  }

  /* One line: title left, the duration at the right end. It never wraps
   * below: a long title wraps inside its own box, and the badge sits on
   * its first line (24px high). */
  .mb-step-head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .mb-step-head :global(.mb-badge) {
    margin-top: 1px;
    margin-left: auto;
  }

  .mb-step-head h3 {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-step-desc {
    max-width: 70ch;
    margin: 0;
  }

  /* The outcome under a hairline, after the lime arrow (problems.astro's
   * effect line). */
  .mb-step-outcome {
    display: flex;
    gap: 10px;
    padding-top: var(--v2-space-md);
    margin: var(--v2-space-md) 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    border-top: 1px solid var(--mb-hair);
  }

  .mb-step-arrow {
    flex-shrink: 0;
    color: var(--blue);
  }

  /* Under the rail, centred on it. */
  .mb-how-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--mb-block-gap);
  }

  /* Phone: the rail on the left, the cards one column, 40px apart. The
   * rows abut, so the rail into a mark starts at its row's top. */
  @media (max-width: 880px) {
    .mb-how-steps {
      --mb-step-reach: 0px;
      display: flex;
      flex-direction: column;
      row-gap: 0;
    }

    .mb-step {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }

    .mb-step > :global(*) {
      grid-row: 1;
    }

    .mb-step > :global(.mb-step-marker) {
      grid-column: 1;
    }

    /* The cards stand apart; their equal margins keep each mark on its
     * card's centre and the rail running through the space between. */
    .mb-step > :global(.mb-card),
    .mb-step:nth-child(even) > :global(.mb-card) {
      grid-column: 2;
      margin: 20px 0;
    }

    .mb-step-link {
      display: none;
    }

    .mb-how-cta {
      justify-content: flex-start;
      padding-left: calc(40px + 12px);
    }
  }

  /* Phone: the run starts as mark 01 comes into the bottom fifth of the
   * viewport and ends with drawing 05 near the top, under the header; the
   * cards stand farther apart, so the rail between two marks gets a longer
   * slot and fills out of one mark, then into the next. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 880px) {
    @supports (animation-timeline: view()) {
      .mb-how-steps {
        --mb-how-from: calc(20vh + (100% - 100vh) * 0.06);
        --mb-how-to: calc(75vh + (100% - 100vh) * 0.85);
        --mb-how-slot-rail: 0.5;
        --mb-how-split: 0.5;
      }
    }
  }
</style>
