---
import Button from "../button.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import SectionHead from "../section-head.astro";

/* Problems (#problems): the situations a visitor should recognise, as a
 * two-column cell table, then the closing line and the button to the
 * contact form. */
const problems = [
  "Twój zespół godzinami przepisuje dane między systemami.",
  "Odpowiadacie w kółko na te same maile i zapytania.",
  "Raporty składacie ręcznie z kilku Exceli.",
  "Wiesz, że AI mogłoby pomóc, ale nie wiesz, od czego zacząć.",
];
---

<section class="mb-problems" id="problems">
  <div class="container">
    <SectionHead label="Problem">
      Brzmi <em>znajomo</em>?
      <Fragment slot="lede">
        Jeśli rozpoznajesz swoją firmę choć w jednym punkcie, jesteś we
        właściwym miejscu.
      </Fragment>
    </SectionHead>

    <CellGrid columns={2} tag="ul">
      {problems.map((problem) => (
        <Card tag="li">
          <p class="mb-problem">{problem}</p>
        </Card>
      ))}
    </CellGrid>

    <div class="mb-problems-close">
      <p>To da się zautomatyzować. Zwykle szybciej i taniej, niż myślisz.</p>
      <Button href="#contact" iconEnd="lucide:arrow-right"
        >Umów bezpłatną rozmowę</Button
      >
    </div>
  </div>
</section>

<style>
  .mb-problems {
    margin-top: var(--mb-section-gap);
  }

  .mb-problem {
    margin: 0;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.3;
    color: var(--ink);
    letter-spacing: -0.025em;
  }

  .mb-problems-close {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v2-space-md);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--mb-block-gap);
  }

  .mb-problems-close p {
    max-width: 48ch;
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }

  @media (max-width: 880px) {
    .mb-problem {
      font-size: 18px;
    }
  }
</style>
