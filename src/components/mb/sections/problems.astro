---
import Button from "../button.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import SectionHead from "../section-head.astro";

/* Problems (#problems): the situations a visitor should recognise, six
 * equal cells of a ruled table across the container - three a row on the
 * desktop, two between 560px and 880px, one below - each a bold short
 * heading (h3) over one sentence. Every cell has the same padding above
 * and below and the rows are equally tall, so the table reads as an even
 * block under the head. Then the closing line and the button to the
 * contact form. */
const problems = [
  {
    text: "Zespół godzinami kopiuje te same dane między systemami.",
    title: "Przepisywanie danych",
  },
  {
    text: "Odpowiadacie w kółko na podobne maile i zapytania klientów.",
    title: "Te same pytania",
  },
  {
    text: "Co tydzień składacie raport z kilku Exceli.",
    title: "Ręczne raporty",
  },
  {
    text: "Ktoś ręcznie wypełnia i sprawdza dokumenty, faktury i umowy.",
    title: "Dokumenty i faktury",
  },
  {
    text: "Odpowiedzi znają tylko konkretne osoby, a reszta czeka na nie.",
    title: "Wiedza w głowach",
  },
  {
    text: "Wiesz, że AI mogłoby pomóc, ale nie wiesz, od czego zacząć.",
    title: "AI bez planu",
  },
];
---

<section class="mb-problems" id="problems">
  <div class="container">
    <SectionHead label="Problem">
      Brzmi <em>znajomo</em>?
      <Fragment slot="lede">
        Jeśli rozpoznajesz swoją firmę choć w jednym punkcie, jesteś we
        właściwym miejscu.
      </Fragment>
    </SectionHead>

    <CellGrid class="mb-problems-grid" columns={3} tag="ul">
      {problems.map((problem) => (
        <Card tag="li">
          <span slot="title">{problem.title}</span>
          <p class="mb-problem">{problem.text}</p>
        </Card>
      ))}
    </CellGrid>

    <div class="mb-problems-close">
      <p>To da się zautomatyzować. Zwykle szybciej i taniej, niż myślisz.</p>
      <Button href="#contact" iconEnd="lucide:arrow-right"
        >Umów bezpłatną rozmowę</Button
      >
    </div>
  </div>
</section>

<style>
  .mb-problems {
    margin-top: var(--mb-section-gap);
  }

  /* Equal rows at every width: every cell as tall as the tallest one. */
  .mb-problems :global(.mb-problems-grid) {
    grid-auto-rows: 1fr;
  }

  .mb-problem {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .mb-problems-close {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v2-space-md);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--mb-block-gap);
  }

  .mb-problems-close p {
    max-width: 48ch;
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }

  /* Stacked like the hero's: the button takes the full width. */
  @media (max-width: 880px) {
    .mb-problems :global(.mb-problems-close .mb-btn) {
      width: 100%;
    }
  }

  @media (min-width: 560px) and (max-width: 880px) {
    .mb-problems :global(.mb-problems-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
