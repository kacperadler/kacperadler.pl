---
import { automations } from "@/data/home";
import Badge from "../badge.astro";
import Button from "../button.astro";
import Card from "../card.astro";
import CellGrid from "../cell-grid.astro";
import SectionHead from "../section-head.astro";

/* Examples (#examples): what can be automated, as a two-column cell table
 * (one column at 880px and below, the odd last cell spans the row). The
 * index is a mono figure that turns blue with its cell; the technologies
 * are tags in the footer, never in a heading. */
---

<section class="mb-examples" id="examples">
  <div class="container">
    <SectionHead label="Możliwości">
      Co mogę <em>zautomatyzować</em> w&nbsp;Twojej firmie.
      <Fragment slot="lede">
        Kilka przykładów. Każde wdrożenie dopasowuję do tego, jak już
        pracujecie.
      </Fragment>
    </SectionHead>

    <CellGrid columns={2}>
      {automations.map((example, idx) => (
        <Card>
          <span slot="title">{example.title}</span>
          <span aria-hidden="true" class="mb-example-num" slot="action">
            {String(idx + 1).padStart(2, "0")}
          </span>
          <p class="mb-example-desc">{example.description}</p>
          <ul class="mb-example-tags" slot="footer">
            {example.tags.map((tag) => (
              <li>
                <Badge variant="tag">{tag}</Badge>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </CellGrid>

    <div class="mb-examples-cta">
      <Button href="#contact" iconEnd="lucide:arrow-right" variant="outline"
        >Opowiedz mi o swoim procesie</Button
      >
    </div>
  </div>
</section>

<style>
  .mb-examples {
    margin-top: var(--v2-space-2xl);
  }

  .mb-example-num {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    transition: color var(--mb-snap);
  }

  :global(.mb-card:is(:hover, [data-state="hover"])) .mb-example-num {
    color: var(--blue);
  }

  /* The prose measure: the lone last cell spans the row, and its text
   * should not run twice as long a line as the others'. */
  .mb-example-desc {
    max-width: 65ch;
    margin: 0;
  }

  .mb-example-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-examples-cta {
    display: flex;
    margin-top: var(--v2-space-lg);
  }

  @media (max-width: 880px) {
    .mb-examples {
      margin-top: var(--v2-space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-example-num {
      transition: none;
    }
  }
</style>
