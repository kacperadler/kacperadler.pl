---
import { faq } from "@/data/home";
import Accordion from "../accordion.astro";
import AccordionItem from "../accordion-item.astro";
import CellGrid from "../cell-grid.astro";
import Link from "../link.astro";
import SectionHead from "../section-head.astro";

/* FAQ (#faq): the questions in two bordered accordions side by side, one
 * ruled table across the container (one column at 880px and below, the
 * second accordion under the first); every question opens on its own and
 * grows only its own column. The first half of the list fills the left
 * column, so it reads in order in both layouts. The answers are in the
 * HTML while closed (native <details>), so they read without JavaScript. */
const half = Math.ceil(faq.length / 2);
const columns = [faq.slice(0, half), faq.slice(half)];
---

<section class="mb-faq" id="faq">
  <div class="container">
    <SectionHead label="FAQ">
      Najczęstsze <em>pytania</em>.
      <Fragment slot="lede">
        Nie ma tu Twojego? Zapytaj w
        <Link href="#contact" variant="inline">formularzu</Link>, odpowiem w
        24h.
      </Fragment>
    </SectionHead>

    <CellGrid columns={2}>
      {columns.map((items) => (
        <Accordion bordered type="multiple">
          {items.map((item) => (
            <AccordionItem title={item.question}>
              <p>{item.answer}</p>
            </AccordionItem>
          ))}
        </Accordion>
      ))}
    </CellGrid>
  </div>
</section>

<style>
  .mb-faq {
    margin-top: var(--v2-space-2xl);
  }

  @media (max-width: 880px) {
    .mb-faq {
      margin-top: var(--v2-space-xl);
    }

    /* Stacked, the halves read as one list: the rule they share is the
     * hairline between its items, not the frame's ink (drawn once, by the
     * first half). */
    .mb-faq :global(.mb-accordion:first-child) {
      border-bottom-color: var(--mb-hair);
    }

    .mb-faq :global(.mb-accordion + .mb-accordion) {
      border-top-color: transparent;
    }
  }
</style>
