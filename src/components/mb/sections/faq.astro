---
import { faq } from "@/data/home";
import Accordion from "../accordion.astro";
import AccordionItem from "../accordion-item.astro";
import SectionHead from "../section-head.astro";

/* FAQ (#faq): one bordered accordion, every question its own item that
 * opens on its own. The answers are in the HTML while closed (native
 * <details>), so they read without JavaScript. */
---

<section class="mb-faq" id="faq">
  <div class="container">
    <SectionHead label="FAQ"> Najczęstsze <em>pytania</em>. </SectionHead>

    <div class="mb-faq-list">
      <Accordion bordered type="multiple">
        {faq.map((item) => (
          <AccordionItem title={item.question}>
            <p>{item.answer}</p>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
  </div>
</section>

<style>
  .mb-faq {
    margin-top: var(--v2-space-2xl);
  }

  .mb-faq-list {
    max-width: 820px;
  }

  @media (max-width: 880px) {
    .mb-faq {
      margin-top: var(--v2-space-xl);
    }
  }
</style>
