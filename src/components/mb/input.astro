---
import type { HTMLAttributes } from "astro/types";

/* Input: a muted frame on the substrate.
 *   hover     the ink-2 frame
 *   focus     the ink frame and the hard blue shadow shifting out from
 *             under it (you are typing here)
 *   invalid   a coral frame, from [data-invalid] on the enclosing <Field>
 *             (scripts/contact-form.ts sets it) or aria-invalid="true"; focus
 *             on an invalid input keeps the coral frame and adds the shadow
 *   disabled  the flat panel in a hairline, muted text
 *   file      the picker button as a raised mono cell inside the frame
 * Native input attributes pass through. [data-state="hover"] and
 * [data-state="focus"] force those looks on the catalogue page (/ui). */
type Props = HTMLAttributes<"input">;

const { class: extraClass, ...rest } = Astro.props;
---

<input class:list={["mb-input", extraClass]} {...rest}>

<style>
  .mb-input {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink);
    outline: none;
    background: var(--v2-bg);
    border: 1px solid var(--muted);
    border-radius: 0;
    transition:
      border-color var(--mb-snap),
      box-shadow var(--mb-snap);
  }

  .mb-input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .mb-input:is(:hover, [data-state="hover"]) {
    border-color: var(--ink-2);
  }

  .mb-input:is(:focus, [data-state="focus"]) {
    border-color: var(--ink);
    box-shadow: var(--mb-shift) var(--mb-shift) 0 var(--blue);
  }

  .mb-input[aria-invalid="true"],
  :global([data-invalid]) .mb-input {
    border-color: var(--error);
  }

  .mb-input:disabled {
    color: var(--muted);
    cursor: not-allowed;
    background: var(--v2-panel);
    border-color: var(--mb-hair);
    box-shadow: none;
  }

  .mb-input[type="file"] {
    padding: 0 14px 0 0;
    line-height: 42px;
    color: var(--ink-2);
    cursor: pointer;
  }

  .mb-input::file-selector-button {
    height: 42px;
    padding: 0 14px;
    margin: 0 14px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    background: var(--v2-panel-elevated);
    border: 0;
    border-right: 1px solid var(--muted);
  }

  .mb-input:disabled::file-selector-button {
    color: var(--muted);
    cursor: not-allowed;
    background: var(--v2-panel);
    border-right-color: var(--mb-hair);
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-input {
      transition: none;
    }
  }
</style>
