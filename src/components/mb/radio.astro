---
import type { HTMLAttributes } from "astro/types";

/* Radio: a native input (appearance: none) drawn as an 18px circle in a
 * muted frame, the label beside it; hover: the ink frame; checked: a blue
 * dot inset in the frame. The one round shape on the site: a radio reads
 * as one. (A square chip that can be chosen is <Choice>, a checkbox.)
 * Disabled: the flat panel, muted text. Invalid: a coral frame, from
 * [data-invalid] on the enclosing <Field> or aria-invalid on the input.
 * Native input attributes (name / value / checked / disabled) pass
 * through.
 *
 * `state` forces a look on the catalogue page (/ui): "hover" on the label,
 * "focus-visible" on the input. */
interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label: string;
  state?: "hover" | "focus-visible";
}

const { label, state, class: extraClass, ...rest } = Astro.props;
---

<label
  data-state={state === "focus-visible" ? undefined : state}
  class:list={["mb-radio", extraClass]}
>
  <input
    class="mb-radio-input"
    data-state={state === "focus-visible" ? state : undefined}
    type="radio"
    {...rest}
  >
  <span class="mb-radio-label">{label}</span>
</label>

<style>
  .mb-radio {
    position: relative;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
    cursor: pointer;
  }

  .mb-radio:has(:disabled) {
    cursor: not-allowed;
  }

  .mb-radio .mb-radio-input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 0;
    appearance: none;
    cursor: inherit;
    background: var(--v2-bg);
    border: 1px solid var(--muted);
    border-radius: 50%;
    transition:
      background-color var(--mb-snap),
      border-color var(--mb-snap),
      box-shadow var(--mb-snap);
  }

  .mb-radio[data-state="hover"] .mb-radio-input {
    border-color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-radio:hover .mb-radio-input {
      border-color: var(--ink);
    }
  }

  .mb-radio .mb-radio-input:checked {
    background: var(--blue);
    border-color: var(--blue);
    box-shadow: inset 0 0 0 3px var(--v2-bg);
  }

  .mb-radio .mb-radio-input[aria-invalid="true"],
  :global([data-invalid]) .mb-radio .mb-radio-input {
    border-color: var(--error);
  }

  .mb-radio .mb-radio-input:disabled {
    background: var(--v2-panel);
    border-color: var(--mb-hair);
  }

  .mb-radio .mb-radio-input:checked:disabled {
    background: var(--muted);
    box-shadow: inset 0 0 0 3px var(--v2-panel);
  }

  .mb-radio:has(:disabled) .mb-radio-label {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-radio-input {
      transition: none;
    }
  }
</style>
