---
import type { ProcessFigureName } from "@/data/process";

/* Process figure: a process step's detail drawing (how-i-work.astro, in the
 * card's "image" slot), drawn for this site from drafting marks. Two
 * stacked <svg> on one viewBox: the 1px ink drawing, which stands drawn,
 * and over it the 2px lime layer that marks what the step produces:
 *   - conversation: today's process as three boxes, two questions on
 *     leaders; lime, the dimension brace under the middle box and its
 *     callout (what to automate).
 *   - plan: a sheet with its title block and a schedule of four bars;
 *     lime, the dimension chain over the bars (order and total).
 *   - stages: an exploded stack of four modules on a centre line; lime,
 *     the first two filled (delivered).
 *   - revision: a stepped part on a centre line; lime, a revision cloud
 *     round one step and the revision triangle (the cloud's arcs are the
 *     figure's one curve).
 *   - care: a trace on a grid between two dashed tolerance lines; lime,
 *     the trace, inside the band, ending in a square mark.
 * Strokes do not scale (vector-effect), so a line stays 1px or 2px at any
 * width; the fixed viewBox keeps the height from the width, up to 80px (a
 * wider card centres the drawing at that height), so nothing shifts on
 * load and a card stays short. Decorative: the step's title and text
 * carry the meaning.
 *
 * The lime layer is drawn in left to right as the page scrolls past the
 * drawing: a clip-path on its own view timeline, over the rail segment's
 * range (the box's top on the viewport's middle line to its bottom there),
 * so it is drawn before the step's mark turns lime (step-marker.astro).
 * Under prefers-reduced-motion, without view timelines or without CSS
 * animations it stands drawn. */
interface Props {
  name: ProcessFigureName;
}

const { name } = Astro.props;
const cloudTop = "a5.5 5.5 0 0 1 11 0".repeat(10);
const cloudRight = "a5.5 5.5 0 0 1 0 11".repeat(4);
const cloudBottom = "a5.5 5.5 0 0 1 -11 0".repeat(10);
const cloudLeft = "a5.5 5.5 0 0 1 0 -11".repeat(4);
const grid = [60, 100, 140, 180, 220, 260, 300, 340];
---

<div aria-hidden="true" class="mb-figure" data-figure={name}>
  <svg aria-hidden="true" class="mb-figure-ink" viewBox="0 0 400 120">
    {name === "conversation" && (
      <>
        <rect height="36" width="70" x="40" y="44" />
        <rect height="36" width="70" x="165" y="44" />
        <rect height="36" width="70" x="290" y="44" />
        <path d="M110 62h55M157 58l8 4-8 4M235 62h55M282 58l8 4-8 4" />
        <path d="M96 44l22-24h12M304 44l-22-24h-12" />
        <rect height="12" width="12" x="130" y="14" />
        <rect height="12" width="12" x="258" y="14" />
      </>
    )}
    {name === "plan" && (
      <>
        <rect height="104" width="280" x="60" y="8" />
        <path d="M260 84h80M260 98h80M300 84v14" />
        <rect height="8" width="50" x="80" y="34" />
        <rect height="8" width="80" x="130" y="46" />
        <rect height="8" width="50" x="210" y="58" />
        <rect height="8" width="60" x="260" y="70" />
      </>
    )}
    {name === "stages" && (
      <>
        <path class="mb-figure-axis" d="M200 2v116" />
        <rect height="18" width="160" x="120" y="10" />
        <rect height="18" width="160" x="120" y="37" />
        <rect height="18" width="160" x="120" y="64" />
        <rect height="18" width="160" x="120" y="91" />
        <path d="M300 19h24M300 100h24M312 19v81M308 27l4-8 4 8M308 92l4 8 4-8" />
      </>
    )}
    {name === "revision" && (
      <>
        <path class="mb-figure-axis" d="M24 98h352" />
        <path d="M40 98V74h90V54h90V36h100v62" />
        <path d="M40 108v6M320 108v6M40 111h280" />
      </>
    )}
    {name === "care" && (
      <>
        <g class="mb-figure-grid">
          {grid.map((x) => (
            <path d={`M${x} 16v88`} />
          ))}
          <path d="M40 16h320M40 40h320M40 60h320M40 80h320M40 104h320" />
        </g>
        <path class="mb-figure-band" d="M40 40h320M40 80h320" />
        <path d="M40 16v88h320" />
      </>
    )}
  </svg>
  <svg aria-hidden="true" class="mb-figure-lime" viewBox="0 0 400 120">
    {name === "conversation" && (
      <>
        <path d="M165 86v8h70v-8" />
        <rect class="mb-figure-fill" height="10" width="10" x="243" y="96" />
      </>
    )}
    {name === "plan" && (
      <path d="M80 22h240M80 16v12M130 16v12M210 16v12M260 16v12M320 16v12" />
    )}
    {name === "stages" && (
      <>
        <rect class="mb-figure-fill" height="18" width="160" x="120" y="64" />
        <rect class="mb-figure-fill" height="18" width="160" x="120" y="91" />
      </>
    )}
    {name === "revision" && (
      <>
        <path
          d={`M205 26${cloudTop}${cloudRight}${cloudBottom}${cloudLeft}z`}
        />
        <path d="M340 12l12 20h-24z" />
      </>
    )}
    {name === "care" && (
      <>
        <path d="M40 62l30-4 30 8 30-12 30 6 30 10 30-14 30 6 30-10 30 12 26-4" />
        <rect class="mb-figure-fill" height="8" width="8" x="352" y="56" />
      </>
    )}
  </svg>
</div>

<style>
  .mb-figure {
    display: grid;
    padding: var(--v2-space-md) var(--mb-card-pad, var(--v2-space-lg));
  }

  .mb-figure svg {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    max-height: 80px;
    overflow: visible;
    fill: none;
    stroke-linecap: square;
  }

  .mb-figure :global(:is(path, rect)) {
    vector-effect: non-scaling-stroke;
  }

  .mb-figure-ink {
    stroke: var(--mb-rule);
    stroke-width: 1;
  }

  .mb-figure-lime {
    stroke: var(--blue);
    stroke-width: 2;
  }

  .mb-figure-lime .mb-figure-fill {
    fill: var(--blue);
  }

  /* A centre line, dash-dot like the rail. */
  .mb-figure-axis {
    stroke-dasharray: 9 3 1 3;
  }

  .mb-figure-grid {
    stroke: var(--mb-hair);
  }

  .mb-figure-band {
    stroke-dasharray: 4 4;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mb-figure-lime {
        animation: mb-figure-draw linear both;
        animation-range: cover 50vh cover calc(100% - 50vh);
      }

      /* Its own rule, a step more specific: the build's minifier folds an
       * animation-timeline into the animation shorthand, where browsers
       * drop it. */
      .mb-figure > .mb-figure-lime {
        animation-timeline: view();
      }
    }
  }

  @keyframes mb-figure-draw {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }
</style>
