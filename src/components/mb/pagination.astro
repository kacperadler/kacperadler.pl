---
import { Icon } from "astro-icon/components";
import Button from "./button.astro";

/* Pagination: nav[aria-label="Paginacja"] with plain links (no JavaScript).
 *   - pages: the first, the last, and the current one with its neighbours;
 *     a gap of more than one page becomes an ellipsis;
 *   - the current page is the outline cell (aria-current="page"), the rest
 *     ghost cells; a press sinks a cell into the panel;
 *   - variant "numbers": "Poprzednia" / "Następna" with their chevrons;
 *     "icons": the chevrons alone, named for assistive tech;
 *   - on the first (last) page the previous (next) cell is inert text.
 * `href(page)` builds each link. The row wraps instead of scrolling.
 *
 * `jump` adds "go to page": a GET form (no JavaScript) with a number field
 * (1 to `total`, the browser refuses anything else) and an "Idź" button. It
 * sends `<jump>?strona=<n>`. On the static build `jump` is the list's first
 * page (`/blog/`) and `href` builds Astro's paginate() paths (`/blog/`,
 * `/blog/<n>/`): nginx.conf redirects `<list>/?strona=<n>` to the path page,
 * since a prerendered page never sees its query, for the lists it names
 * (/blog/, /realizacje/) - a new paginated list goes into its map. A page
 * rendered on request (the dev-only catalogue) reads `strona` itself. */
interface Props {
  current: number;
  href: (page: number) => string;
  jump?: string;
  total: number;
  variant?: "numbers" | "icons";
}

const { current, href, jump, total, variant = "numbers" } = Astro.props;

const shown = [
  ...new Set(
    [1, current - 1, current, current + 1, total].filter(
      (page) => page >= 1 && page <= total
    )
  ),
].sort((a, b) => a - b);

type Cell = { kind: "page"; page: number } | { kind: "gap"; key: string };
const cells: Cell[] = [];
for (const page of shown) {
  const previous = cells.at(-1);
  if (previous?.kind === "page" && page - previous.page === 2) {
    cells.push({ kind: "page", page: page - 1 });
  } else if (previous?.kind === "page" && page - previous.page > 2) {
    cells.push({ key: `gap-${page}`, kind: "gap" });
  }
  cells.push({ kind: "page", page });
}

const icons = variant === "icons";
const ends = [
  {
    href: current > 1 ? href(current - 1) : undefined,
    icon: "lucide:chevron-left",
    label: "Poprzednia",
    srLabel: "Poprzednia strona",
  },
  {
    href: current < total ? href(current + 1) : undefined,
    icon: "lucide:chevron-right",
    label: "Następna",
    srLabel: "Następna strona",
  },
] as const;
const [previousEnd, nextEnd] = ends;
---

<nav aria-label="Paginacja" class="mb-pagination">
  <ul>
    <li>
      {previousEnd.href ? (
        <a
          aria-label={icons ? previousEnd.srLabel : undefined}
          class="mb-page mb-page-end"
          href={previousEnd.href}
        >
          <Icon aria-hidden="true" name={previousEnd.icon} />
          {!icons && previousEnd.label}
        </a>
      ) : (
        <span aria-disabled="true" class="mb-page mb-page-end mb-page-inert">
          <Icon aria-hidden="true" name={previousEnd.icon} />
          {icons ? (
            <span class="sr-only">{previousEnd.srLabel}</span>
          ) : (
            previousEnd.label
          )}
        </span>
      )}
    </li>
    {cells.map((cell) =>
      cell.kind === "gap" ? (
        <li aria-hidden="true" class="mb-page mb-page-gap">
          <Icon name="lucide:ellipsis" />
        </li>
      ) : (
        <li>
          <a
            aria-current={cell.page === current ? "page" : undefined}
            aria-label={`Strona ${cell.page}`}
            class:list={[
              "mb-page",
              { "mb-page-current": cell.page === current },
            ]}
            href={href(cell.page)}
          >
            {cell.page}
          </a>
        </li>
      )
    )}
    <li>
      {nextEnd.href ? (
        <a
          aria-label={icons ? nextEnd.srLabel : undefined}
          class="mb-page mb-page-end"
          href={nextEnd.href}
        >
          {!icons && nextEnd.label}
          <Icon aria-hidden="true" name={nextEnd.icon} />
        </a>
      ) : (
        <span aria-disabled="true" class="mb-page mb-page-end mb-page-inert">
          {icons ? (
            <span class="sr-only">{nextEnd.srLabel}</span>
          ) : (
            nextEnd.label
          )}
          <Icon aria-hidden="true" name={nextEnd.icon} />
        </span>
      )}
    </li>
  </ul>
  {jump && (
    <form action={jump} class="mb-page-jump" method="get">
      <label class="mb-page-jump-label">
        Strona
        <input
          class="mb-page-jump-input"
          inputmode="numeric"
          max={total}
          min="1"
          name="strona"
          required
          type="number"
        >
      </label>
      <Button
        iconEnd="lucide:arrow-right"
        size="sm"
        type="submit"
        variant="outline"
      >
        Idź
      </Button>
    </form>
  )}
</nav>

<style>
  .mb-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .mb-pagination ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mb-page {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    border: 1px solid transparent;
    transition:
      background-color var(--mb-snap),
      border-color var(--mb-snap),
      color var(--mb-snap),
      outline-offset var(--mb-snap);
  }

  /* The focus ring (global.css) grows out of the edge instead of popping. */
  :where(.mb-page) {
    outline-offset: 0;
  }

  .mb-page :global(svg) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .mb-page-end {
    font-family: var(--mb-display);
    font-size: 14px;
    letter-spacing: -0.015em;
  }

  a.mb-page[data-state="hover"] {
    color: var(--ink);
    background: var(--v2-panel-elevated);
  }

  @media (hover: hover) and (pointer: fine) {
    a.mb-page:hover {
      color: var(--ink);
      background: var(--v2-panel-elevated);
    }
  }

  a.mb-page:is(:active, [data-state="pressed"]) {
    color: var(--ink);
    background: var(--v2-panel);
    border-color: var(--mb-hair);
  }

  .mb-page-current {
    color: var(--ink);
    border-color: var(--mb-rule);
  }

  .mb-page-inert,
  .mb-page-gap {
    color: var(--muted);
  }

  .mb-page-inert {
    cursor: not-allowed;
  }

  .mb-page-jump {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .mb-page-jump-label {
    display: flex;
    gap: 8px;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mb-page-jump-input {
    width: 64px;
    height: 36px;
    padding: 0 8px;
    font-family: var(--mono);
    font-size: max(16px, 1rem);
    font-weight: 600;
    color: var(--ink);
    background: var(--v2-bg);
    border: 1px solid var(--muted);
    border-radius: 0;
    transition:
      border-color var(--mb-snap),
      box-shadow var(--mb-snap);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-page-jump-input:hover {
      border-color: var(--ink-2);
    }
  }

  /* Forced colors paint the transparent outline in place of the shadow. */
  .mb-page-jump-input:focus {
    outline: 2px solid transparent;
    border-color: var(--ink);
    box-shadow: 3px 3px 0 var(--blue);
  }

  .mb-page-jump-input:user-invalid {
    border-color: var(--error);
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-page,
    .mb-page-jump-input {
      transition: none;
    }
  }
</style>
