---
import { Icon } from "astro-icon/components";

/* Badge: a square mono chip, with shadcn/ui's variants and two of its own.
 *   default      a solid blue block (current role, "Zlecenie")
 *   secondary    the raised panel in a hairline
 *   outline      a muted frame (year range, step duration)
 *   destructive  a coral block
 *   ghost        no frame
 *   link         ink text over a blue underline
 *   tag          a technology on a service card or a case study: the muted
 *                frame in its own case (not caps), so a row of tags reads
 *                apart from the caps badges
 *   status       availability (hero status card, mobile sheet): ink text in
 *                a blue frame behind a square blue dot
 * `iconStart` / `iconEnd` take an Iconify name; a <Spinner decorative /> in
 * the slot shows work in progress. `href` renders an <a>: hover as the
 * button it stands for, press (or [data-state="pressed"]) an ink block, and
 * the focus ring snaps out from the edge.
 * `fillOnCellHover` paints an outline badge as the default one while its
 * <Card> is hovered (process steps); the catalogue forces that hover with
 * [data-state="hover"] on the card. */
interface Props {
  class?: string;
  fillOnCellHover?: boolean;
  href?: string;
  iconEnd?: string;
  iconStart?: string;
  variant?:
    | "default"
    | "secondary"
    | "outline"
    | "destructive"
    | "ghost"
    | "link"
    | "tag"
    | "status";
  [attribute: `data-${string}`]: unknown;
}

const {
  variant = "default",
  fillOnCellHover = false,
  href,
  iconStart,
  iconEnd,
  class: extraClass,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  class:list={[
    "mb-badge",
    `mb-badge-${variant}`,
    { "mb-badge-fill-on-hover": fillOnCellHover },
    extraClass,
  ]}
  {...rest}
>
  {iconStart && <Icon aria-hidden="true" name={iconStart} />}
  <slot />
  {iconEnd && <Icon aria-hidden="true" name={iconEnd} />}
</Tag>

<style>
  .mb-badge {
    display: inline-flex;
    flex-shrink: 0;
    gap: 4px;
    align-items: center;
    padding: 3px 8px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color var(--mb-snap),
      border-color var(--mb-snap),
      color var(--mb-snap);
  }

  /* The focus ring (global.css) grows out of the edge instead of popping. */
  :where(.mb-badge) {
    outline-offset: 0;
  }

  .mb-badge :global(svg) {
    width: 12px;
    height: 12px;
  }

  .mb-badge-default,
  :global(.mb-card[data-state="hover"]) .mb-badge-fill-on-hover {
    color: var(--v2-bg);
    background: var(--blue);
    border-color: var(--blue);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.mb-card:hover) .mb-badge-fill-on-hover {
      color: var(--v2-bg);
      background: var(--blue);
      border-color: var(--blue);
    }
  }

  .mb-badge-secondary {
    background: var(--v2-panel-elevated);
    border-color: var(--mb-hair);
  }

  .mb-badge-outline {
    border-color: var(--muted);
  }

  .mb-badge-destructive {
    color: var(--v2-bg);
    background: var(--error);
    border-color: var(--error);
  }

  .mb-badge-link {
    padding-inline: 0;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--blue);
    text-underline-offset: 3px;
  }

  .mb-badge-tag {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
    border-color: var(--muted);
  }

  .mb-badge-status {
    gap: 8px;
    align-self: flex-start;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
    border-color: var(--blue);
  }

  .mb-badge-status::before {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    content: "";
    background: var(--blue);
  }

  /* As a link: the same switch as the button it stands for. */
  a.mb-badge-default[data-state="hover"] {
    background: var(--blue-2);
    border-color: var(--blue-2);
  }

  a.mb-badge-destructive[data-state="hover"] {
    background: color-mix(in srgb, var(--error) 80%, var(--ink));
  }

  a:is(
    .mb-badge-secondary,
    .mb-badge-outline,
    .mb-badge-tag,
    .mb-badge-status
  )[data-state="hover"] {
    color: var(--ink);
    border-color: var(--mb-rule);
  }

  a.mb-badge-ghost[data-state="hover"] {
    color: var(--ink);
    background: var(--v2-panel-elevated);
  }

  a.mb-badge-link[data-state="hover"] {
    color: var(--blue);
  }

  @media (hover: hover) and (pointer: fine) {
    a.mb-badge-default:hover {
      background: var(--blue-2);
      border-color: var(--blue-2);
    }

    a.mb-badge-destructive:hover {
      background: color-mix(in srgb, var(--error) 80%, var(--ink));
    }

    a:is(
      .mb-badge-secondary,
      .mb-badge-outline,
      .mb-badge-tag,
      .mb-badge-status
    ):hover {
      color: var(--ink);
      border-color: var(--mb-rule);
    }

    a.mb-badge-ghost:hover {
      color: var(--ink);
      background: var(--v2-panel-elevated);
    }

    a.mb-badge-link:hover {
      color: var(--blue);
    }
  }

  /* Pressed: the inverted ink block, as the button at its target. */
  a.mb-badge:is(:active, [data-state="pressed"]) {
    color: var(--v2-bg);
    background: var(--ink);
    border-color: var(--ink);
  }

  a.mb-badge-link:is(:active, [data-state="pressed"]) {
    color: var(--blue-2);
    background: transparent;
    border-color: transparent;
  }

  /* The ring grows out of the edge; without motion it shows at once. */
  @media (prefers-reduced-motion: no-preference) {
    .mb-badge {
      transition:
        background-color var(--mb-snap),
        border-color var(--mb-snap),
        color var(--mb-snap),
        outline-offset var(--mb-snap);
    }
  }
</style>
