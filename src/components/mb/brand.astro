---
import { siteConfig } from "@/data/site-config";

/* The brand: a square lime "k" mark beside "Kacper Adler" in heavy Geist,
 * linking to the top of the home page. `size` "sm" sits in the header,
 * "lg" in the footer. Hover, in the buttons' voice: a hard ink layer
 * slides out from under the mark and "Adler" brightens from ink-2 to ink.
 * Only the layer moves (under prefers-reduced-motion it is there at
 * once); [data-state="hover"] forces the state on the catalogue (/ui). */
interface Props {
  "data-state"?: "hover";
  size?: "sm" | "lg";
}

const { "data-state": state, size = "sm" } = Astro.props;
---

<a
  aria-label={`${siteConfig.name} - Strona główna`}
  data-state={state}
  href="/#top"
  class:list={["mb-brand", `mb-brand-${size}`]}
>
  <span aria-hidden="true" class="mb-mark">k</span>
  <span><b>Kacper</b> <em>Adler</em></span>
</a>

<style>
  .mb-brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-family: var(--mb-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .mb-brand-lg {
    font-size: 20px;
  }

  .mb-mark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-size: 16px;
    font-weight: 800;
    color: var(--v2-bg);
    background: var(--blue);
    border: 1px solid var(--mb-rule);
  }

  .mb-brand b {
    font-weight: 800;
  }

  .mb-brand em {
    font-style: normal;
    font-weight: 500;
    color: var(--ink-2);
    transition: color var(--mb-snap);
  }

  .mb-brand[data-state="hover"] .mb-mark {
    box-shadow: var(--mb-shift) var(--mb-shift) 0 var(--mb-rule);
  }

  .mb-brand[data-state="hover"] em {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-brand:hover .mb-mark {
      box-shadow: var(--mb-shift) var(--mb-shift) 0 var(--mb-rule);
    }

    .mb-brand:hover em {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mb-mark {
      transition: box-shadow var(--mb-snap);
    }
  }
</style>
