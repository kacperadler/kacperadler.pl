---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

/* Text link in four looks:
 *   inline  ink text over a 2px blue underline; hover: blue text, the
 *           underline thickens to 3px; press: blue-2 text
 *   nav     header navigation in Geist; an ink bar draws in under it from
 *           the left on hover; `.active` (scripts/nav-active.ts on
 *           [data-nav-link]) is a blue bar under blue text; press: the
 *           blue bar and text it is about to become
 *   footer  ink-2 list link, an underline fades in on hover; the optional
 *           icon before it turns blue; press: blue text
 *   case    "Zobacz realizację": heavy ink text over a blue underline, the
 *           icon after it (an arrow by default) nudges 3px right on hover
 *           and 6px on press
 * `icon` takes an Iconify name. The label is trimmed and touches the tags:
 * whitespace inside the <a> would be underlined and outlined. The focus
 * ring (global.css) grows out of the edge instead of popping.
 *
 * The catalogue (/ui) forces states with [data-state="hover"],
 * [data-state="pressed"] and [data-state="focus-visible"] (the ring itself
 * comes from global.css). */
interface Props extends HTMLAttributes<"a"> {
  href: string;
  icon?: string;
  variant: "inline" | "nav" | "footer" | "case";
}

const {
  href,
  variant,
  icon: iconName,
  class: extraClass,
  ...rest
} = Astro.props;
const icon =
  iconName ?? (variant === "case" ? "lucide:arrow-right" : undefined);
const label = (await Astro.slots.render("default")).trim();
const iconAfter = variant === "case";
---

<a
  href={href}
  class:list={["mb-link", `mb-link-${variant}`, extraClass]}
  {...rest}
  >{icon && !iconAfter && <Icon aria-hidden="true" name={icon} />}<Fragment
    set:html={label}
  />{icon && iconAfter && <Icon aria-hidden="true" name={icon} />}</a
>

<style>
  :where(.mb-link) {
    outline-offset: 0;
  }

  .mb-link-inline {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--blue);
    text-underline-offset: 4px;
    transition: color var(--mb-snap);
  }

  .mb-link-inline[data-state="hover"] {
    color: var(--blue);
    text-decoration-thickness: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-link-inline:hover {
      color: var(--blue);
      text-decoration-thickness: 3px;
    }
  }

  .mb-link-inline:is(:active, [data-state="pressed"]) {
    color: var(--blue-2);
    text-decoration-thickness: 3px;
  }

  .mb-link-nav {
    position: relative;
    display: inline-block;
    padding: 10px 12px;
    font-family: var(--mb-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: -0.015em;
    transition: color var(--mb-snap);
  }

  .mb-link-nav::after {
    position: absolute;
    right: 12px;
    bottom: 0;
    left: 12px;
    height: 2px;
    content: "";
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: background-color var(--mb-snap);
  }

  .mb-link-nav[data-state="hover"] {
    color: var(--ink);
  }

  .mb-link-nav:is(.active, [data-state="hover"])::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-link-nav:hover {
      color: var(--ink);
    }

    .mb-link-nav:hover::after {
      transform: scaleX(1);
    }
  }

  .mb-link-nav.active {
    color: var(--blue);
  }

  .mb-link-nav.active::after {
    background: var(--blue);
  }

  .mb-link-nav:is(:active, [data-state="pressed"]) {
    color: var(--blue);
  }

  .mb-link-nav:is(:active, [data-state="pressed"])::after {
    background: var(--blue);
    transform: scaleX(1);
  }

  .mb-link-case {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-family: var(--mb-display);
    font-size: 14px;
    font-weight: 650;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--blue);
    text-underline-offset: 4px;
    transition: color var(--mb-snap);
  }

  .mb-link-case:is(:active, [data-state="pressed"]) {
    color: var(--blue-2);
  }

  .mb-link-case :global(svg) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--blue);
  }

  .mb-link-footer {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--mb-snap),
      text-decoration-color var(--mb-snap);
  }

  .mb-link-footer :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--muted);
    transition: color var(--mb-snap);
  }

  .mb-link-footer[data-state="hover"] {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-link-footer:hover {
      color: var(--ink);
      text-decoration-color: var(--ink);
    }
  }

  .mb-link-footer:is(:active, [data-state="pressed"]) {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }

  .mb-link-footer:is(:active, [data-state="hover"], [data-state="pressed"])
    :global(svg) {
    color: var(--blue);
  }

  .mb-link-case[data-state="hover"] :global(svg) {
    transform: translateX(3px);
  }

  @media (hover: hover) and (pointer: fine) {
    .mb-link-footer:hover :global(svg) {
      color: var(--blue);
    }

    .mb-link-case:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  .mb-link-case:is(:active, [data-state="pressed"]) :global(svg) {
    transform: translateX(6px);
  }

  /* The moves: the ring grows out of the edge, the inline underline
   * thickens, the nav bar draws in, the case arrow nudges. Without them
   * each switches at once. */
  @media (prefers-reduced-motion: no-preference) {
    .mb-link-inline {
      transition:
        color var(--mb-snap),
        text-decoration-thickness var(--mb-snap),
        outline-offset var(--mb-snap);
    }

    .mb-link-nav,
    .mb-link-case {
      transition:
        color var(--mb-snap),
        outline-offset var(--mb-snap);
    }

    .mb-link-nav::after {
      transition:
        background-color var(--mb-snap),
        transform var(--mb-snap);
    }

    .mb-link-case :global(svg) {
      transition: transform var(--mb-snap);
    }

    .mb-link-footer {
      transition:
        color var(--mb-snap),
        text-decoration-color var(--mb-snap),
        outline-offset var(--mb-snap);
    }
  }
</style>
