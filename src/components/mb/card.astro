---
/* Card: a cell drawn by a 1px ink rule on the substrate, numbered on its
 * top rule as an item of its section ("01.3": the `mb-section` counter,
 * then `bl-cell`, which <SectionHead> resets). Hover selects it as a CAD
 * selection does: it lights from inside - a lighter panel - under four
 * square blue grips on the corners, and the item number fills blue and
 * reads the cell's outer width ("01.3 ↔ 368"); nothing moves.
 * [data-state="hover"] forces it on the catalogue page (/ui). A card that
 * is a link (`tag` "a") presses to the flat panel ([data-state="pressed"])
 * and its focus ring grows out of the edge.
 *
 * Drawn by the blueprint's pen (global.css) once the cell is whole on the
 * screen: the frame traces clockwise from the top-left corner (top, right,
 * bottom, left, 0-0.8 of the pen as one eased stage), then the number is
 * written (0.8-1). While the page is live the border gives way to the
 * frame drawn by the background, and a selected cell stands whole, drawn
 * or not; without the script or under reduced motion the cell stands
 * drawn on its border.
 *
 * shadcn's parts are named slots: "image" (full bleed on top), "title" (in
 * `titleAs`, h3 by default), "description", "action" (beside the title),
 * the default slot (content) and "footer". A card whose content has its
 * own layout (the home sections) puts it all in the default slot.
 * `size` "sm" halves the padding. `tag` picks the element: article, li,
 * div, or a (with `href`, the whole cell is the link). Other attributes
 * pass through. */
interface Props {
  class?: string;
  href?: string;
  rel?: string;
  size?: "default" | "sm";
  tag?: "article" | "li" | "div" | "a";
  target?: string;
  titleAs?: "h2" | "h3";
  [attribute: `data-${string}`]: unknown;
}

const {
  size = "default",
  tag = "article",
  titleAs = "h3",
  class: extraClass,
  ...rest
} = Astro.props;

const Tag = tag;
const Title = titleAs;
const has = (name: string) => Astro.slots.has(name);
const hasHeader = has("title") || has("description") || has("action");
---

<Tag class:list={["mb-card", `mb-card-${size}`, extraClass]} {...rest}>
  {has("image") && (
    <div class="mb-card-image">
      <slot name="image" />
    </div>
  )}
  {hasHeader && (
    <div class="mb-card-header">
      <div class="mb-card-heading">
        {has("title") && (
          <Title class="mb-card-title">
            <slot name="title" />
          </Title>
        )}
        {has("description") && (
          <p class="mb-card-description">
            <slot name="description" />
          </p>
        )}
      </div>
      {has("action") && (
        <div class="mb-card-action">
          <slot name="action" />
        </div>
      )}
    </div>
  )}
  {has("default") && (
    <div class="mb-card-content">
      <slot />
    </div>
  )}
  {has("footer") && (
    <div class="mb-card-footer">
      <slot name="footer" />
    </div>
  )}
</Tag>

<style>
  .mb-card {
    --mb-card-pad: var(--v2-space-lg);
    --bl-s: clamp(0, var(--bl-p) / 0.8, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--v2-space-md);
    padding: var(--mb-card-pad);
    container-type: inline-size;
    color: var(--ink);
    counter-increment: bl-cell;
    background: var(--v2-bg);
    background-image:
      linear-gradient(var(--mb-rule) 0 0), linear-gradient(var(--mb-rule) 0 0),
      linear-gradient(var(--mb-rule) 0 0), linear-gradient(var(--mb-rule) 0 0);
    background-repeat: no-repeat;
    background-position:
      0 0,
      100% 0,
      100% 100%,
      0 100%;
    background-origin: border-box;
    background-size:
      calc(clamp(0, var(--bl-e) * 4, 1) * 100%) 1px,
      1px calc(clamp(0, var(--bl-e) * 4 - 1, 1) * 100%),
      calc(clamp(0, var(--bl-e) * 4 - 2, 1) * 100%) 1px,
      1px calc(clamp(0, var(--bl-e) * 4 - 3, 1) * 100%);
    border: 1px solid var(--mb-rule);
    transition:
      background-color var(--mb-snap),
      outline-offset var(--mb-snap);
  }

  :where(.mb-card) {
    outline-offset: 0;
  }

  /* The item number on the top rule, written once the frame is traced. */
  .mb-card::before {
    --bl-s: clamp(0, var(--bl-p) * 5 - 4, 1);
    position: absolute;
    top: -1px;
    left: 12px;
    z-index: 2;
    padding: 3px 6px;
    font: var(--mb-note);
    color: var(--ink-2);
    letter-spacing: 0.08em;
    white-space: nowrap;
    pointer-events: none;
    content:
      counter(mb-section, decimal-leading-zero) "." counter(bl-cell) / "";
    background: var(--v2-bg);
    clip-path: inset(0 calc((1 - var(--bl-e)) * 100%) 0 0);
    transform: translateY(-50%);
    transition:
      background-color var(--mb-snap),
      color var(--mb-snap);
  }

  /* Grips: four squares on the corners, one clipped box, shown selected. */
  .mb-card::after {
    position: absolute;
    inset: -4px;
    z-index: 1;
    visibility: hidden;
    pointer-events: none;
    content: "";
    background: var(--blue);
    clip-path: polygon(
      0 0,
      var(--mb-grip) 0,
      var(--mb-grip) var(--mb-grip),
      0 var(--mb-grip),
      0 0,
      calc(100% - var(--mb-grip)) 0,
      100% 0,
      100% var(--mb-grip),
      calc(100% - var(--mb-grip)) var(--mb-grip),
      calc(100% - var(--mb-grip)) 0,
      0 0,
      0 calc(100% - var(--mb-grip)),
      var(--mb-grip) calc(100% - var(--mb-grip)),
      var(--mb-grip) 100%,
      0 100%,
      0 calc(100% - var(--mb-grip)),
      calc(100% - var(--mb-grip)) calc(100% - var(--mb-grip)),
      100% calc(100% - var(--mb-grip)),
      100% 100%,
      calc(100% - var(--mb-grip)) 100%,
      calc(100% - var(--mb-grip)) calc(100% - var(--mb-grip)),
      0 calc(100% - var(--mb-grip))
    );
  }

  .mb-card:is(:hover, [data-state="hover"]) {
    background-color: var(--v2-panel-elevated);
  }

  .mb-card:is(:hover, [data-state="hover"])::before {
    color: var(--v2-bg);
    background: var(--blue);
  }

  /* Under the cursor the item number reads the cell's outer width: its
   * container width plus the padding and the rule, as a number of px. A
   * browser without typed trigonometry keeps the number alone. */
  @supports (width: calc(1px * tan(atan2(1px, 1px)))) {
    .mb-card:is(:hover, [data-state="hover"])::before {
      --bl-w: tan(atan2(100cqw + 2 * var(--mb-card-pad) + 2px, 1px));
      content:
        counter(mb-section, decimal-leading-zero) "." counter(bl-cell) " ↔ "
        counter(bl-w) / "";
      counter-reset: bl-w var(--bl-w);
    }
  }

  .mb-card:is(:hover, [data-state="hover"])::after {
    visibility: visible;
  }

  a.mb-card:is(:active, [data-state="pressed"]) {
    background-color: var(--v2-panel);
  }

  .mb-card-image {
    margin: calc(-1 * var(--mb-card-pad)) calc(-1 * var(--mb-card-pad)) 0;
    border-bottom: 1px solid var(--mb-rule);
  }

  .mb-card-image :global(img) {
    width: 100%;
    height: auto;
  }

  .mb-card-header {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .mb-card-heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .mb-card-title {
    margin: 0;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-card-sm .mb-card-title {
    font-size: 17px;
  }

  .mb-card-description {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .mb-card-action {
    flex-shrink: 0;
  }

  .mb-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .mb-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: var(--v2-space-md);
    border-top: 1px solid var(--mb-hair);
  }

  @media (max-width: 880px) {
    .mb-card-default {
      --mb-card-pad: var(--v2-space-md);
    }
  }

  /* With the page's script: the frame is drawn by the background, not the
   * border; not on the screen yet, nothing of it; on the screen, the pen
   * plays it through. A selected (or pressed) cell stands whole, drawn or
   * not: the border brings all four rules back, the number is on at once. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-bl-live]) .mb-card {
      border-color: transparent;
    }

    :global(html[data-bl-live])
      .mb-card:is(
        :hover,
        [data-state="hover"],
        :active,
        [data-state="pressed"]
      ) {
      border-color: var(--mb-rule);
    }

    :global(html[data-bl-live]) .mb-card:not([data-bl-drawn]),
    :global(html[data-bl-live]) .mb-card:not([data-bl-drawn])::before {
      --bl-p: 0;
    }

    :global(html[data-bl-live]) .mb-card[data-bl-drawn],
    :global(html[data-bl-live]) .mb-card[data-bl-drawn]::before {
      animation: bl-draw var(--mb-pen) linear both;
    }

    :global(html[data-bl-live])
      .mb-card:is(:hover, [data-state="hover"])::before {
      --bl-p: 1;
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-card,
    .mb-card::before {
      transition: none;
    }
  }
</style>
