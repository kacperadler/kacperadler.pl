---
/* Card: a cell drawn by a 1px ink rule on the substrate. Hover lights it
 * from inside - a lighter panel, and a 3px blue top rule that slides in and
 * out at `--mb-slide` - and moves nothing; [data-state="hover"] forces it on
 * the catalogue page (/ui). The rule follows a mouse: it draws in from the
 * side edge nearer where the pointer came in and leaves toward the side
 * nearer where it went out (through the top or bottom, the nearer side by
 * horizontal position), so a sweep across a grid reads as one movement
 * either way. Without a mouse (touch, pen, keyboard, no JavaScript) it draws
 * in from the left and leaves to the right. A card that is a link (`tag`
 * "a") presses to the flat panel ([data-state="pressed"]) and its focus ring
 * grows out of the edge.
 *
 * shadcn's parts are named slots: "image" (full bleed on top), "title" (in
 * `titleAs`, h3 by default), "description", "action" (beside the title),
 * the default slot (content) and "footer". A card whose content has its
 * own layout (the home sections) puts it all in the default slot.
 * `size` "sm" halves the padding. `tag` picks the element: article, li,
 * div, or a (with `href`, the whole cell is the link). Other attributes
 * pass through. */
interface Props {
  class?: string;
  href?: string;
  rel?: string;
  size?: "default" | "sm";
  tag?: "article" | "li" | "div" | "a";
  target?: string;
  titleAs?: "h2" | "h3";
  [attribute: `data-${string}`]: unknown;
}

const {
  size = "default",
  tag = "article",
  titleAs = "h3",
  class: extraClass,
  ...rest
} = Astro.props;

const Tag = tag;
const Title = titleAs;
const has = (name: string) => Astro.slots.has(name);
const hasHeader = has("title") || has("description") || has("action");
---

<Tag class:list={["mb-card", `mb-card-${size}`, extraClass]} {...rest}>
  {has("image") && (
    <div class="mb-card-image">
      <slot name="image" />
    </div>
  )}
  {hasHeader && (
    <div class="mb-card-header">
      <div class="mb-card-heading">
        {has("title") && (
          <Title class="mb-card-title">
            <slot name="title" />
          </Title>
        )}
        {has("description") && (
          <p class="mb-card-description">
            <slot name="description" />
          </p>
        )}
      </div>
      {has("action") && (
        <div class="mb-card-action">
          <slot name="action" />
        </div>
      )}
    </div>
  )}
  {has("default") && (
    <div class="mb-card-content">
      <slot />
    </div>
  )}
  {has("footer") && (
    <div class="mb-card-footer">
      <slot name="footer" />
    </div>
  )}
</Tag>

<script>
  // Turns the top rule's two ends for a mouse: data-bar-in="right" grows it
  // from the right, data-bar-out="left" gathers it at the left. The entry
  // side lives only while the pointer is in, the exit side until the rule
  // has slid out, so touch, pen and keyboard always meet the CSS default
  // (in from the left, out to the right). Under reduced motion the rule
  // does not slide, so nothing is turned. Delegated from document in the
  // capture phase (pointerenter and pointerleave do not bubble), so cards
  // swapped in by ClientRouter work too.
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  const cardOf = (event: Event) =>
    event.target instanceof HTMLElement &&
    event.target.classList.contains("mb-card")
      ? event.target
      : null;

  const nearerSide = (card: HTMLElement, x: number) => {
    const box = card.getBoundingClientRect();
    return x < box.left + box.width / 2 ? "left" : "right";
  };

  document.addEventListener(
    "pointerenter",
    (event) => {
      const card = cardOf(event);
      if (!card) {
        return;
      }
      delete card.dataset.barOut;
      if (event.pointerType === "mouse" && !reducedMotion.matches) {
        card.dataset.barIn = nearerSide(card, event.clientX);
      }
    },
    true
  );

  document.addEventListener(
    "pointerleave",
    (event) => {
      const card = cardOf(event);
      if (!card) {
        return;
      }
      delete card.dataset.barIn;
      if (event.pointerType === "mouse" && !reducedMotion.matches) {
        card.dataset.barOut = nearerSide(card, event.clientX);
      }
    },
    true
  );

  document.addEventListener("transitionend", (event) => {
    const card = cardOf(event);
    if (
      card &&
      event.pseudoElement === "::before" &&
      event.propertyName === "transform" &&
      !card.matches(":hover")
    ) {
      delete card.dataset.barOut;
    }
  });
</script>

<style>
  .mb-card {
    --mb-card-pad: var(--v2-space-lg);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--v2-space-md);
    padding: var(--mb-card-pad);
    color: var(--ink);
    background: var(--v2-bg);
    border: 1px solid var(--mb-rule);
    transition:
      background-color var(--mb-snap),
      outline-offset var(--mb-snap);
  }

  :where(.mb-card) {
    outline-offset: 0;
  }

  /* At rest the rule is gathered at the right edge, so it leaves that way;
   * hovered it grows from the left. The script above turns either end for
   * a mouse. */
  .mb-card::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    pointer-events: none;
    content: "";
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--mb-slide);
  }

  .mb-card[data-bar-out="left"]::before {
    transform-origin: left center;
  }

  .mb-card:is(:hover, [data-state="hover"]) {
    background: var(--v2-panel-elevated);
  }

  .mb-card:is(:hover, [data-state="hover"])::before {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .mb-card[data-bar-in="right"]:is(:hover, [data-state="hover"])::before {
    transform-origin: right center;
  }

  a.mb-card:is(:active, [data-state="pressed"]) {
    background: var(--v2-panel);
  }

  .mb-card-image {
    margin: calc(-1 * var(--mb-card-pad)) calc(-1 * var(--mb-card-pad)) 0;
    border-bottom: 1px solid var(--mb-rule);
  }

  .mb-card-image :global(img) {
    width: 100%;
    height: auto;
  }

  .mb-card-header {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .mb-card-heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .mb-card-title {
    margin: 0;
    font-family: var(--mb-display);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.035em;
  }

  .mb-card-sm .mb-card-title {
    font-size: 17px;
  }

  .mb-card-description {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .mb-card-action {
    flex-shrink: 0;
  }

  .mb-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .mb-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: var(--v2-space-md);
    border-top: 1px solid var(--mb-hair);
  }

  @media (max-width: 880px) {
    .mb-card-default {
      --mb-card-pad: var(--v2-space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-card,
    .mb-card::before {
      transition: none;
    }
  }
</style>
