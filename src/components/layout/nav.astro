---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/button.astro";
import Link from "@/components/ui/link.astro";
import { contactCta, primaryNav } from "@/data/navigation";
import { siteConfig } from "@/data/site-config";
---

<nav aria-label="Główna nawigacja" class="nav">
  <a
    aria-label={`${siteConfig.name} - Strona główna`}
    class="brand"
    href="/#top"
  >
    <span aria-hidden="true" class="mark">k</span>
    <span><b>Kacper</b> <em>Adler</em></span>
  </a>

  <div class="nav-links">
    {primaryNav.map((link) => (
      <Link data-nav-link href={link.href} variant="nav">
        {link.label}
      </Link>
    ))}
  </div>

  <div class="nav-tail">
    <Button
      data-nav-cta
      href={contactCta.href}
      icon="lucide:arrow-right"
      size="sm"
      variant="primary"
    >
      {contactCta.label}
    </Button>

    <button
      aria-controls="mobile-sheet"
      aria-expanded="false"
      aria-label="Otwórz menu"
      class="menu-btn"
      data-menu-open
      type="button"
    >
      <Icon aria-hidden="true" name="lucide:menu" />
    </button>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container);
    padding: 18px 24px;
    margin: 0 auto;
    transition: padding 0.25s ease;
  }

  .brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-family: var(--display);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    transition: font-size 0.25s ease;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    color: #0f1116;
    background: var(--blue);
    box-shadow: 0 2px 6px rgba(30, 58, 95, 0.18);
    transition:
      width 0.25s ease,
      height 0.25s ease,
      font-size 0.25s ease;
  }

  .brand b {
    font-weight: 500;
  }

  .brand em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }

  .nav-links {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .nav-tail {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
  }

  .menu-btn :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* Scrolled state - toggled by F5 script on the .nav-wrap parent. */
  :global(.nav-wrap.scrolled) .nav {
    padding: 10px 24px;
  }
  :global(.nav-wrap.scrolled) .brand {
    font-size: 14px;
  }
  :global(.nav-wrap.scrolled) .mark {
    width: 24px;
    height: 24px;
    font-size: 12px;
  }
  :global(.nav-wrap.scrolled) :global([data-nav-cta]) {
    padding: 7px 13px;
  }

  @media (max-width: 880px) {
    .nav-links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .brand,
    .mark {
      transition: none;
    }
  }
</style>
