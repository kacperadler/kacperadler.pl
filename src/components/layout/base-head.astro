---
import { getCollection } from "astro:content";
import { siteConfig } from "@/data/site-config";
import {
  personSchema,
  professionalServiceSchema,
  websiteSchema,
} from "@/lib/seo";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
const profServiceSchema = professionalServiceSchema(services);

interface Props {
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  title?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} - ${siteConfig.name}` : siteConfig.title;
const ogTitle = title ? fullTitle : siteConfig.ogTitle;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? siteConfig.url
).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? siteConfig.url).toString();
---

<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1" name="viewport">
<meta content={Astro.generator} name="generator">

<title>{fullTitle}</title>
<meta content={description} name="description">
<link href={canonical} rel="canonical">

{noindex && <meta content="noindex, nofollow" name="robots" />}

<link href="/favicon.svg" rel="icon" type="image/svg+xml">
<link href="/favicon.ico" rel="icon" sizes="any">

<meta content="#0a0c10" name="theme-color">

<link
  as="font"
  crossorigin
  href="/fonts/Geist-Variable.woff2"
  rel="preload"
  type="font/woff2"
>
<link
  as="font"
  crossorigin
  href="/fonts/GeistMono-Variable.woff2"
  rel="preload"
  type="font/woff2"
>

<meta content="website" property="og:type">
<meta content={ogTitle} property="og:title">
<meta content={description} property="og:description">
<meta content={canonical} property="og:url">
<meta content={ogImageUrl} property="og:image">
<meta content={siteConfig.locale.replace("-", "_")} property="og:locale">
<meta content={siteConfig.name} property="og:site_name">

<meta content="summary_large_image" name="twitter:card">
<meta content={ogTitle} name="twitter:title">
<meta content={description} name="twitter:description">
<meta content={ogImageUrl} name="twitter:image">

<link href="/sitemap-index.xml" rel="sitemap">

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(personSchema)}
/>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(websiteSchema)}
/>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(profServiceSchema)}
/>
{/* The blueprint (global.css, scripts/blueprint-live.ts): with JavaScript
 * <html> is marked live (the script runs) and enter (this document load
 * plays the first screen's entrance) here, before the body is parsed, so
 * nothing paints in place and then jumps back to start. The entrance
 * holds at its first frame until the browser reports that frame painted
 * (the first-contentful-paint entry), then "go" runs it, so the header's
 * drop and the headline's slide are seen from their start. A count of
 * animation frames is no such signal: Chrome runs animation frames
 * before it paints the first one (KA0103). Where no report may
 * come (no paint timing, or a page hidden before it painted) "go" waits
 * two animation frames instead, which run only while the page is
 * visible. A ClientRouter swap takes the new document's bare <html>: the
 * script restores the live mark, not the entrance. Without JavaScript
 * neither is set and everything shows at once. */}
<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.blLive = "";
    root.dataset.blEnter = "";
    const go = () => {
      root.dataset.blEnter = "go";
    };
    const afterFrames = () =>
      requestAnimationFrame(() => requestAnimationFrame(go));
    if (
      document.visibilityState === "visible" &&
      globalThis.PerformanceObserver?.supportedEntryTypes?.includes("paint")
    ) {
      new PerformanceObserver((list, observer) => {
        if (list.getEntriesByName("first-contentful-paint").length > 0) {
          observer.disconnect();
          go();
        }
      }).observe({ buffered: true, type: "paint" });
      document.addEventListener("visibilitychange", afterFrames, {
        once: true,
      });
    } else {
      afterFrames();
    }
  })();
</script>
{/* Umami analytics, self-hosted at analytics.kacperadler.pl. PROD-only
 * so dev pageviews don't pollute the data.
 *
 * The script tag is injected via JS after window 'load' (via
 * requestIdleCallback with a 2.5s timeout fallback) instead of being
 * inlined in HTML head. That way the /api/send tracking ping happens
 * AFTER FCP/LCP and stays off Lighthouse's critical path - the
 * analytics roundtrip used to add ~270ms to "Maximum critical path
 * latency" with the script tag in head. astro:page-load reload re-
 * fires on every ClientRouter view transition (equivalent to the
 * data-astro-rerun attribute on a static script tag).
 *
 * is:inline so Astro doesn't try to process the script src; the
 * defer attribute on the injected tag keeps it non-blocking even
 * after load. data-do-not-track lets visitors who set DNT opt out
 * via Umami's own logic. data-domains makes the tracker send nothing
 * outside the production host, so a local preview or the Docker
 * image opened on localhost stays out of the statistics. */}
{import.meta.env.PROD && (
  <script
    is:inline
    set:html={`
        (() => {
          const src = ${JSON.stringify(`${siteConfig.analytics.umamiUrl}/script.js`)};
          const id = ${JSON.stringify(siteConfig.analytics.umamiWebsiteId)};
          const domains = ${JSON.stringify(siteConfig.analytics.domains.join(","))};
          let loaded = false;
          function load() {
            if (loaded) return;
            loaded = true;
            const s = document.createElement('script');
            s.src = src;
            s.defer = true;
            s.dataset.websiteId = id;
            s.dataset.doNotTrack = 'true';
            s.dataset.domains = domains;
            document.head.appendChild(s);
          }
          if ('requestIdleCallback' in window) {
            requestIdleCallback(load, { timeout: 2500 });
          } else {
            addEventListener('load', () => setTimeout(load, 1500));
          }
          // ClientRouter view transitions swap the DOM but keep window state.
          // Umami's auto-init only runs once at first load, so subsequent
          // navigations need a manual track() to register the pageview.
          document.addEventListener('astro:page-load', () => {
            if (loaded) window.umami?.track();
          });
        })();
      `}
  />
)}
