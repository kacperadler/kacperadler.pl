---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/button.astro";
import Field from "@/components/ui/field.astro";
import Input from "@/components/ui/input.astro";
import Radio from "@/components/ui/radio.astro";
import Textarea from "@/components/ui/textarea.astro";

interface ProjectType {
  label: string;
  value: string;
}

const projectTypes: readonly ProjectType[] = [
  { label: "Aplikacja webowa", value: "webapp" },
  { label: "Landing page", value: "landing" },
  { label: "Aplikacja mobilna", value: "mobile" },
  { label: "Narzędzie wewn.", value: "tool" },
  { label: "Inne", value: "other" },
];
---

<div class="contact-form-wrap" data-contact-wrap data-state="idle">
  <form class="form" data-contact-form novalidate>
    <Field
      errorMessage="Podaj prawidłowy adres email."
      for="contact-email"
      label="Twój email"
      name="email"
    >
      <Input
        autocomplete="email"
        id="contact-email"
        name="email"
        placeholder="twoj@email.pl"
        required
        type="email"
      />
    </Field>

    <Field
      errorMessage="Wybierz typ projektu."
      label="Typ projektu"
      name="type"
    >
      <div aria-label="Typ projektu" class="radios" role="radiogroup">
        {projectTypes.map((opt) => (
          <Radio label={opt.label} name="type" value={opt.value} />
        ))}
      </div>
    </Field>

    <Field
      errorMessage="Dodaj krótki opis projektu."
      for="contact-message"
      label="Wiadomość"
      name="message"
    >
      <Textarea
        id="contact-message"
        name="message"
        placeholder="Opisz krótko, o co chodzi - zakres, deadline, jeśli znane. 2–3 zdania wystarczą, żeby zacząć rozmowę."
        required
      />
    </Field>

    <!--
      Honeypot - bots fill every field, humans don't see this one. The
      submit handler drops the request if it's non-empty. aria-hidden +
      tabindex=-1 keeps it out of the keyboard tab order and screen
      reader output; the off-screen position keeps it out of view.
    -->
    <div aria-hidden="true" class="hp">
      <label for="hp-website">Strona WWW (zostaw puste)</label>
      <input
        autocomplete="off"
        id="hp-website"
        name="website"
        tabindex="-1"
        type="text"
      >
    </div>

    <div class="form-error" data-form-error role="alert">
      <Icon aria-hidden="true" name="lucide:triangle-alert" />
      Coś poszło nie tak. Spróbuj ponownie za chwilę albo napisz mailem na
      <a href="mailto:kontakt@kacperadler.pl">kontakt@kacperadler.pl</a>.
    </div>

    <div class="submit-row">
      <Button
        data-state="idle"
        data-submit
        icon="lucide:arrow-right"
        type="submit"
        variant="primary"
      >
        Wyślij wiadomość
      </Button>
    </div>
  </form>

  <div
    aria-live="polite"
    class="form-success-card"
    data-form-success
    role="status"
  >
    <div aria-hidden="true" class="success-mark">
      <Icon name="lucide:check" />
    </div>
    <h3>Wiadomość wysłana</h3>
    <p>Dzięki! Odezwę się tego samego dnia, najpóźniej w ciągu 24h.</p>
    <Button data-form-reset size="sm" type="button" variant="ghost">
      Wyślij kolejną wiadomość
    </Button>
  </div>
</div>

<style>
  /* The wrapper holds two states side by side - one is hidden via the
   * data-state attribute below. Stretch keeps the card's height aligned
   * with the left contact-info column when align-self: stretch is set
   * by the parent grid. */
  .contact-form-wrap {
    display: flex;
    flex-direction: column;
  }

  .form {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--line);
  }

  /* On success the form node is hidden entirely and the success card
   * takes its place. Errors keep the form visible (so the user doesn't
   * lose what they wrote) and surface a banner above submit-row. */
  .contact-form-wrap[data-state="success"] .form {
    display: none;
  }

  /* Honeypot - taken out of the visual flow without display:none so
   * autofill / focus-stealing bots that ignore display still hit it. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Field label / error line, the inputs and the radios come from the ui
   * components (Field, Input, Textarea, Radio); only the radio row is laid
   * out here. */
  .radios {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
  }

  /* Submit + reset buttons are rendered by the canonical Button component
   * (variant="primary" for submit, variant="ghost" size="sm" for reset).
   * State machine still drives them via [data-submit] / [data-form-reset]
   * + the [disabled] / [data-state="submitting"] hooks - Button has the
   * dim + cursor:not-allowed style baked in. */

  /* Inline server-error banner above submit-row. Hidden by default,
   * revealed when the wrapper enters error-submit state. */
  .form-error {
    display: none;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.5;
    color: #c44545;
    background: color-mix(in srgb, #c44545 8%, transparent);
    border: 1px solid color-mix(in srgb, #c44545 30%, transparent);
  }

  .contact-form-wrap[data-state="error-submit"] .form-error {
    display: flex;
  }

  .form-error :global(svg) {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .form-error a {
    color: inherit;
    text-decoration: underline;
  }

  /* Replaces the form on success. Sized to fill the same vertical
   * space as the form so the contact section's column heights stay
   * aligned. */
  .form-success-card {
    display: none;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    justify-content: center;
    padding: 40px 28px;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--line);
  }

  .contact-form-wrap[data-state="success"] .form-success-card {
    display: flex;
  }

  .success-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--paper-2);
    background: var(--blue);
    border-radius: 50%;
  }

  .success-mark :global(svg) {
    width: 24px;
    height: 24px;
  }

  .form-success-card h3 {
    margin: 4px 0 0;
    font-family: var(--display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .form-success-card p {
    max-width: 36ch;
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
