---
/* Form field: mono label, the control in the slot (Input / Textarea / a
 * group of Radio), and an error line shown while the field is invalid.
 *
 * `name` lands in [data-field], which scripts/contact-form.ts looks up to set
 * and clear [data-invalid] at runtime; `invalid` renders it up front (the
 * catalogue at /ui). With `for` the label is a <label> pointing at the
 * control; without it (a radio group, labelled by its own aria-label) it is a
 * plain span. */
interface Props {
  errorMessage: string;
  for?: string;
  invalid?: boolean;
  label: string;
  name: string;
}

const { errorMessage, for: forId, invalid = false, label, name } = Astro.props;
---

<div
  class="field"
  data-field={name}
  data-invalid={invalid ? "true" : undefined}
>
  {forId ? (
    <label class="field-label" for={forId}>
      {label}
    </label>
  ) : (
    <span class="field-label">{label}</span>
  )}
  <slot />
  <span class="err">{errorMessage}</span>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* Input / Textarea live in their own style scope, hence :global(). */
  .field[data-invalid] :global(.v2-input),
  .field[data-invalid] :global(.v2-textarea) {
    border-color: #c44545;
  }

  .err {
    display: none;
    font-size: 12px;
    color: #c44545;
  }

  .field[data-invalid] .err {
    display: block;
  }
</style>
