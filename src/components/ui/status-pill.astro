---
import type { HTMLAttributes } from "astro/types";

/* Blue-wash availability pill with a dot: hero status card and mobile sheet
 * header. Same vocab as the filled Badge ("teraz", "Zlecenie"). `class` and
 * the other attributes pass through, so the caller's scoped styles reach it. */
type Props = HTMLAttributes<"span">;

const { class: extraClass, ...rest } = Astro.props;
---

<span class:list={["status-pill", extraClass]} {...rest}>
  <span aria-hidden="true" class="status-pill-dot"></span>
  <slot />
</span>

<style>
  .status-pill {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    align-self: flex-start;
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--blue);
    background: var(--blue-wash);
    border-radius: var(--v2-radius-xs);
  }

  .status-pill-dot {
    width: 6px;
    height: 6px;
    background: var(--blue);
    border-radius: var(--v2-radius-full);
  }
</style>
