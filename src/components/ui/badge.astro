---
import type { HTMLAttributes } from "astro/types";

/* Mono badge on a card: experience years / "teraz" / "Zlecenie", process step
 * duration.
 *   - outline: muted text, thin border (year range, step duration)
 *   - filled: blue-wash, same vocab as StatusPill (current role, badge override)
 * `fillOnCardHover` turns an outline badge into the filled one while its
 * <Card> is hovered (process steps). The catalogue forces that hover with
 * [data-state="hover"] on the card. */
interface Props extends HTMLAttributes<"span"> {
  fillOnCardHover?: boolean;
  variant?: "outline" | "filled";
}

const {
  variant = "outline",
  fillOnCardHover = false,
  class: extraClass,
  ...rest
} = Astro.props;
---

<span
  class:list={[
    "badge",
    `badge-${variant}`,
    { "badge-card-hover": fillOnCardHover },
    extraClass,
  ]}
  {...rest}
>
  <slot />
</span>

<style>
  .badge {
    padding: 4px 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    border: 1px solid;
    border-radius: var(--v2-radius-xs);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .badge-outline {
    color: var(--muted);
    background: transparent;
    border-color: var(--v2-line);
  }

  .badge-filled,
  :global(.v2-card:is(:hover, [data-state="hover"])) .badge-card-hover {
    color: var(--blue);
    background: var(--blue-wash);
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }
  }
</style>
