---
import BaseLayout from "@/layouts/base-layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lastUpdated: string;
  };
}

const { frontmatter } = Astro.props;

const lastUpdatedFormatted = new Date(frontmatter.lastUpdated).toLocaleDateString("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout description={frontmatter.description} title={frontmatter.title}>
  <main class="legal" id="top">
    <article class="container">
      <header class="legal-head">
        <p class="legal-eyebrow">Informacja prawna</p>
        <h1>{frontmatter.title}</h1>
        <p class="legal-meta">
          Ostatnia aktualizacja:
          <time datetime={frontmatter.lastUpdated}>{lastUpdatedFormatted}</time>
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .legal {
    padding: 80px 0 60px;
  }

  .legal-head {
    max-width: 70ch;
    margin: 0 auto 48px;
  }

  .legal-eyebrow {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .legal-head h1 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .legal-meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>
