---
import Prose from "@/components/mb/prose.astro";
import SectionHead from "@/components/mb/section-head.astro";
import BaseLayout from "@/layouts/base-layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lastUpdated: string;
  };
}

const { frontmatter } = Astro.props;

const lastUpdatedFormatted = new Date(
  frontmatter.lastUpdated
).toLocaleDateString("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout description={frontmatter.description} title={frontmatter.title}>
  <main class="mb-legal" id="top">
    <article class="container">
      <SectionHead as="h1" label="Informacja prawna">
        {frontmatter.title}
        <Fragment slot="lede">
          Ostatnia aktualizacja:
          <time datetime={frontmatter.lastUpdated}>{lastUpdatedFormatted}</time>
        </Fragment>
      </SectionHead>
      <Prose>
        <slot />
      </Prose>
    </article>
  </main>
</BaseLayout>

<style>
  .mb-legal {
    padding: var(--v2-space-xl) 0 var(--v2-space-2xl);
  }

  @media (max-width: 880px) {
    .mb-legal {
      padding-bottom: var(--v2-space-xl);
    }
  }
</style>
