---
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/layout/base-head.astro";
import PageFrame from "@/components/mb/page-frame.astro";
import { siteConfig } from "@/data/site-config";
import "@/styles/tokens.css";
import "@/styles/global.css";

/* Base layout of every production page: the head, the ClientRouter and the
 * minimal brutalism page frame (skip link, header, footer, EU funding band,
 * mobile sheet) around the page in the slot, plus the page scripts. */

interface Props {
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  title?: string;
}

const { title, description, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <BaseHead
      description={description}
      noindex={noindex}
      ogImage={ogImage}
      title={title}
    />
    <ClientRouter />
  </head>
  <body>
    <PageFrame>
      <slot />
    </PageFrame>
  </body>
</html>

<script>
  import "@/scripts/contact-form.ts";
  import "@/scripts/mobile-sheet.ts";
  import "@/scripts/nav-active.ts";
</script>
