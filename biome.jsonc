{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!**/bun.lock",
      "!**/public",
      // Vendor logos served through <img>; Biome 2.5 started parsing SVG.
      "!**/*.svg",
      // Written by the harness (`h`), which formats it its own way.
      "!spec/build.json"
    ]
  },
  // Biome parses and formats the whole .astro file (markup included), not
  // only the frontmatter. ultracite/biome/astro turns this on too; it is
  // stated here because the repo has no other .astro formatter.
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
