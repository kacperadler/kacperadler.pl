{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!**/bun.lock",
      "!**/example.html",
      "!**/public",
      // Vendor logos served through <img>; Biome 2.5 started parsing SVG.
      "!**/*.svg",
      // Written by the harness (`h`), which formats it its own way.
      "!spec/build.json"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
