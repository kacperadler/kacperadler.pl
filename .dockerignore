# Build cache and output (regenerated in image)
.astro/
dist/

# Dependencies (re-installed inside the image)
node_modules/

# Test artifacts (not part of the runtime image)
tests/
playwright.config.ts
playwright-report/
test-results/
blob-report/

# Git / GitHub
.git/
.github/
.gitignore

# Editor and agent settings (gitignored, may sit in a local checkout)
.vscode/
.zed/
.claude/
.idea/
.DS_Store

# Tooling and harness files that don't need to be in the build context
.husky/
.agents/
spec/

# Logs and env
*.log
.env
.env.*

# Docs at the root (AGENTS.md, README, DESIGN.md, ...) aren't part of the
# build. Root-only on purpose: src/pages/*.md are pages.
*.md
